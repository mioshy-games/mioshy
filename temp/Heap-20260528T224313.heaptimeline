5D4, \u05E0\u05D5\u05DB\u05D7\u05D5\u05EA \u05D5\u05DB\u05E0\u05D5\u05EA \u05D1\u05D9\u05DF \u05E9\u05E0\u05D9\u05DB\u05DD. \u05D6\u05D4 \u05DC\u05D0 \u05E0\u05D1\u05E0\u05D4 \u05DE\u05D0\u05DC\u05D9\u05D5.","\u05D0\u05D9\u05E6\u05D9\u05E7 \u05D1\u05E8\u05DC\u05D1","\u05DE\u05DC\u05D5\u05D5\u05D4 \u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05E9\u05E0\u05EA 2001","\u05E9\u05D9\u05D8\u05D4 \u05E9\u05E0\u05D1\u05D7\u05E0\u05D4 \u05E2\u05DD \u05DE\u05D0\u05D5\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA \u00B7 \u05DC\u05DE\u05E2\u05DC\u05D4 \u05DE-25 \u05E9\u05E0\u05D5\u05EA \u05DC\u05D9\u05D5\u05D5\u05D9","\u05D4\u05DE\u05E9\u05DA \u05DC\u05DE\u05E1\u05E2","\u05D4\u05E9\u05D0\u05E8\u05D5 \u05DB\u05D0\u05DF","\u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05E0\u05D1\u05E0\u05D4 \u05DC\u05DB\u05DD.","\u05DC\u05DE\u05D4 \u05D4\u05E4\u05E8\u05D9\u05D8 \u05D4\u05D6\u05D4 \u05D0\u05E6\u05DC\u05DB\u05DD","\u05DC\u05DE\u05D4 \u05D6\u05D4 \u05D0\u05E6\u05DC\u05DB\u05DD","\u05E2\u05D5\u05D3 \u05DC\u05D0 \u05E0\u05E8\u05E9\u05DE\u05D4 \u05E4\u05E2\u05D9\u05DC\u05D5\u05EA. \u05EA\u05EA\u05D7\u05D9\u05DC\u05D5 \u05E2\u05DD \u05D4\u05DE\u05E9\u05D9\u05DE\u05D4 \u05D4\u05D1\u05D0\u05D4 \u05DC\u05DE\u05E2\u05DC\u05D4.","\u05E4\u05EA\u05D7\u05EA\u05DD","\u05E1\u05D9\u05DE\u05E0\u05EA\u05DD \u05DB\u05D1\u05D5\u05E6\u05E2","\u05D1\u05D9\u05D8\u05DC\u05EA\u05DD \u05E1\u05D9\u05DE\u05D5\u05DF","\u05D4\u05D5\u05E1\u05E4\u05EA\u05DD \u05EA\u05D2\u05D5\u05D1\u05D4 \u05DC","\u05DE\u05D7\u05E7\u05EA\u05DD \u05EA\u05D2\u05D5\u05D1\u05D4 \u05DC","\u05DE\u05DE\u05E9 \u05E2\u05DB\u05E9\u05D9\u05D5","\u05DC\u05E4\u05E0\u05D9 {n} \u05D3\u05E7\u05D5\u05EA","\u05DC\u05E4\u05E0\u05D9 {n} \u05E9\u05E2\u05D5\u05EA","\u05DC\u05E4\u05E0\u05D9 {n} \u05D9\u05DE\u05D9\u05DD","\u05D4\u05E9\u05DE\u05D9\u05E8\u05D4 \u05E0\u05DB\u05E9\u05DC\u05D4 \u2014 \u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1","\u05E0\u05E9\u05DE\u05E8. \u05D4\u05D4\u05DE\u05E9\u05DA \u05DE\u05EA\u05D0\u05D9\u05DD \u05D0\u05EA \u05E2\u05E6\u05DE\u05D5 \u05DC\u05DE\u05D4 \u05E9\u05D0\u05DE\u05E8\u05EA\u05DD.","\u05E1\u05D9\u05DE\u05E0\u05EA\u05DD \"{label}\". \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05D1\u05D0 \u05DE\u05EA\u05D7\u05E9\u05D1 \u05D1\u05D6\u05D4.","\u05E9\u05D9\u05E0\u05D5\u05D9","\u05DE\u05E9\u05D5\u05D1 \u05E2\u05DC \u05D4\u05E4\u05E8\u05D9\u05D8","\u05D0\u05D9\u05DA \u05D6\u05D4 \u05D4\u05D9\u05D4?","\u05D4\u05DE\u05E9\u05D5\u05D1 \u05DE\u05E9\u05E0\u05D4 \u05D0\u05EA \u05DE\u05D4 \u05E9\u05EA\u05E7\u05D1\u05DC\u05D5 \u05D0\u05D7\u05E8 \u05DB\u05DA.","\u05E2\u05D6\u05E8","\u05D1\u05E1\u05D3\u05E8","\u05DC\u05D0 \u05DC\u05E0\u05D5","\u05E4\u05D2\u05E2","\u05D0\u05D5\u05E4\u05E6\u05D9\u05D5\u05E0\u05DC\u05D9. \u05DE\u05D4 \u05DC\u05D0 \u05E2\u05D1\u05D3? \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4/\u05EA \u05D9\u05E7\u05E8\u05D0/\u05EA\u05E7\u05E8\u05D0.","\u05D1\u05D9\u05D8\u05D5\u05DC","\u05E9\u05D5\u05DC\u05D7\u2026","\u05D4\u05DE\u05E1\u05E2 \u05E9\u05DC\u05DB\u05DD","\u05E6\u05D9\u05E8 \u05D4\u05DE\u05E1\u05E2","\u05DB\u05DC \u05E4\u05E8\u05E7 \u05E0\u05E4\u05EA\u05D7 \u05D1\u05D6\u05DE\u05DF \u05E9\u05DC\u05D5. \u05DB\u05E9\u05D4\u05D2\u05D9\u05E2 \u05D4\u05EA\u05D5\u05E8 - \u05D4\u05D9\u05DB\u05E0\u05E1\u05D5, \u05EA\u05E8\u05D2\u05DC\u05D5 \u05D5\u05E2\u05E0\u05D5 \u05D9\u05D7\u05D3.","\u05DB\u05DC \u05D4\u05E4\u05E8\u05E7\u05D9\u05DD","\u05D4\u05D4\u05D9\u05E1\u05D8\u05D5\u05E8\u05D9\u05D4 \u05E9\u05DC\u05DB\u05DD","\u05E4\u05E8\u05E7 \u05D1\u05DE\u05E1\u05E2","\u05D7\u05D6\u05E8\u05D4 \u05DC\u05E6\u05D9\u05E8 \u05D4\u05DE\u05E1\u05E2","\u05E4\u05E8\u05E7","\u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05E9\u05D9\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD \u05E2\u05DC \u05D4\u05E4\u05E8\u05D9\u05D8","\u05DB\u05EA\u05D1\u05D5 \u05EA\u05D2\u05D5\u05D1\u05D4 - \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05E8\u05D5\u05D0\u05D9\u05DD \u05D5\u05DE\u05D2\u05D9\u05D1\u05D9\u05DD.","\u05E9\u05DE\u05E8\u05D5 \u05D0\u05EA \u05D4\u05D4\u05EA\u05E7\u05D3\u05DE\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD","\u05DB\u05D3\u05D9 \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA - \u05E6\u05E8\u05D9\u05DA \u05D7\u05E9\u05D1\u05D5\u05DF \u05E7\u05D8\u05DF. \u05E9\u05DC\u05D5\u05E9 \u05E9\u05D0\u05DC\u05D5\u05EA \u05E0\u05E9\u05DE\u05E8\u05D5 \u05DB\u05D1\u05E8, \u05DC\u05D0 \u05EA\u05D0\u05D1\u05D3\u05D5 \u05DB\u05DC\u05D5\u05DD.","\u05D8\u05DC\u05E4\u05D5\u05DF","\u05D4\u05E8\u05E9\u05DE\u05D4 \u05D5\u05D4\u05D4\u05DE\u05E9\u05DA","\u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA \u05D5\u05D4\u05D4\u05DE\u05E9\u05DA","\u05DB\u05D1\u05E8 \u05D9\u05E9 \u05DC\u05D9 \u05D7\u05E9\u05D1\u05D5\u05DF","\u05D0\u05E0\u05D9 \u05D7\u05D3\u05E9/\u05D4 \u05DB\u05D0\u05DF","\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA - \u05E9\u05D1\u05D5\u05E2 \u05D0\u05D7\u05E8 \u05E9\u05D1\u05D5\u05E2","\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA \u05D5\u05E7\u05D1\u05DC\u05D5 \u05E0\u05D9\u05EA\u05D5\u05D7 \u05DE\u05E2\u05DE\u05D9\u05E7, \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05D1\u05D5\u05E2\u05D9\u05D5\u05EA \u05DE\u05D5\u05EA\u05D0\u05DE\u05D5\u05EA, \u05D5\u05E9\u05D9\u05D7\u05D5\u05EA \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD.","2\u20134 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D1\u05E9\u05D1\u05D5\u05E2 \u05E9\u05E0\u05D1\u05D7\u05E8\u05D5 \u05E2\"\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD - \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DC\u05DE\u05D4 \u05E9\u05D0\u05EA\u05DD \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD","\u05E9\u05D0\u05DC\u05D5\u05E0\u05D9\u05DD \u05E0\u05D5\u05E1\u05E4\u05D9\u05DD \u05D1\u05E9\u05D1\u05D5\u05E2\u05D5\u05EA \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D9\u05DD \u05DC\u05DB\u05D9\u05D5\u05D5\u05DF \u05DE\u05D3\u05D5\u05D9\u05E7 \u05D9\u05D5\u05EA\u05E8","\u05E9\u05D9\u05E8\u05D5\u05EA \u05DE\u05D5\u05EA\u05D0\u05DD \u05D0\u05D9\u05E9\u05D9\u05EA \u05DC\u05D7\u05DC\u05D5\u05D8\u05D9\u05DF - \u05DC\u05D0 \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D2\u05E0\u05E8\u05D9\u05EA","\u05E9\u05D9\u05D7\u05D5\u05EA \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05DB\u05DC\u05D5\u05DC\u05D5\u05EA \u05D1\u05DE\u05D7\u05D9\u05E8 - \u05DC\u05DC\u05D0 \u05EA\u05D5\u05E1\u05E4\u05EA","\u20AA98 / $33 \u05DC\u05D7\u05D5\u05D3\u05E9 - \u05E0\u05D9\u05EA\u05DF \u05DC\u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E2\u05EA","\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA","\u05D0\u05D7\u05E8 \u05DB\u05DA","\u05DE\u05DB\u05D9\u05DF \u05EA\u05E9\u05DC\u05D5\u05DD\u2026","\u05E8\u05D2\u05E2 \u05DC\u05E4\u05E0\u05D9","\u05D4\u05E1\u05DB\u05DD \u05E7\u05D8\u05DF \u05D1\u05D9\u05E0\u05D9\u05DB\u05DD","\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DC\u05DB\u05DD \u05E0\u05D1\u05E0\u05D4 \u05DC\u05E4\u05D9 \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA. \u05DB\u05D3\u05D9 \u05E9\u05D6\u05D4 \u05D9\u05E2\u05D1\u05D5\u05D3 \u05E6\u05E8\u05D9\u05DA \u05E9\u05EA\u05D4\u05D9\u05D5 \u05D1\u05E4\u05E0\u05D9\u05DD.","10 \u05D3\u05E7\u05D5\u05EA \u05D1\u05E9\u05D1\u05D5\u05E2, \u05D0\u05E8\u05D1\u05E2\u05D4 \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA","\u05D4\u05D0\u05D1\u05D7\u05D5\u05DF \u05DC\u05D5\u05E7\u05D7 \u05DB-7 \u05D3\u05E7\u05D5\u05EA. \u05D0\u05D7\u05E8 \u05DB\u05DA \u2014 \u05E6\u05E2\u05D3 \u05E7\u05E6\u05E8 \u05D0\u05D7\u05EA \u05DC\u05E9\u05D1\u05D5\u05E2, \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD.","\u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u2014 \u05E9\u05DC\u05DB\u05DD","\u05DB\u05DC \u05D0\u05D7\u05D3 \u05DE\u05DB\u05DD \u05E2\u05D5\u05E0\u05D4 \u05DC\u05D1\u05D3. \u05D4\u05E6\u05D3 \u05D4\u05E9\u05E0\u05D9 \u05DC\u05D0 \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05D4\u05D0\u05D9\u05E9\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD, \u05E8\u05E7 \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E8\u05D5\u05D0\u05D4.","\u05D0\u05E8\u05D1\u05E2\u05D4 \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA, \u05D9\u05D7\u05D3","10 \u05D3\u05E7\u05D5\u05EA \u05DC\u05E9\u05D1\u05D5\u05E2. \u05D1\u05DC\u05D9 \u05DC\u05D7\u05E5, \u05D1\u05DC\u05D9 \u05E9\u05D9\u05E4\u05D5\u05D8. \u05DB\u05E9\u05EA\u05E8\u05E6\u05D5 \u05DC\u05D5\u05D5\u05EA\u05E8 \u2014 \u05EA\u05D6\u05DB\u05E8\u05D5 \u05E9\u05D4\u05E1\u05DB\u05DE\u05EA\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05E4\u05D4 \u05D0\u05EA \u05D4\u05D0\u05E8\u05D1\u05E2\u05D4 \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA \u05D4\u05D0\u05DC\u05D4.","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D1\u05E4\u05E0\u05D9\u05DD","\u05E9\u05D5\u05DE\u05E8\u05D9\u05DD\u2026","\u05D0\u05D5\u05DC\u05D9 \u05D0\u05D7\u05E8 \u05DB\u05DA","\u05DE\u05E1\u05E2 \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD","\u05DC\u05D0 \u05D4\u05E6\u05DC\u05D7\u05E0\u05D5 \u05DC\u05D8\u05E2\u05D5\u05DF \u05D0\u05EA \u05D4\u05E0\u05D9\u05EA\u05D5\u05D7 \u05E9\u05DC\u05DB\u05DD.","\u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1","\u05DE\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E2\u05E0\u05D5 \u05DB\u05DE\u05D5\u05DB\u05DD","\u2190 \u05D7\u05D6\u05E8\u05D4","\u05D1\u05D7\u05E8/\u05D9 \u05EA\u05E9\u05D5\u05D1\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA","\u05E9\u05D5\u05DE\u05E8/\u05EA\u2026","\u05D4\u05DE\u05E9\u05DA","\u05DC\u05D3\u05D5\u05D2\u05DE\u05D4: \u05D0\u05E8\u05D5\u05D7\u05EA \u05E2\u05E8\u05D1 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05D9\u05DC\u05D3\u05D9\u05DD \u05E0\u05E8\u05D3\u05DE\u05D5, \u05E9\u05D9\u05D7\u05D4 \u05D1\u05DE\u05DB\u05D5\u05E0\u05D9\u05EA, \u05D7\u05D9\u05D1\u05D5\u05E7 \u05E8\u05D2\u05D9\u05DC \u05D1\u05D9\u05D5\u05DD \u05E9\u05DC\u05D9\u05E9\u05D9...","\u05D4\u05E9\u05EA\u05DE\u05E9\u05D5 \u05D1\u05D7\u05E6\u05D9\u05DD \u05DC\u05E9\u05D9\u05E0\u05D5\u05D9 \u05D4\u05E1\u05D3\u05E8","\u05D4\u05E2\u05DC\u05D4 \u05D0\u05EA {label}","\u05D4\u05D5\u05E8\u05D3 \u05D0\u05EA {label}","\u05DE\u05E7\u05D5\u05DD {n}","\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD \u05D0\u05EA \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF! \uF389","\u05D4\u05E0\u05D9\u05EA\u05D5\u05D7 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD \u05DE\u05D5\u05DB\u05DF - \u05E6\u05E8\u05D5 \u05D7\u05E9\u05D1\u05D5\u05DF \u05D7\u05D9\u05E0\u05DE\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05E7\u05D1\u05DC \u05D0\u05D5\u05EA\u05D5.","\u05DC\u05E4\u05D7\u05D5\u05EA 8 \u05EA\u05D5\u05D5\u05D9\u05DD","\u05E7\u05D1\u05DC\u05D5 \u05D0\u05EA \u05D4\u05E0\u05D9\u05EA\u05D5\u05D7 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD \u2190","\u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA \u05D5\u05E6\u05E4\u05D9\u05D9\u05D4 \u05D1\u05E0\u05D9\u05EA\u05D5\u05D7 \u2190","\u05DB\u05D1\u05E8 \u05D9\u05E9 \u05DC\u05D9 \u05D7\u05E9\u05D1\u05D5\u05DF - \u05DB\u05E0\u05D9\u05E1\u05D4","\u05D0\u05E0\u05D9 \u05D7\u05D3\u05E9/\u05D4 \u05DB\u05D0\u05DF - \u05D4\u05E8\u05E9\u05DE\u05D4","\u05D4\u05D2\u05D1\u05DC\u05EA \u05E9\u05DC\u05D9\u05D7\u05EA \u05DE\u05D9\u05D9\u05DC\u05D9\u05DD - \u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1 \u05D1\u05E2\u05D5\u05D3 \u05DE\u05E1\u05E4\u05E8 \u05D3\u05E7\u05D5\u05EA.","\u05D4\u05DE\u05D9\u05D9\u05DC \u05D4\u05D6\u05D4 \u05DB\u05D1\u05E8 \u05E8\u05E9\u05D5\u05DD \u05D1\u05DE\u05E2\u05E8\u05DB\u05EA. \u05E2\u05D1\u05E8\u05D5 \u05DC'\u05D9\u05E9 \u05DC\u05D9 \u05DB\u05D1\u05E8 \u05D7\u05E9\u05D1\u05D5\u05DF' \u05DC\u05DE\u05D8\u05D4 \u2193","\u05E9\u05E0\u05D9\u05D4\u2026","\uF512 \u05DE\u05D5\u05D2\u05DF \u05DC\u05D7\u05DC\u05D5\u05D8\u05D9\u05DF","\u05E0\u05D9\u05EA\u05D5\u05D7 \u05D0\u05D9\u05E9\u05D9 \u05EA\u05D5\u05DA \u05E9\u05E0\u05D9\u05D5\u05EA","\u05E0\u05D9\u05EA\u05DF \u05DC\u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E2\u05EA","\u05E9\u05DC\u05D1 {n} / 4","\u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD","\u05D4\u05EA\u05D5\u05E6\u05D0\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD","\u05D4\u05E0\u05D9\u05EA\u05D5\u05D7 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD","\u05DE\u05D4 \u05E8\u05D0\u05D9\u05E0\u05D5, \u05D5\u05DC\u05D0\u05DF \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05DE\u05DB\u05D0\u05DF","\u05D7\u05D1\u05E8\u05D5\u05EA \u05D6\u05D5\u05D2\u05D9\u05EA","\u05D4\u05EA\u05DE\u05D5\u05D3\u05D3\u05D5\u05EA \u05E2\u05DD \u05E7\u05E9\u05D9\u05D9\u05DD","\u05E1\u05D9\u05DB\u05D5\u05DF \u05DC\u05D9\u05E8\u05D9\u05D3\u05D4 \u05D1\u05EA\u05E9\u05D5\u05E7\u05D4","\u05EA\u05DE\u05E6\u05D9\u05EA","\u05DE\u05D5\u05E7\u05D3 \u05D4\u05D7\u05D5\u05D3\u05E9 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF","\u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D4\u05DE\u05D5\u05EA\u05D0\u05DE\u05EA \u05E9\u05DC\u05DB\u05DD","\u05D4\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E6\u05DE\u05D5\u05D3 \u05E9\u05DC \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05D1\u05D7\u05D3\u05E8 \u05E4\u05E8\u05D8\u05D9 \u05E9\u05DC\u05DB\u05DD \u05D1\u05DC\u05D1\u05D3.","\u05EA\u05D5\u05DA 30 \u05D9\u05D5\u05DD \u05EA\u05E8\u05D2\u05D9\u05E9\u05D5 \u05E9\u05D9\u05E0\u05D5\u05D9 \u05D0\u05DE\u05D9\u05EA\u05D9.","\u05D7\u05D3\u05E8 \u05D0\u05D9\u05E9\u05D9 \u05E1\u05D2\u05D5\u05E8 \u05E2\u05DD \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD","\u05E9\u05D5\u05DC\u05D7\u05D9\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05DE\u05EA\u05D9 \u05E9\u05E6\u05E8\u05D9\u05DA, \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05DE\u05E2\u05E0\u05D4 \u05D0\u05DE\u05D9\u05EA\u05D9 - \u05DC\u05D0 \u05D1\u05D5\u05D8, \u05DC\u05D0 \u05EA\u05D5\u05E8.","\u05EA\u05D5\u05DB\u05DF \u05E9\u05D1\u05D5\u05E2\u05D9 \u05E9\u05DE\u05D5\u05EA\u05D0\u05DD \u05DC\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05DC\u05DB\u05DD","\u05DC\u05D0 \u05E7\u05D5\u05E8\u05E1 \u05DE\u05D5\u05DB\u05DF. \u05DB\u05DC \u05E9\u05D1\u05D5\u05E2 \u05EA\u05D5\u05DB\u05DF \u05E9\u05E0\u05D1\u05E0\u05D4 \u05DC\u05E4\u05D9 \u05DE\u05D4 \u05E9\u05DE\u05D9\u05DC\u05D0\u05EA\u05DD \u05D5\u05D4\u05E9\u05D9\u05D7\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05E2\u05DD \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4.","\u05E9\u05D9\u05D7\u05D4 \u05E9\u05DE\u05EA\u05E4\u05EA\u05D7\u05EA \u05D0\u05D9\u05EA\u05DB\u05DD","\u05D0\u05EA\u05DD \u05DE\u05D2\u05D9\u05D1\u05D9\u05DD \u05E2\u05DC \u05DB\u05DC \u05EA\u05D5\u05DB\u05DF, \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E2\u05D5\u05E0\u05D4, \u05D5\u05D6\u05D4 \u05DE\u05DE\u05E9\u05D9\u05DA \u05DC\u05D1\u05E0\u05D5\u05EA \u05D0\u05EA \u05D4\u05EA\u05D4\u05DC\u05D9\u05DA - \u05E9\u05D1\u05D5\u05E2 \u05D0\u05D7\u05E8 \u05E9\u05D1\u05D5\u05E2.","57 \u20AA / \u05E9\u05D1\u05D5\u05E2","\u05E0\u05D9\u05EA\u05DF \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DB\u05DC \u05E2\u05EA","\u05DC\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA \u05E2\u05DB\u05E9\u05D9\u05D5","\u05D0\u05EA\u05DD \u05DB\u05D1\u05E8 \u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05E1\u05E2","\u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D4\u05D0\u05D9\u05E9\u05D9\u05EA \u05E9\u05DC\u05DB\u05DD \u05E4\u05E2\u05D9\u05DC\u05D4. \u05D4\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D4\u05E9\u05D1\u05D5\u05E2\u05D9\u05D5\u05EA \u05D9\u05D2\u05D9\u05E2\u05D5 \u05D9\u05E9\u05D9\u05E8\u05D5\u05EA \u05D0\u05DC\u05D9\u05DB\u05DD.","\u05DC\u05DE\u05D9 \u05D6\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD?","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05E2\u05D1\u05D5\u05D3 \u05E2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05D4\u05DD","\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05E9\u05D4\u05E7\u05E8\u05D1\u05D4 \u05D9\u05E8\u05D3\u05D4 \u05D5\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05D5\u05EA\u05D4","\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05EA\u05E7\u05E9\u05D9\u05DD \u05D1\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D5\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF \u05D6\u05D4 \u05D0\u05EA \u05D6\u05D4 \u05D8\u05D5\u05D1 \u05D9\u05D5\u05EA\u05E8","\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05EA\u05DE\u05D5\u05D3\u05D3\u05D9\u05DD \u05E2\u05DD \u05DE\u05E9\u05D1\u05E8\u05D9\u05DD \u05D5\u05E8\u05D5\u05E6\u05D9\u05DD \u05DB\u05DC\u05D9\u05DD \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD \u05DC\u05E2\u05D1\u05D5\u05D3\u05D4","\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DE\u05E7\u05D5\u05DD \u05D1\u05D8\u05D5\u05D7 \u05DC\u05D4\u05EA\u05D9\u05D9\u05E2\u05E5 \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD","\u05DE\u05D4 \u05EA\u05E7\u05D1\u05DC\u05D5 \u05D1\u05DE\u05E1\u05E2","\u05D4\u05E9\u05D9\u05E0\u05D5\u05D9 \u05E9\u05D9\u05D5\u05E8\u05D2\u05E9 \u05DB\u05D1\u05E8 \u05D1\u05D7\u05D5\u05D3\u05E9 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF","\u05E9\u05D9\u05E4\u05D5\u05E8 \u05D4\u05E7\u05E8\u05D1\u05D4 \u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05EA \u2014 \u05D9\u05D5\u05EA\u05E8 \u05E1\u05E7\u05E1, \u05D9\u05D5\u05EA\u05E8 \u05D2\u05D9\u05D5\u05D5\u05DF","\u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4 \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA","\u05DB\u05DC\u05D9\u05DD \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9\u05D9\u05DD \u05DC\u05E9\u05D9\u05E4\u05D5\u05E8 \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D5\u05D4\u05D1\u05E0\u05D4 \u05D0\u05D9\u05DA \u05DC\u05D4\u05EA\u05DE\u05D5\u05D3\u05D3 \u05E2\u05DD \u05E8\u05D2\u05E2\u05D9\u05DD \u05E7\u05E9\u05D9\u05DD","\u05DE\u05E7\u05D5\u05DD \u05E9\u05D1\u05D5 \u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05E9\u05D0\u05D5\u05DC \u05D5\u05DC\u05D4\u05EA\u05D9\u05D9\u05E2\u05E5 \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA","\u05E9\u05D9\u05E4\u05D5\u05E8 \u05D4\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D5\u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD","\u05DE\u05DB\u05D9\u05E0\u05D9\u05DD \u05D0\u05EA \u05D4\u05E0\u05D9\u05EA\u05D5\u05D7 \u05E9\u05DC\u05DB\u05DD\u2026","\u05D4\u05EA\u05E9\u05DC\u05D5\u05DD \u05DC\u05D0 \u05E0\u05E4\u05EA\u05D7. \u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1 \u05D0\u05D5 \u05E4\u05E0\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5.","\u05EA\u05E7\u05DC\u05EA \u05E8\u05E9\u05EA. \u05D1\u05D3\u05E7\u05D5 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D1\u05D5\u05E8 \u05D5\u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1.","\u05DC\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA \u05DC\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E2\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05D7\u05D6\u05D9\u05E8\u05D9\u05DD \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4 \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DE\u05E9\u05E0\u05EA 2021","\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA - \u05E8\u05E7 \u05E2\u05DD \u05E7\u05E6\u05EA \u05D9\u05D5\u05EA\u05E8 <em>\u05E4\u05DC\u05E4\u05DC</em>.","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D6\u05D5\u05D2\u05D9 \u05D0\u05D5 \u05E4\u05E8\u05D8\u05E0\u05D9 \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4 \u05E6\u05DE\u05D5\u05D3 \u05E9\u05D9\u05DB\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD \u05DC\u05E2\u05D5\u05DE\u05E7, \u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF, \u05D5\u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05E9\u05DC\u05D5\u05E9 \u05D3\u05E8\u05DB\u05D9\u05DD \u05DC\u05D0\u05D4\u05D1\u05D4.","\u05DE\u05D2\u05D9\u05E2 \u05DC\u05DB\u05DD \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D4","\u05D4\u05D7\u05DC \u05DE-<strong>9 \u20AA</strong>","\u05D4\u05DC\u05E7\u05D5\u05D7\u05D5\u05EA \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD","\u05D3\u05D9\u05E8\u05D5\u05D2 \u05DE\u05DE\u05D5\u05E6\u05E2","\u05D6\u05D5\u05D2 \u05DE\u05E6\u05D7\u05E7\u05E7 \u05D9\u05D7\u05D3 \u05D1\u05E8\u05D2\u05E2 \u05D9\u05D5\u05DE\u05D9\u05D5\u05DE\u05D9 \u05D7\u05DE\u05D9\u05DD","\u05DE\u05E9\u05D7\u05E7 \u05D7\u05D3\u05E9 \u05D6\u05DE\u05D9\u05DF","\"\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC\u05D0 \u05E9\u05D0\u05DC\u05E0\u05D5\"","\u05D4\u05E9\u05D1\u05D5\u05E2 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05E0\u05D9\u05E6\u05D5\u05E5 \u05D7\u05D6\u05E8 \u05D4\u05DC\u05D9\u05DC\u05D4","\u05D0\u05D9\u05E9\u05D4 \u05D1\u05E1\u05DC\u05D5\u05DF - \u05E8\u05D2\u05E2 \u05E9\u05DC \u05DE\u05D7\u05E9\u05D1\u05D4 \u05D6\u05D5\u05D2\u05D9\u05EA","\u05D4\u05D0\u05DE\u05EA \u05D4\u05D8\u05D5\u05D1\u05D4 \u05E2\u05DC \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA","\u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD <em>\u05DE\u05E1\u05D5\u05D2\u05DC\u05EA \u05DC\u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8.</em>","\u05E9\u05DC\u05D5\u05E9 \u05D4\u05D0\u05DE\u05EA\u05D5\u05EA \u05E9\u05DE\u05D7\u05D6\u05D9\u05E8\u05D5\u05EA \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DC\u05D7\u05D9\u05D9\u05DD \u2014 \u05DB\u05D0\u05DF, \u05D4\u05D9\u05D5\u05DD, \u05D1\u05DC\u05D9 \u05D8\u05D9\u05E4\u05D5\u05DC\u05D9\u05DD \u05D0\u05E8\u05D5\u05DB\u05D9\u05DD.","\u05E9\u05D9\u05D7\u05D4 \u05D0\u05D7\u05EA \u05E7\u05E6\u05E8\u05D4 \u2014 \u05DE\u05D7\u05D1\u05E8\u05EA \u05DE\u05D7\u05D3\u05E9","15 \u05D3\u05E7\u05D5\u05EA. \u05D1\u05DC\u05D9 \u05D8\u05DC\u05E4\u05D5\u05E0\u05D9\u05DD. \u05D1\u05DC\u05D9 \u05D9\u05DC\u05D3\u05D9\u05DD.<br></br>\u05EA\u05D5\u05E4\u05EA\u05E2\u05D5 \u05DE\u05D4\u05DE\u05E8\u05D7\u05E7 \u05E9\u05D0\u05EA\u05DD \u05E1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05E2\u05E8\u05D1 \u05D0\u05D7\u05D3.","\u05E9\u05D9\u05E0\u05D5\u05D9 \u05E7\u05D8\u05DF \u05DE\u05E6\u05D9\u05EA \u05D2\u05D3\u05D5\u05DC","\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E9\u05D5\u05D1\u05E8\u05D9\u05DD \u05D0\u05EA \u05D4\u05E9\u05D2\u05E8\u05D4 \u05E4\u05E2\u05DD \u05D1\u05E9\u05D1\u05D5\u05E2 \u2014 \u05E0\u05E9\u05D0\u05E8\u05D9\u05DD \u05E1\u05E7\u05E8\u05E0\u05D9\u05DD \u05D6\u05D4 \u05DC\u05D6\u05D5 \u05DC\u05D0\u05D5\u05E8\u05DA \u05E9\u05E0\u05D9\u05DD. \u05D4\u05E1\u05E7\u05E8\u05E0\u05D5\u05EA \u05D4\u05D9\u05D0 \u05D4\u05D3\u05D1\u05E7.","\u05DC\u05D1\u05D7\u05D5\u05E8 \u05D1\u05DB\u05D5\u05D5\u05E0\u05D4, \u05DC\u05D0 \u05E8\u05E7 \u05DC\u05EA\u05D7\u05D6\u05E7","\u05DB\u05DC \u05E4\u05E2\u05DD \u05E9\u05D0\u05EA\u05DD \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D5\u05DC\u05D4\u05D9\u05D5\u05EA \u05D6\u05D5\u05D2 \u2014 \u05DE\u05D7\u05D6\u05E7\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DB\u05D0\u05DF \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4 \u05D4\u05DB\u05D9 \u05E4\u05E9\u05D5\u05D8 \u05E9\u05D9\u05E9.","\u05D4\u05DB\u05D0\u05D1 \u05D4\u05DB\u05D9 \u05E9\u05E7\u05D8 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA","\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D9\u05D7\u05D3 \u2014 ","\u05D5\u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05DC\u05D1\u05D3.","\u05DC\u05D9\u05E9\u05D5\u05DF \u05D1\u05D0\u05D5\u05EA\u05D4 \u05DE\u05D9\u05D8\u05D4. \u05DC\u05D7\u05DC\u05D5\u05E7 \u05D0\u05EA \u05D0\u05D5\u05EA\u05D5 \u05DC\u05D5\u05D7 \u05D6\u05DE\u05E0\u05D9\u05DD. \u05DC\u05D4\u05D6\u05DE\u05D9\u05DF \u05D0\u05EA \u05D0\u05D5\u05EA\u05D5 \u05D0\u05D5\u05DB\u05DC. \u05D5\u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D7\u05E4\u05E9 \u05D6\u05D4 \u05D0\u05EA \u05D6\u05D4. \u05D4\u05D1\u05D3\u05D9\u05D3\u05D5\u05EA \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D4\u05D9\u05D0 \u05DC\u05D0 \u05D7\u05D5\u05E1\u05E8 \u05D0\u05D4\u05D1\u05D4 \u2014 \u05D4\u05D9\u05D0 \u05D7\u05D5\u05E1\u05E8 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA. \u05D5\u05D4\u05D9\u05D0 \u05DC\u05D0 \u05E7\u05D5\u05E8\u05D9\u05EA \u05DB\u05E9\u05DE\u05E9\u05D4\u05D5 \u05E0\u05E9\u05D1\u05E8. \u05D4\u05D9\u05D0 \u05E7\u05D5\u05E8\u05D9\u05EA \u05DB\u05E9\u05DE\u05E4\u05E1\u05D9\u05E7\u05D9\u05DD \u05DC\u05D4\u05D6\u05D9\u05DF.","\"\u05DE\u05EA\u05D9 \u05D1\u05E4\u05E2\u05DD \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5 \u05E2\u05DC \u05DE\u05E9\u05D4\u05D5 \u05D0\u05DE\u05D9\u05EA\u05D9?\"","\u05D4\u05E9\u05D9\u05D7\u05D5\u05EA \u05D4\u05E4\u05DB\u05D5 \u05DC\u05DC\u05D5\u05D2\u05D9\u05E1\u05D8\u05D9\u05E7\u05D4. \u05DE\u05D9 \u05D0\u05D5\u05E1\u05E3 \u05D0\u05EA \u05D4\u05D9\u05DC\u05D3\u05D9\u05DD. \u05DE\u05D4 \u05E6\u05E8\u05D9\u05DA \u05D1\u05E1\u05D5\u05E4\u05E8. \u05E8\u05E7 \u05D6\u05D4.","\"\u05D4\u05D5\u05D0 \u05DC\u05D9\u05D3\u05D9 \u2014 \u05D5\u05D4\u05E8\u05D0\u05E9 \u05E9\u05DC\u05D9 \u05D1\u05DE\u05E1\u05DA.\"","\u05D9\u05D7\u05D3 \u05D1\u05E1\u05DC\u05D5\u05DF. \u05DB\u05DC \u05D0\u05D7\u05D3 \u05D1\u05E2\u05D5\u05DC\u05DD \u05DE\u05E9\u05DC\u05D5. \u05E9\u05E2\u05D5\u05EA \u05E9\u05E2\u05D5\u05D1\u05E8\u05D5\u05EA \u05D1\u05DC\u05D9 \u05E9\u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5 \u05D4\u05E8\u05D9\u05DD \u05D0\u05EA \u05D4\u05E2\u05D9\u05E0\u05D9\u05D9\u05DD.","\"\u05DB\u05D1\u05E8 \u05DC\u05D0 \u05D1\u05D8\u05D5\u05D7/\u05D4 \u05DE\u05D4 \u05D4\u05D5\u05D0 \u05D7\u05D5\u05E9\u05D1/\u05EA \u05D1\u05D0\u05DE\u05EA.\"","\u05D1\u05D4\u05EA\u05D7\u05DC\u05D4 \u05D9\u05D3\u05E2\u05E0\u05D5 \u05D4\u05DB\u05DC \u05D0\u05D7\u05D3 \u05E2\u05DC \u05D4\u05E9\u05E0\u05D9. \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D9\u05E9 \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DB\u05D1\u05E8 \u05DC\u05D0 \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD. \u05D5\u05DC\u05D0 \u05EA\u05DE\u05D9\u05D3 \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD \u05DC\u05DE\u05D4.","\"\u05DE\u05EA\u05D2\u05E2\u05D2\u05E2/\u05EA \u05D0\u05DC\u05D9\u05D5/\u05D4 \u2014 \u05D5\u05D4\u05D5\u05D0/\u05D4\u05D9\u05D0 \u05DE\u05DE\u05E9 \u05DB\u05D0\u05DF.\"","\u05D4\u05E7\u05E8\u05D1\u05D4 \u05D4\u05E4\u05D9\u05D6\u05D9\u05EA \u05E2\u05D5\u05D3 \u05E4\u05D4. \u05D4\u05E8\u05D2\u05E9\u05D9\u05EA \u2014 \u05D0\u05D9\u05E4\u05E9\u05D4\u05D5 \u05D1\u05D3\u05E8\u05DA \u05D0\u05D1\u05D3\u05D4. \u05D5\u05D0\u05D9\u05DF \u05E8\u05D2\u05E2 \u05DE\u05D3\u05D5\u05D9\u05E7 \u05E9\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05E6\u05D1\u05D9\u05E2 \u05E2\u05DC\u05D9\u05D5.","\u05D5\u05D0\u05D9\u05DA \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E4\u05D5\u05EA\u05E8\u05EA \u05D0\u05EA \u05D6\u05D4","\u05DC\u05D0 \u05D8\u05D9\u05E4\u05D5\u05DC. \u05DB\u05DC\u05D9\u05DD \u05E9\u05E2\u05D5\u05D1\u05D3\u05D9\u05DD ","\u05D1\u05DC\u05D9 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D9\u05DD.","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05E9\u05DC\u05D1\u05D9\u05DD \u05E9\u05E0\u05D5\u05EA \u05E0\u05D9\u05E1\u05D9\u05D5\u05DF \u05D1\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D6\u05D5\u05D2\u05D9 \u05E2\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05D0\u05EA\u05D2\u05E8\u05D9\u05DD, \u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC\u05D0 \u05E0\u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05DE\u05D5\u05DE\u05D7\u05D4 \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DE\u05DB\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD \u05DC\u05E2\u05D5\u05DE\u05E7. \u05D4\u05DB\u05DC \u05D1\u05E0\u05D5\u05D9 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD, \u05E2\u05DD \u05D7\u05D9\u05D9\u05DD \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD, \u05E9\u05D0\u05D9\u05DF \u05DC\u05D4\u05DD \u05D6\u05DE\u05DF \u05DC-50 \u05D3\u05E7\u05D5\u05EA \u05E2\u05DC \u05E1\u05E4\u05D4.","\u05D0\u05D9\u05E9\u05D9 \u05DC\u05DB\u05DD","\u05DB\u05DC \u05D6\u05D5\u05D2 \u05DE\u05E7\u05D1\u05DC \u05DE\u05E1\u05DC\u05D5\u05DC \u05DE\u05E9\u05DC\u05D5. \u05DB\u05D9 \u05D0\u05D9\u05DF \u05E9\u05E0\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D6\u05D4\u05D9\u05DD, \u05D5\u05DC\u05D0 \u05D0\u05DE\u05D5\u05E8\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA \u05EA\u05E9\u05D5\u05D1\u05D4 \u05D0\u05D7\u05EA \u05DC\u05DB\u05D5\u05DC\u05DD.","\u05DE\u05D4\u05D9\u05E8 \u05D5\u05E4\u05E8\u05E7\u05D8\u05D9","10 \u05D3\u05E7\u05D5\u05EA \u05D1\u05D9\u05D5\u05DD, \u05DC\u05D0 \u05E9\u05E2\u05D4 \u05D1\u05E9\u05D1\u05D5\u05E2. \u05E0\u05DB\u05E0\u05E1 \u05DC\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD, \u05DC\u05D0 \u05D3\u05D5\u05E8\u05E9 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D0\u05D5\u05EA\u05DD.","\u05D9\u05E6\u05D9\u05E8\u05EA\u05D9, \u05DC\u05D0 \u05DE\u05D0\u05D9\u05D9\u05DD","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05E9\u05D0\u05DC\u05D5\u05EA, \u05E8\u05D2\u05E2\u05D9\u05DD \u05E7\u05D8\u05E0\u05D9\u05DD \u05E9\u05DE\u05E9\u05E0\u05D9\u05DD \u05D0\u05EA \u05D4\u05D8\u05D5\u05DF. \u05D1\u05DC\u05D9 \u05E1\u05E4\u05D4, \u05D1\u05DC\u05D9 \u05E4\u05E0\u05E7\u05E1, \u05D1\u05DC\u05D9 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05E9\u05D1\u05D3\u05E7\u05D5 \u05D0\u05D5\u05EA\u05DB\u05DD.","\u05E8\u05D5\u05E6\u05D4 \u05DC\u05D4\u05E4\u05E1\u05D9\u05E7 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05DC\u05D1\u05D3","\u05D0\u05D9\u05DA \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E2\u05D5\u05D1\u05D3\u05EA","\u05D4\u05E0\u05D9\u05E6\u05D5\u05E5 \u05D7\u05D5\u05D6\u05E8 \u05D1\u05D4\u05D7\u05DC\u05D8\u05D4!","5 \u05E9\u05E0\u05D9\u05DD. 500+ \u05D6\u05D5\u05D2\u05D5\u05EA.","\u05D0\u05D5\u05EA\u05D4 ","\u05EA\u05D5\u05E6\u05D0\u05D4","\u05DE\u05D0\u05D6 2021 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05DC\u05D5\u05D5\u05D9\u05DD \u05D6\u05D5\u05D2\u05D5\u05EA. <strong>\u05E9\u05DE\u05E2\u05E0\u05D5 \u05D0\u05DC\u05E4\u05D9 \u05E1\u05D9\u05E4\u05D5\u05E8\u05D9\u05DD</strong> - \u05E8\u05D0\u05D9\u05E0\u05D5 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E6\u05D5\u05D7\u05E7\u05D9\u05DD, \u05D1\u05D5\u05DB\u05D9\u05DD, \u05DE\u05EA\u05E4\u05D9\u05D9\u05E1\u05D9\u05DD, \u05D7\u05D5\u05D6\u05E8\u05D9\u05DD \u05D0\u05D7\u05D3 \u05D0\u05DC \u05D4\u05E9\u05E0\u05D9\u05D9\u05D4. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05D5\u05E9\u05D9\u05DD - \u05E0\u05D5\u05DC\u05D3 \u05DE\u05D4\u05DD. \u05DE\u05D4\u05E9\u05D9\u05D7\u05D5\u05EA, \u05DE\u05D4\u05DE\u05E9\u05D5\u05D1\u05D9\u05DD, \u05DE\u05D4\u05D3\u05DE\u05E2\u05D5\u05EA, \u05DE\u05D4\u05D7\u05D9\u05D5\u05DB\u05D9\u05DD. \u05D6\u05D0\u05EA \u05D4\u05E1\u05D9\u05D1\u05D4 \u05E9\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05D0 \u05E0\u05E9\u05D0\u05E8 \u05D0\u05D5\u05EA\u05D5 \u05D3\u05D1\u05E8. \u05D4\u05D5\u05D0 \u05DE\u05E9\u05EA\u05E0\u05D4, \u05D2\u05D3\u05DC, \u05DE\u05EA\u05D7\u05D3\u05E9. <strong>\u05D1\u05D3\u05D9\u05D5\u05E7 \u05DB\u05DE\u05D5 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D1\u05E8\u05D9\u05D0\u05D4.</strong>","\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D1\u05D7\u05E8\u05D5 \u05D1\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05D0\u05D6 2021","\u05D1\u05D9\u05E9\u05E8\u05D0\u05DC \u05D5\u05D1\u05E8\u05D7\u05D1\u05D9 \u05D4\u05E2\u05D5\u05DC\u05DD","\u05DE\u05D3\u05D5\u05D5\u05D7\u05D9\u05DD \u05E2\u05DC \u05E9\u05D9\u05E4\u05D5\u05E8","\u05D1\u05DE\u05D9\u05DC\u05D9\u05DD \u05E9\u05DC\u05D4\u05DD","\u05DB\u05EA\u05D1\u05D5 \u05E2\u05DC\u05D9\u05E0\u05D5 \u05E4\u05E2\u05DD. \u05D5\u05D0\u05D6 \u05E9\u05D5\u05D1.","\u05DB\u05EA\u05D1\u05D5 \u05E2\u05DC\u05D9\u05E0\u05D5 \u05E4\u05E2\u05DD.","\u05D5\u05D0\u05D6 \u05E9\u05D5\u05D1.","\u05E7\u05E8\u05D0\u05D5 \u05D0\u05EA \u05D4\u05DB\u05EA\u05D1\u05D4","\u05D9\u05E9\u05E8\u05D0\u05DC \u05D4\u05D9\u05D5\u05DD","\u05DE\u05D3\u05D5\u05E8 \u05DE\u05D5\u05DE\u05DC\u05E6\u05D9\u05DD","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E2\u05D5\u05D6\u05E8\u05EA \u05DC\u05DE\u05D0\u05D5\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4 \u05E9\u05D0\u05D1\u05D3\u05D4 - \u05D1\u05DE\u05E7\u05D5\u05DD \u05DC\u05D4\u05D9\u05E4\u05E8\u05D3.","walla!","TLD \u00B7 \u05DE\u05D2\u05D6\u05D9\u05DF \u05D4\u05D7\u05D9\u05D9\u05DD","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05DE\u05E6\u05D9\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA - \u05E2\u05DD \u05DC\u05D9\u05D5\u05D5\u05D9 \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9 \u05D0\u05D9\u05E9\u05D9 \u05DC\u05DB\u05DC \u05D6\u05D5\u05D2.","Walla!","\u05D9\u05E6\u05D7\u05E7 \u05D1\u05E8\u05DC\u05D1 - \u05DE\u05D9\u05D9\u05E1\u05D3 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05D9\u05D9\u05E1\u05D3 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D9\u05E6\u05D7\u05E7 \u05D1\u05E8\u05DC\u05D1","\u05D4\u05DB\u05D9\u05E8\u05D5 \u05D0\u05EA \u05D4\u05DE\u05D9\u05D9\u05E1\u05D3 \u00B7 \u05D9\u05E6\u05D7\u05E7 \u05D1\u05E8\u05DC\u05D1","\u05E9\u05D9\u05E0\u05D4 \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC 500+ \u05D6\u05D5\u05D2\u05D5\u05EA \u05D1\u05E2\u05D6\u05E8\u05EA \u05DE\u05E9\u05D7\u05E7.","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05E2\u05D5\u05DE\u05D3 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05D5\u05D4\u05DE\u05DC\u05D5\u05D5\u05D4 \u05E9\u05DC\u05DB\u05DD \u05D1\u05DB\u05DC \u05E6\u05E2\u05D3. \u05D1\u05DE\u05E9\u05DA \u05E9\u05E0\u05D9\u05DD, \u05D9\u05E6\u05D7\u05E7 \u05E9\u05D9\u05E0\u05D4 \u05D0\u05EA \u05E2\u05D5\u05DC\u05DD \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E2\u05D1\u05D5\u05E8 500+ \u05D6\u05D5\u05D2\u05D5\u05EA \u05D1\u05D9\u05E9\u05E8\u05D0\u05DC \u05D5\u05D1\u05E2\u05D5\u05DC\u05DD - \u05D3\u05E8\u05DA \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05EA, \u05D5\u05E4\u05E9\u05D5\u05D8 \u05E2\u05D5\u05D3 \u05D3\u05E8\u05DA \u05DC\u05D3\u05D1\u05E8. \u05D4\u05D7\u05D6\u05D5\u05DF \u05E9\u05DC\u05D5 \u05D0\u05D7\u05D3 \u05D5\u05D1\u05E8\u05D5\u05E8: <strong>\u05DC\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E9\u05D2\u05E8\u05D4. \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05E7\u05E8\u05D1\u05D4.</strong>","\u05EA\u05E4\u05E7\u05D9\u05D3","\u05DE\u05D5\u05DE\u05D7\u05D9\u05D5\u05EA","\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D5\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA","\u05D1\u05D7\u05D9\u05D9\u05DD \u05D4\u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD","\u05E0\u05E9\u05D5\u05D9, \u05D0\u05D1\u05D0 \u05DC-3","\u05E7\u05E8\u05D0\u05D5 \u05D0\u05EA \u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05D4\u05DE\u05DC\u05D0","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D7\u05D5\u05D3\u05E9\u05D9 \u00B7 \u05DC\u05DC\u05D0 \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA","\u05DB\u05DC \u05D7\u05D5\u05D3\u05E9 \u05E9\u05E2\u05D5\u05D1\u05E8<br></br>\u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD <em>\u05DE\u05EA\u05D7\u05D6\u05E7\u05EA.</em>","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05DC\u05D5\u05D5\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD \u05DB\u05D6\u05D5\u05D2 \u05D5\u05E4\u05E8\u05D8\u05E0\u05D9\u05EA, \u05E2\u05D5\u05D1\u05D3\u05D9\u05DD \u05E2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D9\u05D7\u05D3. \u05DC\u05DC\u05D0 \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA, \u05DC\u05DC\u05D0 \u05D7\u05D5\u05D6\u05D4 \u05D0\u05E8\u05D5\u05DA \u05D8\u05D5\u05D5\u05D7, \u05E0\u05D9\u05EA\u05DF \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2. \u05DB\u05DB\u05D4 \u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05D1\u05E4\u05D5\u05E2\u05DC:","\u05D4\u05D9\u05DB\u05E8\u05D5\u05EA \u05DE\u05D7\u05D3\u05E9","\u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9 \u05E7\u05E6\u05E8, \u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC\u05D0 \u05E9\u05D0\u05DC\u05EA\u05DD - \u05D5\u05E4\u05EA\u05D0\u05D5\u05DD \u05D0\u05EA\u05DD \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05DC\u05D3\u05D1\u05E8 \u05E2\u05DC \u05DE\u05D4 \u05E9\u05D1\u05D0\u05DE\u05EA \u05D7\u05E9\u05D5\u05D1.","\u05D0\u05D1\u05D7\u05D5\u05DF \u05DE\u05D5\u05EA\u05D0\u05DD","\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA","\u05E9\u05D0\u05DC\u05D5\u05EA \u05E4\u05EA\u05D9\u05D7\u05D4","\u05E9\u05D1\u05D9\u05E8\u05EA \u05D4\u05E9\u05E2\u05DE\u05D5\u05DD \u05D4\u05DE\u05D9\u05E0\u05D9","\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA, \u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05D5\u05D7\u05D5\u05D5\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA - \u05D5\u05E4\u05EA\u05D0\u05D5\u05DD \u05D0\u05EA\u05DD \u05D6\u05D5\u05DB\u05E8\u05D9\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DC\u05DE\u05D4 \u05D4\u05EA\u05D0\u05D4\u05D1\u05EA\u05DD \u05E4\u05E2\u05DD. \u05D2\u05DD \u05D1\u05D7\u05D3\u05E8 \u05D4\u05E9\u05D9\u05E0\u05D4.","\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05D1\u05D5\u05E2\u05D9\u05D5\u05EA","\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD","\u05D7\u05D5\u05D5\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA","\u05D7\u05D9\u05D1\u05D5\u05E8 \u05E2\u05DE\u05D5\u05E7","\u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D7\u05D5\u05D6\u05E8\u05EA. \u05D4\u05E9\u05D9\u05D7\u05D5\u05EA \u05DE\u05E2\u05DE\u05D9\u05E7\u05D5\u05EA. \u05D0\u05EA\u05DD \u05E9\u05D5\u05D1 \u05D7\u05D1\u05E8\u05D9\u05DD \u05DC\u05D3\u05E8\u05DA - \u05D5\u05DE\u05EA\u05D7\u05D1\u05E8\u05D9\u05DD \u05D2\u05DD \u05D1\u05D7\u05D3\u05E8 \u05D4\u05E9\u05D9\u05E0\u05D4.","\u05E7\u05E8\u05D1\u05D4 \u05E8\u05D2\u05E9\u05D9\u05EA","\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA","\u05E9\u05D9\u05D7\u05D5\u05EA \u05E2\u05D5\u05DE\u05E7","\u05D4\u05EA\u05D7\u05D3\u05E9\u05D5\u05EA \u05E9\u05DC\u05D0 \u05E0\u05D2\u05DE\u05E8\u05EA","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD \u05DB\u05DC \u05E2\u05D5\u05D3 \u05EA\u05E8\u05E6\u05D5. \u05DB\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D1\u05E8\u05D9\u05D0\u05D4 - \u05D4\u05D9\u05D0 \u05DE\u05E9\u05D4\u05D5 \u05E9\u05DE\u05EA\u05D7\u05D3\u05E9 \u05DB\u05DC \u05D9\u05D5\u05DD.","\u05D4\u05E8\u05D2\u05DC\u05D9\u05DD \u05D7\u05D3\u05E9\u05D9\u05DD","\u05EA\u05D5\u05DB\u05DF \u05DE\u05EA\u05E2\u05D3\u05DB\u05DF","\u05E7\u05D4\u05D9\u05DC\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA","\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC? \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2.","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05D0\u05EA \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF","\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DB\u05D1\u05E8","\u05D4\u05D8\u05E8\u05D9\u05E4\u05D5"," \u05D0\u05EA \u05D4\u05DE\u05D3\u05D9\u05E0\u05D4.","\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D9\u05E4\u05EA\u05D7? \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8? \u05DC\u05D4\u05EA\u05D2\u05DC\u05D5\u05EA \u05DE\u05D7\u05D3\u05E9? 500+ \u05D6\u05D5\u05D2\u05D5\u05EA \u05D1\u05D9\u05E9\u05E8\u05D0\u05DC \u05DB\u05D1\u05E8 \u05DE\u05DE\u05DC\u05D9\u05E6\u05D9\u05DD - \u05DE\u05D4\u05E1\u05DC\u05D5\u05DF, \u05DE\u05D4\u05DE\u05D9\u05D8\u05D4, \u05D5\u05D0\u05E4\u05D9\u05DC\u05D5 \u05DB\u05E9\u05D0\u05D7\u05D3 \u05DE\u05DB\u05DD \u05D1\u05D7\u05D5\"\u05DC. \u05D0\u05EA\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD \u05D1\u05EA\u05D5\u05E8.","\"\u05EA\u05DB\u05E0\u05D9\u05E1\u05D5 \u05EA\u05E9\u05D5\u05E7\u05D4. \u05EA\u05EA\u05D7\u05D1\u05E8\u05D5 \u05DE\u05D7\u05D3\u05E9. \u05EA\u05EA\u05D0\u05D4\u05D1\u05D5 \u05D5\u05EA\u05D7\u05D6\u05D9\u05E8\u05D5 \u05D0\u05EA \u05D4\u05E4\u05E8\u05E4\u05E8\u05D9\u05DD - \u05D1\u05DE\u05D9\u05D5\u05D7\u05D3 \u05DC\u05DE\u05D9 \u05E9\u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05E8\u05D5\u05DB\u05D4 \u05E2\u05DD \u05D9\u05DC\u05D3\u05D9\u05DD, \u05D5\u05DE\u05E8\u05D2\u05D9\u05E9 \u05D0\u05D9\u05DA \u05D4\u05E9\u05D7\u05D9\u05E7\u05D4 \u05E2\u05D5\u05E9\u05D4 \u05D0\u05EA \u05E9\u05DC\u05D4.\"","\u05E2\u05E0\u05EA","+500","\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD","+100","\u05D4\u05DE\u05DC\u05E6\u05D5\u05EA","\u05DC\u05DB\u05DC \u05D6\u05D5\u05D2","\u05D0\u05D9\u05DA \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD?","\u05DE\u05E1\u05E7\u05E8\u05DF","\u05D0\u05DE\u05EA \u05D0\u05D5","\u05DE\u05E2\u05DE\u05D9\u05E7","\u05E1\u05D9\u05E4\u05D5\u05E8","\u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5","\u05E7\u05DC\u05D9\u05DC","50 \u05E9\u05D0\u05DC\u05D5\u05EA","\u05E9\u05DC\u05D0 \u05E9\u05D0\u05DC\u05E0\u05D5","18+","\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05DE\u05D5\u05D7\u05DC\u05D8\u05EA","- \u05D7\u05D5\u05E7\u05D9 \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 -","\u05DC\u05D0 \u05DC\u05DB\u05DC \u05D0\u05D7\u05D3.<br></br><em>\u05DC\u05D0\u05DE\u05D9\u05E6\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3.</em>","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D4\u05DB\u05D9\u05E0\u05D5 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u05D0\u05EA \"\u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9\" - \u05DE\u05E9\u05D7\u05E7\u05D9 \u05DE\u05D9\u05DF \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05DC\u05D2\u05D5\u05D5\u05DF, \u05DC\u05D4\u05E4\u05EA\u05D9\u05E2 \u05D5\u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05E8\u05D9\u05D2\u05D5\u05E9. <strong>\u05D7\u05D5\u05D5\u05D9\u05D4 \u05E9\u05EA\u05D9\u05E9\u05D0\u05E8 \u05D0\u05EA\u05DB\u05DD \u05D4\u05E8\u05D1\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05D0\u05D5\u05E8\u05D5\u05EA \u05D9\u05DB\u05D1\u05D5.</strong>","\u05E0\u05DB\u05EA\u05D1 \u05E2\u05DC\u05BE\u05D9\u05D3\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD","\u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05DD \u05D1\u05DB\u05D9\u05E8\u05D9\u05DD, \u05DE\u05D8\u05E4\u05DC\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD \u05DE\u05D4\u05D0\u05E7\u05D3\u05DE\u05D9\u05D4, \u05D5\u05D7\u05D5\u05E7\u05E8\u05D9 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA.","\u05E2\u05D5\u05E6\u05D1 \u05DC\u05D7\u05D3\u05E8 \u05D4\u05DE\u05D9\u05D8\u05D5\u05EA","\u05DB\u05DC \u05DE\u05D4\u05DC\u05DA \u05D1\u05DE\u05E9\u05D7\u05E7 \u05E0\u05D1\u05E0\u05D4 \u05E2\u05DD \u05E6\u05D9\u05E4\u05D9\u05D9\u05D4 - \u05DE\u05D5\u05D1\u05DC \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD, \u05D0\u05DC \u05D1\u05D9\u05DC\u05D5\u05D9 \u05D5\u05E1\u05E7\u05E1 \u05E9\u05EA\u05D6\u05DB\u05E8\u05D5 \u05D4\u05E8\u05D1\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E0\u05D2\u05DE\u05E8.","\u05E8\u05E7 \u05DC\u05DB\u05DD. \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2.","\u05D6\u05DE\u05D9\u05DF \u05DE\u05EA\u05D9 \u05E9\u05EA\u05E8\u05E6\u05D5 - \u05EA\u05E7\u05D1\u05E2\u05D5 \u05E2\u05E8\u05D1, \u05EA\u05E4\u05EA\u05D7\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7, \u05D5\u05D4\u05D4\u05D5\u05E8\u05D0\u05D5\u05EA \u05DE\u05D5\u05DB\u05E0\u05D5\u05EA \u05DC\u05DB\u05DD. <strong>\u05E8\u05DB\u05D9\u05E9\u05D4 \u05D0\u05D7\u05EA, \u05D2\u05D9\u05E9\u05D4 \u05DE\u05DC\u05D0\u05D4 - \u05DC\u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD.</strong>","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05DE\u05D9\u05DF \u05DC\u05D0\u05DE\u05D9\u05E6\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3.","\u05D0\u05D5\u05DC\u05D9 \u05D4\u05D2\u05D9\u05E2 \u05D4\u05D6\u05DE\u05DF<br></br><em>\u05DC\u05D3\u05D1\u05E8 \u05D0\u05D7\u05E8\u05EA.</em>","\u05D0\u05DC \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DB\u05E0\u05D9\u05E1\u05D4 \u05DC\u05D1\u05E0\u05D9 18+","\u05DE\u05D0\u05D5\u05DE\u05EA \u05E2\u05DC\u05BE\u05D9\u05D3\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD","\u05DC\u05DE\u05D4 \u05D6\u05D4 \u05E7\u05D5\u05E8\u05D4","\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DC\u05D0 \u05E0\u05E9\u05D1\u05E8\u05EA \u05D1\u05DC\u05D9\u05DC\u05D4 \u05D0\u05D7\u05D3.<br></br>\u05D4\u05D9\u05D0 \u05E0\u05E9\u05D7\u05E7\u05EA \u05DC\u05D0\u05D8.","\u05E9\u05D2\u05E8\u05D4, \u05D9\u05DC\u05D3\u05D9\u05DD, \u05E7\u05E8\u05D9\u05D9\u05E8\u05D4, \u05E2\u05D9\u05D9\u05E4\u05D5\u05EA - \u05D4\u05DD \u05DC\u05D0 \u05E8\u05E2\u05D9\u05DD. \u05D4\u05DD \u05E4\u05E9\u05D5\u05D8 <strong>\u05D3\u05D5\u05D7\u05E7\u05D9\u05DD \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DC\u05E4\u05D9\u05E0\u05D4</strong>. \u05D5\u05D1\u05D9\u05D5\u05DD \u05E9\u05D1\u05D5 \u05D0\u05EA\u05DD \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD \u05E9\u05D0\u05EA\u05DD \u05D6\u05E8\u05D9\u05DD, \u05D4\u05E9\u05D7\u05D9\u05E7\u05D4 \u05DB\u05D1\u05E8 \u05E0\u05E2\u05E9\u05EA\u05D4 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05E0\u05D9\u05DD.","\u05DE\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05D3\u05D5\u05D5\u05D7\u05D9\u05DD \u05E2\u05DC \u05D9\u05E8\u05D9\u05D3\u05D4 \u05D1\u05E7\u05E8\u05D1\u05D4 \u05D4\u05E8\u05D2\u05E9\u05D9\u05EA \u05D0\u05D7\u05E8\u05D9 5 \u05E9\u05E0\u05D9\u05DD"," \u05D3\u05E7\u05F3","\u05DE\u05E1\u05E4\u05D9\u05E7\u05D5\u05EA \u05D1\u05D9\u05D5\u05DD \u05DB\u05D3\u05D9 \u05DC\u05E9\u05E0\u05D5\u05EA \u05D0\u05EA \u05D4\u05D3\u05D9\u05E0\u05DE\u05D9\u05E7\u05D4 - \u05D0\u05DD \u05DE\u05E9\u05E7\u05D9\u05E2\u05D9\u05DD \u05E0\u05DB\u05D5\u05DF","\u05E9\u05D9\u05E4\u05D5\u05E8 \u05D1\u05E9\u05D1\u05D9\u05E2\u05D5\u05EA \u05E8\u05E6\u05D5\u05DF \u05D0\u05E6\u05DC \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E2\u05D5\u05E1\u05E7\u05D9\u05DD \u05D1\u05E7\u05E9\u05E8 \u05D1\u05D0\u05D5\u05E4\u05DF \u05D9\u05D6\u05D5\u05DD"," \u05D9\u05D5\u05DD","\u05D4\u05D6\u05DE\u05DF \u05D4\u05DE\u05DE\u05D5\u05E6\u05E2 \u05E9\u05DC\u05D5\u05E7\u05D7 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05E6\u05DC\u05E0\u05D5 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05E9\u05D9\u05E0\u05D5\u05D9 \u05D0\u05DE\u05D9\u05EA\u05D9","\u05DC\u05DE\u05D9 \u05D6\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD","\u05D0\u05DD \u05D0\u05EA\u05DD \u05DE\u05D6\u05D4\u05D9\u05DD \u05D0\u05EA \u05E2\u05E6\u05DE\u05DB\u05DD","\u05D1\u05D0\u05D7\u05D3 \u05DE\u05D0\u05DC\u05D4 - \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 ","\u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD.","\u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05D0 \u05DC\u05DB\u05D5\u05DC\u05DD. \u05D4\u05D5\u05D0 \u05DC\u05DE\u05D9 \u05E9\u05DE\u05D5\u05DB\u05DF \u05DC\u05D1\u05D7\u05D5\u05E8 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D7\u05E8\u05EA.","\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05E0\u05D9\u05E6\u05D5\u05E5","\u05D4\u05E9\u05D2\u05E8\u05D4 \u05D4\u05E9\u05EA\u05DC\u05D8\u05D4 \u05D5\u05D0\u05EA\u05DD \u05DE\u05EA\u05D2\u05E2\u05D2\u05E2\u05D9\u05DD \u05DC\u05DE\u05D1\u05D8\u05D9\u05DD \u05E9\u05DC \u05E4\u05E2\u05DD, \u05DC\u05E8\u05E6\u05D5\u05DF \u05DC\u05D4\u05D9\u05D5\u05EA \u05D9\u05D7\u05D3, \u05DC\u05D7\u05D9\u05D5\u05DA \u05D4\u05E1\u05E4\u05D5\u05E0\u05D8\u05E0\u05D9.","\u05D4\u05DE\u05E1\u05E2 \u05D4\u05D6\u05D5\u05D2\u05D9 \u05D4\u05DE\u05D5\u05D3\u05E8\u05DA","\u05E8\u05D5\u05E6\u05D9\u05DD \u05D6\u05DE\u05DF \u05D6\u05D5\u05D2\u05D9 \u05D1\u05D0\u05DE\u05EA","\u05D4\u05D9\u05DC\u05D3\u05D9\u05DD, \u05D4\u05E2\u05D1\u05D5\u05D3\u05D4, \u05D4\u05D1\u05D9\u05EA - \u05D5\u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E0\u05E9\u05D0\u05E8\u05D4 \u05D0\u05D7\u05E8\u05D5\u05E0\u05D4. \u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05D5\u05EA\u05D4 \u05DC\u05E8\u05D0\u05E9 \u05D4\u05E1\u05D3\u05E8.","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D7\u05D5\u05D3\u05E9\u05D9 \u05D2\u05DE\u05D9\u05E9","\u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05D9\u05E2\u05D6\u05D5\u05E8","\u05D4\u05D9\u05D9\u05EA\u05DD \u05D0\u05E6\u05DC \u05DE\u05D8\u05E4\u05DC\u05EA. \u05E2\u05D6\u05E8 \u05D1\u05D0\u05D5\u05E4\u05DF \u05D7\u05DC\u05E7\u05D9. \u05D0\u05EA\u05DD \u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8 - \u05D7\u05D5\u05D5\u05D9\u05EA\u05D9, \u05E4\u05D7\u05D5\u05EA \u05DB\u05D1\u05D3, \u05D9\u05D5\u05EA\u05E8 \u05D1\u05D9\u05D7\u05D3.","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E2\u05DD \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5","\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8 \u05DE\u05D7\u05D3\u05E9","\u05D4\u05E7\u05E9\u05E8 \u05D8\u05D5\u05D1. \u05D0\u05EA\u05DD \u05E8\u05E7 \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05E2\u05DC\u05D5\u05EA \u05D4\u05D9\u05DC\u05D5\u05DA - \u05D7\u05D5\u05D5\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA, \u05E9\u05D9\u05D7\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA, \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D4.","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D7\u05D9\u05D1\u05D5\u05E8 \u05D5\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA","\u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05D1\u05D9\u05DC\u05D5\u05D9 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9 \u05DE\u05D4\u05E0\u05D4","\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D7\u05DC\u05D9\u05E3 \u05D0\u05EA \u05D4\u05E1\u05D3\u05E8\u05D4 \u05D1\u05E0\u05D8\u05E4\u05DC\u05D9\u05E7\u05E1 \u05D1\u05E2\u05E8\u05D1 \u05DE\u05D4\u05E0\u05D4 \u05D5\u05DE\u05D7\u05D1\u05E8 \u05D1\u05D0\u05DE\u05EA. \u05D1\u05DC\u05D9 \u05D4\u05DB\u05E0\u05D4, \u05D1\u05DC\u05D9 \u05DC\u05D7\u05E5.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF","\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E4\u05DC\u05E4\u05DC \u05D0\u05EA \u05D7\u05D9\u05D9 \u05D4\u05DE\u05D9\u05DF","\u05D0\u05EA\u05DD \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05E7\u05E6\u05EA \u05D4\u05E8\u05E4\u05EA\u05E7\u05E0\u05D5\u05EA - \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4, \u05DC\u05D2\u05DC\u05D5\u05EA \u05E6\u05D3 \u05D7\u05D3\u05E9, \u05DC\u05E4\u05EA\u05D7 \u05D0\u05EA \u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA.","\u05D1\u05D7\u05D9\u05E0\u05DD \u00B7 90 \u05E9\u05E0\u05D9\u05D5\u05EA \u00B7 \u05D1\u05DC\u05D9 \u05D4\u05E8\u05E9\u05DE\u05D4","\u05D1\u05D5\u05D0\u05D5 \u05D2\u05DC\u05D5 \u05E2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DC\u05D0 \u05D9\u05D3\u05E2\u05EA\u05DD - \u05D7\u05D9\u05E0\u05DD \u05DC\u05D2\u05DE\u05E8\u05D9.","\u05D1\u05D5\u05D0\u05D5 \u05DC\u05D2\u05DC\u05D5\u05EA \u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD","\u05D4\u05DE\u05D7\u05D9\u05E8\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5","\u05E9\u05E7\u05D9\u05E4\u05D5\u05EA \u05DE\u05DC\u05D0\u05D4.<br></br>\u05D1\u05DC\u05D9 \u05D4\u05E4\u05EA\u05E2\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA.","\u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD, \u05E9\u05DC\u05D5\u05E9 \u05D3\u05E8\u05DB\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8. \u05D1\u05D7\u05E8\u05D5 \u05DE\u05D4 \u05E9\u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DD - \u05D5\u05E2\u05E6\u05E8\u05D5 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 \u05E9\u05EA\u05E8\u05E6\u05D5.","/ \u05E9\u05D1\u05D5\u05E2","\u05E0\u05D9\u05EA\u05DF \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 \u00B7 <s>\u20AA87 \u05DC\u05DE\u05E9\u05D7\u05E7 \u05D1\u05E7\u05D5\u05E4\u05E1\u05D4</s>","\u05DE\u05D2\u05D5\u05D5\u05DF \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD - \u05D1\u05E0\u05D9\u05D9\u05D3, \u05D1\u05DE\u05D7\u05E9\u05D1 \u05D5\u05D1\u05D8\u05D0\u05D1\u05DC\u05D8, \u05DE\u05DB\u05DC \u05DE\u05E7\u05D5\u05DD","\u05DE\u05D0\u05D5\u05EA \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05D9\u05E6\u05E8\u05D5 \u05DE\u05D5\u05DE\u05D7\u05D9 \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5","\u05D0\u05EA\u05DD \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05D0\u05D9\u05D6\u05D4 \u05DE\u05E9\u05D7\u05E7 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DD \u05D4\u05E2\u05E8\u05D1","\u05D2\u05DD \u05DB\u05E9\u05D0\u05EA\u05DD \u05E8\u05D7\u05D5\u05E7\u05D9\u05DD - \u05E9\u05D7\u05E7\u05D5 \u05D9\u05D7\u05D3 \u05D5\u05D4\u05EA\u05D7\u05D1\u05E8\u05D5 \u05DE\u05D7\u05D3\u05E9","\u05D4\u05E0\u05D0\u05D4 \u05E8\u05E6\u05D5\u05E4\u05D4, \u05E0\u05D2\u05D9\u05E9\u05D4 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2","\u05D1\u05D7\u05E8\u05D5 \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA","\u05D4\u05DE\u05D5\u05DE\u05DC\u05E5 \u05D1\u05D9\u05D5\u05EA\u05E8","\u05D1\u05DE\u05E7\u05D5\u05DD <s>\u20AA114 \u05DC\u05E9\u05D1\u05D5\u05E2</s>","\u05E9\u05E0\u05D9\u05DB\u05DD \u05D1\u05DE\u05D7\u05D9\u05E8 \u05D0\u05D7\u05D3","\u05D6\u05D5\u05D2\u05D9 \u05DC\u05D7\u05DC\u05D5\u05D8\u05D9\u05DF","\u05DB\u05D5\u05DC\u05DC \u05D4\u05DB\u05DC","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF + \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9 \u05DE\u05DB\u05D5\u05D5\u05DF","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05DC\u05D5\u05DE\u05D3\u05D9\u05DD \u05DC\u05D4\u05DB\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD \u05D1\u05D0\u05D5\u05E4\u05DF \u05D9\u05D9\u05D7\u05D5\u05D3\u05D9, \u05DE\u05D4 \u05E9\u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DD \u05DC\u05D0 \u05D9\u05E7\u05D1\u05DC\u05D5","\u05D0\u05D6\u05D5\u05E8 \u05D0\u05D9\u05DE\u05D5\u05DF \u05D6\u05D5\u05D2\u05D9 \u05DE\u05E9\u05D5\u05EA\u05E3","\u05E1\u05D1\u05D9\u05D1\u05D4 \u05E9\u05E0\u05D1\u05E0\u05D9\u05EA \u05D1\u05D3\u05D9\u05D5\u05E7 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD, \u05DE\u05E8\u05D7\u05D1 \u05D0\u05D9\u05E9\u05D9 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D4\u05E7\u05E9\u05D5\u05EA, \u05D0\u05EA\u05DD \u05E2\u05D5\u05E0\u05D9\u05DD - \u05D5\u05D4\u05DD \u05D1\u05D5\u05E0\u05D9\u05DD \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u05D0\u05E1\u05D8\u05E8\u05D8\u05D2\u05D9\u05D9\u05EA \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA","\u05DE\u05E2\u05E0\u05D4 \u05D0\u05D9\u05E9\u05D9 \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05E6'\u05D0\u05D8 \u05E4\u05E0\u05D9\u05DE\u05D9","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5","/ \u05DE\u05E9\u05D7\u05E7","\u05E8\u05DB\u05D9\u05E9\u05D4 \u05D1\u05D5\u05D3\u05D3\u05EA \u00B7 <s>\u20AA200 \u05DC\u05DE\u05E9\u05D7\u05E7</s>","\u05D7\u05D5\u05D5\u05D9\u05D4 \u05DE\u05D5\u05D3\u05E8\u05DB\u05EA - \u05E0\u05E0\u05D7\u05D4 \u05D0\u05EA\u05DB\u05DD \u05E9\u05DC\u05D1 \u05D0\u05D7\u05E8 \u05E9\u05DC\u05D1","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DE\u05E7\u05D5\u05E8\u05D9\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05E8\u05DB\u05D9\u05E9\u05D4 \u05D0\u05D7\u05EA - \u05D2\u05D9\u05E9\u05D4 \u05D7\u05D5\u05E4\u05E9\u05D9\u05EA \u05DC\u05D1\u05DF/\u05EA \u05D4\u05D6\u05D5\u05D2","\u05D7\u05D3-\u05E4\u05E2\u05DE\u05D9, \u05D1\u05DC\u05D9 \u05DE\u05E0\u05D5\u05D9","\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05DE\u05DC\u05D0\u05D4","\u05E0\u05D9\u05EA\u05DF \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2","\u05DC\u05DC\u05D0 \u05D3\u05DE\u05D9 \u05D1\u05D9\u05D8\u05D5\u05DC","\u05EA\u05E9\u05DC\u05D5\u05DD \u05DE\u05D0\u05D5\u05D1\u05D8\u05D7","\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05D4 \u05D1\u05D0 \u05DC\u05DB\u05DD \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA?","\u05E9\u05DC\u05D5\u05E9 \u05D3\u05E8\u05DB\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8 - \u05DE\u05E9\u05D7\u05E7 \u05E7\u05DC\u05D9\u05DC, \u05D7\u05D5\u05D5\u05D9\u05D4 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05EA, \u05D0\u05D5 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05D0\u05D9\u05E9\u05D9 \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4 \u05E6\u05DE\u05D5\u05D3.","\u05D1\u05D0 \u05DC\u05D9 \u05E9\u05E0\u05E6\u05D7\u05E7 \u05D9\u05D7\u05D3","\u05E2\u05E8\u05D1 \u05D0\u05D7\u05D3, \u05E1\u05E4\u05D4 \u05D0\u05D7\u05EA. \u05DE\u05E9\u05D7\u05E7 \u05D6\u05D5\u05D2\u05D9 \u05E9\u05D0\u05EA\u05DD \u05E4\u05D5\u05EA\u05D7\u05D9\u05DD \u05DE\u05D4\u05D8\u05DC\u05E4\u05D5\u05DF, \u05D1\u05DC\u05D9 \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA.","\u05D0\u05DE\u05EA \u05D0\u05D5 \u05D7\u05D5\u05D1\u05D4, \u05D2\u05DC\u05D2\u05DC \u05E9\u05D0\u05DC\u05D5\u05EA, \u05E0\u05D7\u05E9\u05D9\u05DD \u05D5\u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D6\u05D5\u05D2\u05D9 - \u05D5\u05D2\u05D9\u05E9\u05D4 \u05DC\u05DE\u05D2\u05D5\u05D5\u05DF \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05D9\u05EA\u05D7\u05D3\u05E9\u05D5 \u05DC\u05D0\u05D5\u05E8\u05DA \u05D6\u05DE\u05DF.","\u05DE\u05EA\u05D9 \u05D6\u05D4 \u05D4\u05D3\u05D1\u05E8 \u05D4\u05E0\u05DB\u05D5\u05DF","\u05D9\u05D5\u05DD \u05D4\u05D5\u05DC\u05D3\u05EA, \u05D9\u05D5\u05DD \u05D0\u05D4\u05D1\u05D4, \u05D0\u05D5 \u05E1\u05EA\u05DD \u05E2\u05E8\u05D1 \u05E9\u05DE\u05EA\u05D7\u05E9\u05E7 \u05DC\u05DB\u05DD \u05DC\u05E6\u05D0\u05EA \u05DE\u05D4\u05E9\u05D2\u05E8\u05D4.","9 \u20AA","\u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05D1\u05E7\u05D8\u05DF","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05DC\u05E9\u05D7\u05E7 \u05D7\u05D9\u05E0\u05DD","\u05D1\u05D0 \u05DC\u05D9 \u05E9\u05E0\u05E2\u05D6 \u05D9\u05D7\u05D3","\u05E1\u05D2\u05E8\u05EA\u05DD \u05D0\u05EA \u05D4\u05D3\u05DC\u05EA, \u05D5\u05E8\u05E7 \u05D0\u05EA\u05DD \u05E9\u05E0\u05D9\u05DB\u05DD. \u05D0\u05D5\u05E1\u05E3 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D5\u05D4\u05E0\u05D7\u05D9\u05D5\u05EA \u05E9\u05DB\u05EA\u05D1\u05D5 \u05DE\u05D5\u05DE\u05D7\u05D9 \u05D4\u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05E9\u05D9\u05D5\u05D1\u05D9\u05DC\u05D5 \u05D0\u05EA\u05DB\u05DD \u05DC\u05D1\u05D9\u05DC\u05D5\u05D9 \u05E9\u05EA\u05D6\u05DB\u05E8\u05D5 \u05D5\u05DC\u05E1\u05D9\u05D5\u05DD \u05E2\u05DD happy end.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DC\u05D7\u05D3\u05E8 \u05D4\u05E9\u05D9\u05E0\u05D4 \u00B7 \u05E8\u05DE\u05D5\u05EA \u05D7\u05D9\u05DE\u05D5\u05DD \u00B7 \u05E9\u05D0\u05DC\u05D5\u05EA-\u05D0\u05EA\u05D2\u05E8 \u00B7 \u05D0\u05D5\u05D5\u05D9\u05E8\u05D4 \u05E7\u05D5\u05DC\u05E0\u05D5\u05E2\u05D9\u05EA","\u05E1\u05D2\u05E8\u05EA\u05DD \u05E4\u05D9\u05E0\u05D4 \u05DC\u05E2\u05E6\u05DE\u05DB\u05DD. \u05D1\u05D0 \u05DC\u05DB\u05DD \u05DC\u05E4\u05E0\u05E7 \u05D0\u05D7\u05D3 \u05D0\u05EA \u05D4\u05E9\u05E0\u05D9\u05D9\u05D4 \u05D1\u05DE\u05E9\u05D4\u05D5 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9 \u05D5\u05DE\u05D9\u05E0\u05D9, \u05DB\u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E9\u05D2\u05E8\u05D4.","200 \u20AA","97 \u20AA","\u05DC\u05D0\u05DE\u05D9\u05E6\u05D9\u05DD","\u05D1\u05D0 \u05DC\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D4 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05D9\u05D5\u05D1\u05D9\u05DC \u05D0\u05D5\u05EA\u05E0\u05D5","\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05D1\u05D0\u05D1\u05D7\u05D5\u05DF \u05E7\u05E6\u05E8. \u05DC\u05D0\u05D7\u05E8\u05D9\u05D5 - \u05DE\u05D5\u05DE\u05D7\u05D4 \u05E6\u05DE\u05D5\u05D3 \u05E9\u05DE\u05DC\u05D5\u05D5\u05D4 \u05D0\u05EA\u05DB\u05DD \u05E9\u05D1\u05D5\u05E2 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D1\u05D5\u05E2, \u05DE\u05D5\u05EA\u05D0\u05DD \u05DC\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD, \u05D0\u05D9\u05E9\u05D9 \u05D0\u05D5 \u05D6\u05D5\u05D2\u05D9. \u05E2\u05E8\u05D1 \u05DC\u05E2\u05E8\u05D1 \u05DC\u05D0 \u05E4\u05D5\u05EA\u05E8 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA; \u05DE\u05E2\u05E8\u05DB\u05EA \u05DC\u05D0\u05D5\u05E8\u05DA \u05D6\u05DE\u05DF - \u05DB\u05DF.","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D0\u05D9\u05E9\u05D9 \u00B7 \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D1\u05E0\u05D5\u05D9\u05D4 \u00B7 \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05D1\u05D5\u05E2\u05D9\u05D5\u05EA \u00B7 \u05E6'\u05D0\u05D8","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D0\u05D9\u05D1\u05D3\u05D5 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D1\u05D5\u05E8 \u05D5\u05D4\u05DB\u05D9\u05DE\u05D9\u05D4 \u05D6\u05D4 \u05DC\u05D6\u05D4","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05E4\u05E8\u05E4\u05E8\u05D9\u05DD","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05E2\u05DE\u05D9\u05E7 \u05D0\u05EA \u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05EA\u05DE\u05D9\u05DB\u05D4 \u05E9\u05D1\u05D5\u05E2\u05D9\u05EA \u05E2\u05DD \u05DB\u05DC\u05D9\u05DD \u05DE\u05E2\u05E9\u05D9\u05D9\u05DD","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D6\u05DE\u05D9\u05DF \u05DC\u05D4\u05EA\u05D9\u05D9\u05E2\u05E5 \u05D5\u05DC\u05E9\u05EA\u05E3","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D4\u05E9\u05E7\u05D9\u05E2 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DC\u05D0\u05D5\u05E8\u05DA \u05D6\u05DE\u05DF, \u05DC\u05D0 \u05E8\u05E7 \u05DC\u05E2\u05E8\u05D1 \u05D0\u05D7\u05D3","57 \u20AA","/ \u05E9\u05D1\u05D5\u05E2 \u00B7 \u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC","\u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E1\u05E2","\u05D4\u05E6\u05E2\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF","\u05EA\u05E8\u05D2\u05D9\u05E9\u05D5 \u05E7\u05E8\u05D5\u05D1\u05D9\u05DD \u05E9\u05D5\u05D1.<br></br>\u05D6\u05D4 \u05DE\u05EA\u05D7\u05D9\u05DC \u05D4\u05E2\u05E8\u05D1.","\u05DE\u05E6\u05D8\u05E8\u05E4\u05D9\u05DD \u05DC-500+ \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DB\u05D1\u05E8 \u05E2\u05E9\u05D5 \u05D0\u05EA \u05D4\u05E6\u05E2\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF. \u05D1\u05D7\u05E8\u05D5 \u05D0\u05D9\u05DA \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC:","\u05D4\u05DB\u05D9 \u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9","\u05DC\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E7\u05E8\u05D7, \u05DC\u05D4\u05E0\u05D5\u05EA \u05DE\u05E2\u05E8\u05D1 \u05DE\u05D4\u05E0\u05D4 \u05D9\u05D7\u05D3. \u05E9\u05D0\u05DC\u05D5\u05EA, \u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05D5\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05D9\u05D5\u05E6\u05E8\u05D9\u05DD \u05E9\u05D9\u05D7\u05D4 \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA - \u05DE\u05D4\u05E1\u05DC\u05D5\u05DF, \u05D1\u05DC\u05D9 \u05D4\u05DB\u05E0\u05D4.","\u05DC\u05DE\u05D9 \u05E9\u05DE\u05D5\u05DB\u05DF \u05D5\u05D0\u05D5\u05D4\u05D1 \u05DC\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E9\u05D2\u05E8\u05D4 - \u05D2\u05DD \u05D1\u05E1\u05E7\u05E1. \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E0\u05D5\u05E2\u05D6\u05D9\u05DD \u05E9\u05E2\u05D9\u05E6\u05D1\u05E0\u05D5 \u05E2\u05D1\u05D5\u05E8 \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05DB\u05D9 \u05D4\u05E8\u05E4\u05EA\u05E7\u05E0\u05D9\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5.","\u05D2\u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05DC\u05DC\u05D0 \u05DE\u05D7\u05D5\u05D9\u05D1\u05D5\u05EA","100% \u05D4\u05E0\u05D0\u05D4","\u05DE\u05E2\u05D1\u05E8 \u05DC\u05DE\u05E9\u05D7\u05E7 \u05DB\u05E0\u05D5\u05EA / \u05D0\u05EA\u05D2\u05E8","\u05D9\u05E9 \u05DC\u05DB\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA?<br></br>\u05D9\u05E9 \u05DC\u05E0\u05D5 \u05EA\u05E9\u05D5\u05D1\u05D5\u05EA.","\u05D0\u05E1\u05E4\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05D0\u05D5\u05EA\u05E0\u05D5 \u05D4\u05DB\u05D9 \u05D4\u05E8\u05D1\u05D4. \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05DE\u05E6\u05D0\u05EA\u05DD \u05EA\u05E9\u05D5\u05D1\u05D4?","\u05D3\u05D1\u05E8\u05D5 \u05D0\u05D9\u05EA\u05E0\u05D5","\u05DE\u05D4 \u05D6\u05D4 \u05D1\u05E2\u05E6\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9?","<p>\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D4\u05D9\u05D0 \u05E4\u05DC\u05D8\u05E4\u05D5\u05E8\u05DE\u05D4 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA - \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9, \u05D5\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4. \u05D4\u05E6\u05D5\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05E2\u05D5\u05E1\u05E7 \u05D1\u05D8\u05D9\u05E4\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9, \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D5\u05D9\u05D9\u05E2\u05D5\u05E5. <strong>\u05D4\u05DE\u05D8\u05E8\u05D4 \u05D0\u05D7\u05EA:</strong> \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05E4\u05E8\u05E4\u05E8\u05D9\u05DD \u05E9\u05D7\u05E9\u05D1\u05EA\u05DD \u05E9\u05D0\u05D9\u05D1\u05D3\u05EA\u05DD.</p>","\u05D6\u05D4 \u05EA\u05D7\u05DC\u05D9\u05E3 \u05DC\u05D8\u05D9\u05E4\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9?","<p>\u05DC\u05D0 \u05D1\u05D3\u05D9\u05D5\u05E7. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E4\u05EA\u05E8\u05D5\u05DF \u05DE\u05E7\u05D3\u05D9\u05DD - \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05E9\u05DE\u05E9\u05D4\u05D5 \u05E0\u05E9\u05D7\u05E7, \u05D0\u05D1\u05DC \u05DC\u05D0 \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05E7\u05E4\u05D5\u05E5 \u05DC\u05D8\u05D9\u05E4\u05D5\u05DC. \u05D0\u05DD \u05D9\u05E9 \u05DE\u05E9\u05D1\u05E8\u05D9\u05DD \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD, \u05E0\u05DE\u05DC\u05D9\u05E5 \u05D2\u05DD \u05E2\u05DC \u05DE\u05D8\u05E4\u05DC/\u05EA \u05DE\u05D5\u05E1\u05DE\u05DB/\u05EA, \u05D5\u05D1\u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC\u05D9\u05DD \u05D0\u05E4\u05D9\u05DC\u05D5 \u05E0\u05D7\u05D1\u05E8 \u05D0\u05EA\u05DB\u05DD \u05DC\u05D0\u05D7\u05D3 \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5.</p>","\u05D0\u05D9\u05DA \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3 \u05D1\u05E4\u05D5\u05E2\u05DC?","<p>\u05EA\u05DC\u05D5\u05D9 \u05D1\u05D0\u05D9\u05D6\u05D4 \u05DE\u05E1\u05DC\u05D5\u05DC \u05EA\u05D1\u05D7\u05E8\u05D5. \u05D0\u05DD \u05D6\u05D4 \u05DE\u05E9\u05D7\u05E7 - \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D2\u05D9\u05E9\u05D4 \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF \u05D5\u05E4\u05D5\u05EA\u05D7\u05D9\u05DD \u05D0\u05EA \u05D4\u05E2\u05E8\u05D1 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05D9\u05D7\u05D3. \u05D0\u05DD \u05D6\u05D4 \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D4\u05E6\u05DE\u05D5\u05D3 - \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05D1\u05D0\u05D1\u05D7\u05D5\u05DF \u05E9\u05DC 10 \u05D3\u05E7\u05D5\u05EA, \u05D5\u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA \u05E2\u05DD \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D7\u05D5\u05D3\u05E9\u05D9\u05D5\u05EA. \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05D7\u05D5\u05D3\u05E9 \u05D1\u05D7\u05D5\u05D3\u05E9, \u05DC\u05DC\u05D0 \u05D7\u05D5\u05D6\u05D4 - \u05D5\u05E2\u05D5\u05E6\u05E8\u05D9\u05DD \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 \u05E9\u05EA\u05E8\u05E6\u05D5.</p>","\u05DB\u05DE\u05D4 \u05D6\u05DE\u05DF \u05DC\u05D5\u05E7\u05D7 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05E9\u05D9\u05E0\u05D5\u05D9?","<p>\u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05D3\u05D5\u05D5\u05D7\u05D9\u05DD \u05E2\u05DC \u05E9\u05D9\u05E0\u05D5\u05D9 \u05DB\u05D1\u05E8 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05E2\u05E8\u05D1 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF - \u05D1\u05E2\u05D9\u05E7\u05E8 \u05D1\u05E8\u05DE\u05EA \u05D4\u05E9\u05D9\u05D7\u05D4 \u05D5\u05D4\u05E4\u05EA\u05D9\u05D7\u05D5\u05EA. \u05E9\u05D9\u05E0\u05D5\u05D9 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA\u05D9 \u05D5\u05E7\u05D1\u05D5\u05E2 \u05DC\u05E8\u05D5\u05D1 \u05DE\u05D5\u05E8\u05D2\u05E9 \u05D0\u05D7\u05E8\u05D9 30 \u05D9\u05DE\u05D9\u05DD \u05E9\u05DC \u05E2\u05D1\u05D5\u05D3\u05D4 \u05E8\u05E6\u05D9\u05E4\u05D4. \u05D1\u05E7\u05D9\u05E6\u05D5\u05E8 - \u05DE\u05D4\u05E8 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DE\u05D4 \u05E9\u05D0\u05EA\u05DD \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD.</p>","\u05D4\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05E9\u05DC\u05D9 \u05E9\u05DE\u05D5\u05E8\u05D4?","<p>\u05D1\u05D4\u05D7\u05DC\u05D8. \u05DB\u05DC \u05D4\u05E0\u05EA\u05D5\u05E0\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05DE\u05D5\u05E6\u05E4\u05E0\u05D9\u05DD \u05D5\u05DC\u05D0 \u05DE\u05E9\u05D5\u05EA\u05E4\u05D9\u05DD \u05E2\u05DD \u05D0\u05E3 \u05D0\u05D7\u05D3 - \u05DC\u05E2\u05D5\u05DC\u05DD. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05E8\u05D9\u05DD \u05E0\u05EA\u05D5\u05E0\u05D9\u05DD, \u05D5\u05DC\u05D0 \u05DE\u05E6\u05D9\u05D2\u05D9\u05DD \u05E4\u05E8\u05E1\u05D5\u05DE\u05D5\u05EA. \u05D4\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD - \u05D5\u05D2\u05DD \u05E9\u05DC \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 - \u05E7\u05D3\u05D5\u05E9\u05D4 \u05D0\u05E6\u05DC\u05E0\u05D5.</p>","\u05DE\u05D4 \u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05DF/\u05D4?","<p>\u05D6\u05D4 \u05E0\u05E4\u05D5\u05E5 \u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DE\u05D4 \u05E9\u05E0\u05E8\u05D0\u05D4 \u05DC\u05DB\u05DD. \u05D4\u05D4\u05E6\u05E2\u05D4 \u05E9\u05DC\u05E0\u05D5: \u05D0\u05DC \u05EA\u05E6\u05D9\u05E2\u05D5 \u05DC\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DC\u05D4\u05D9\u05E8\u05E9\u05DD \u05DC\u05DC\u05D9\u05D5\u05D5\u05D9 - \u05D4\u05E6\u05D9\u05E2\u05D5 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05DE\u05E9\u05D7\u05E7. \u05E2\u05E8\u05D1 \u05D0\u05D7\u05D3, \u05D1\u05DC\u05D9 \u05E9\u05D5\u05DD \u05E9\u05DD \u05E8\u05E9\u05DE\u05D9. \u05E8\u05D5\u05D1 \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05DB\u05DB\u05D4 \u05DE\u05D5\u05E6\u05D0\u05D9\u05DD \u05D0\u05EA \u05E2\u05E6\u05DE\u05DD \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05D9\u05D7\u05D3.</p>","\u05DE\u05D4 \u05D4\u05D4\u05D1\u05D3\u05DC \u05D1\u05D9\u05DF \u05E9\u05DC\u05D5\u05E9\u05EA \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC\u05D9\u05DD?","<p><strong>\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF:</strong> \u05E4\u05EA\u05D9\u05D7\u05D4 \u05E7\u05DC\u05D4, \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05E4\u05DC\u05D8\u05E4\u05D5\u05E8\u05DE\u05D4, \u05DE\u05E0\u05D5\u05D9 \u05D7\u05D5\u05D3\u05E9\u05D9 \u05D2\u05DE\u05D9\u05E9. <strong>\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E6\u05DE\u05D5\u05D3 \u05E2\u05DD \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD:</strong> \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05DB\u05D9 \u05DE\u05E7\u05D9\u05E3 \u05E9\u05DC\u05E0\u05D5 - <em>\u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC</em>: \u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD (\u05DB\u05D5\u05DC\u05DC \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9), \u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9, \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05DE\u05D5\u05EA\u05D0\u05DE\u05EA, \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D7\u05D5\u05D3\u05E9\u05D9\u05D5\u05EA, \u05D5\u05DE\u05E2\u05E0\u05D4 \u05D0\u05D9\u05E9\u05D9 \u05DE\u05D4\u05E6\u05D5\u05D5\u05EA. <strong>\u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9:</strong> \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D0\u05E7\u05E1\u05E7\u05DC\u05D5\u05E1\u05D9\u05D1\u05D9\u05D9\u05DD \u05DC\u05D7\u05D3\u05E8 \u05D4\u05DE\u05D9\u05D8\u05D5\u05EA, \u05E8\u05DB\u05D9\u05E9\u05D4 \u05E0\u05E4\u05E8\u05D3\u05EA \u05DC\u05E4\u05D9 \u05DE\u05E9\u05D7\u05E7. \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E9\u05DC\u05D1 - \u05D5\u05E8\u05D1\u05D9\u05DD \u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05EA \u05D6\u05D4.</p>","\"\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E6\u05DE\u05D5\u05D3 \u05E2\u05DD \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD\" - \u05D1\u05D0\u05DE\u05EA \u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC?","<p>\u05DB\u05DF, \u05D1\u05D0\u05DE\u05EA. \u05D1\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05D6\u05D4 <strong>\u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC \u05D1\u05DE\u05E0\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05D0\u05D7\u05D3</strong>: \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05E4\u05DC\u05D8\u05E4\u05D5\u05E8\u05DE\u05D4 (\u05DB\u05D5\u05DC\u05DC \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9), \u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC 10 \u05D3\u05E7\u05D5\u05EA \u05E2\u05DD \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D6\u05D5\u05D2\u05D9, \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05DE\u05D5\u05EA\u05D0\u05DE\u05EA, \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D7\u05D5\u05D3\u05E9\u05D9\u05D5\u05EA, \u05D5\u05DE\u05E2\u05E0\u05D4 \u05D9\u05E9\u05D9\u05E8 \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD \u05D1\u05E6'\u05D0\u05D8. \u05D1\u05DC\u05D9 \u05EA\u05D5\u05E1\u05E4\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05E4\u05EA\u05E2\u05D5\u05EA \u05D1\u05D7\u05E9\u05D1\u05D5\u05DF. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E8\u05D5\u05E6\u05D9\u05DD \u05E9\u05EA\u05EA\u05E8\u05DB\u05D6\u05D5 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA - \u05DC\u05D0 \u05D1\u05DC\u05D1\u05E8\u05E8 \u05DE\u05D4 \u05D6\u05D4 \u05DB\u05D5\u05DC\u05DC.</p>","\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D1\u05D8\u05DC \u05D1\u05DB\u05DC \u05E9\u05DC\u05D1?","<p>\u05D1\u05D4\u05D7\u05DC\u05D8. \u05D0\u05D9\u05DF \u05DE\u05D7\u05D5\u05D9\u05D1\u05D5\u05EA, \u05D5\u05D0\u05D9\u05DF \u05E7\u05E0\u05E1\u05D5\u05EA. \u05D1\u05D9\u05D8\u05D5\u05DC \u05E0\u05E2\u05E9\u05D4 \u05D1\u05DC\u05D7\u05D9\u05E6\u05EA \u05DB\u05E4\u05EA\u05D5\u05E8 \u05D1\u05D0\u05D6\u05D5\u05E8 \u05D4\u05D0\u05D9\u05E9\u05D9, \u05D0\u05D5 \u05D1\u05E4\u05E0\u05D9\u05D9\u05D4 \u05DC\u05EA\u05DE\u05D9\u05DB\u05D4. \u05D1\u05DC\u05D9 \u05E9\u05D0\u05DC\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D1\u05E2\u05D9\u05D5\u05EA.</p>","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E0\u05E9\u05D5\u05D0\u05D9\u05DD - \u05D6\u05D4 \u05E2\u05D3\u05D9\u05D9\u05DF \u05DE\u05EA\u05D0\u05D9\u05DD?","<p>\u05D1\u05D5\u05D5\u05D3\u05D0\u05D9. \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DC \u05D6\u05D5\u05D2 \u05D1\u05E7\u05E9\u05E8 \u05E8\u05D5\u05DE\u05E0\u05D8\u05D9 - \u05E0\u05E9\u05D5\u05D0\u05D9\u05DD, \u05D1\u05E0\u05D9 \u05D6\u05D5\u05D2, \u05DE\u05D0\u05D5\u05E8\u05E1\u05D9\u05DD. \u05D4\u05E7\u05E8\u05D9\u05D8\u05E8\u05D9\u05D5\u05DF \u05D4\u05D9\u05D7\u05D9\u05D3 \u05D4\u05D5\u05D0 \u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05E2\u05DE\u05D9\u05E7 \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8.</p>","\u05DC\u05DE\u05D9 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05EA\u05D5\u05DB\u05DF \u05DE\u05EA\u05D0\u05D9\u05DD?","<p>\u05E0\u05DB\u05D5\u05DF \u05DC\u05D4\u05D9\u05D5\u05DD, \u05D4\u05EA\u05D5\u05DB\u05DF \u05D5\u05D4\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05DE\u05D5\u05EA\u05D0\u05DE\u05D9\u05DD \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05D8\u05E8\u05D5\u05E1\u05E7\u05E1\u05D5\u05D0\u05DC\u05D9\u05D9\u05DD - \u05D2\u05D1\u05E8 \u05D5\u05D0\u05D9\u05E9\u05D4. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05D5\u05D1\u05D3\u05D9\u05DD \u05E2\u05DC \u05D4\u05E8\u05D7\u05D1\u05EA \u05D4\u05EA\u05D5\u05DB\u05DF \u05DC\u05DB\u05DC \u05E1\u05D5\u05D2\u05D9 \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05D5\u05DE\u05E7\u05D5\u05D5\u05D9\u05DD \u05DC\u05D4\u05E6\u05D9\u05D2 \u05E2\u05D3\u05DB\u05D5\u05DF \u05D1\u05EA\u05E7\u05D5\u05E4\u05D4 \u05D4\u05E7\u05E8\u05D5\u05D1\u05D4.</p>","\u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05E1\u05E4\u05E8\u05D9\u05DD","\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05DE\u05E9\u05EA\u05E4\u05D9\u05DD","\u05D8\u05E2\u05DF \u05E2\u05D5\u05D3 \u05D4\u05DE\u05DC\u05E6\u05D5\u05EA","\"\u05D0\u05D6 \u05E7\u05E0\u05D9\u05EA\u05D9 \u05D0\u05EA '52 \u05D3\u05E8\u05DB\u05D9\u05DD \u05DC\u05D4\u05E1\u05E2\u05D9\u05E8 \u05D0\u05D5\u05EA\u05DA' \u05DB\u05DE\u05EA\u05E0\u05D4 \u05DC\u05D9\u05D5\u05DD \u05D4\u05D4\u05D5\u05DC\u05D3\u05EA \u05E9\u05DC \u05D1\u05E2\u05DC\u05D9, \u05DB\u05D9 \u05E8\u05E6\u05D9\u05EA\u05D9 \u05DC\u05D2\u05D5\u05D5\u05DF \u05D5\u05DC\u05D4\u05E4\u05EA\u05D9\u05E2. \u05D1\u05DC\u05D9 \u05E6\u05D9\u05E4\u05D9\u05D5\u05EA \u05D2\u05D1\u05D5\u05D4\u05D5\u05EA, \u05E2\u05DD \u05DB\u05DE\u05D4 \u05D3\u05E8\u05D9\u05E0\u05E7\u05D9\u05DD, \u05D4\u05E2\u05D1\u05E8\u05E0\u05D5 \u05E2\u05E8\u05D1 \u05DE\u05D4\u05DE\u05DD. \u05D0\u05D7\u05DC\u05D4 \u05DE\u05E9\u05D7\u05E7 - \u05DE\u05DE\u05DC\u05D9\u05E6\u05D4.\"","\u05E9\u05D9\u05E8\u05D4 \u05DC\u05D5\u05D9","11 \u05E9\u05E0\u05D9\u05DD \u05D9\u05D7\u05D3","\"\u05D1\u05E2\u05D1\u05E8 \u05E0\u05D9\u05E1\u05D9\u05E0\u05D5 \u05D8\u05D9\u05E4\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9 - \u05D6\u05D4 \u05E2\u05D6\u05E8 \u05DC\u05E8\u05D2\u05E2, \u05D0\u05D1\u05DC \u05D4\u05D9\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05DB\u05D1\u05D3 \u05D1\u05DB\u05DC \u05D4\u05DE\u05E4\u05D2\u05E9\u05D9\u05DD. \u05DE\u05D4\u05E8\u05D2\u05E2 \u05E9\u05D4\u05E6\u05D8\u05E8\u05E4\u05E0\u05D5 \u05DC\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9, \u05D4\u05DB\u05DC \u05E0\u05E2\u05E9\u05D4 \u05E7\u05DC - \u05D4\u05E9\u05D9\u05EA\u05D5\u05E3 \u05D5\u05D4\u05EA\u05D7\u05D6\u05D5\u05E7\u05D4 \u05E9\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D4\u05E4\u05DB\u05D5 \u05DC\u05DB\u05D9\u05E3. \u05DE\u05DE\u05DC\u05D9\u05E6\u05D4 \u05D1\u05D7\u05D5\u05DD...\"","\u05D3\u05E0\u05D9\u05D0\u05DC \u05E7.","\u05E0\u05E9\u05D5\u05D0\u05D9\u05DD 13 \u05E9\u05E0\u05D9\u05DD","\"\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05E7\u05D5\u05D7\u05D5\u05EA 4 \u05E9\u05E0\u05D9\u05DD. \u05DB\u05DC \u05E4\u05E2\u05DD \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D5\u05DE\u05E8\u05EA \u05DC\u05D9\u05D5\u05D1\u05DC '\u05D0\u05D5\u05DC\u05D9 \u05E0\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9?' \u05D9\u05D5\u05E6\u05D0 \u05DE\u05E9\u05D4\u05D5 \u05D7\u05D3\u05E9. \u05E2\u05E8\u05DB\u05D4 \u05D7\u05D3\u05E9\u05D4, \u05D0\u05EA\u05D2\u05E8 \u05D7\u05D3\u05E9, \u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC\u05D0 \u05D4\u05DB\u05E8\u05E0\u05D5. \u05D4\u05DD \u05E4\u05E9\u05D5\u05D8 \u05DC\u05D0 \u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05E0\u05D5 \u05DC\u05D4\u05EA\u05E2\u05D9\u05D9\u05E3 \u05D0\u05D7\u05D3 \u05DE\u05D4\u05E9\u05E0\u05D9\u05D9\u05D4. \u05D0\u05D7\u05E8\u05D9 16 \u05E9\u05E0\u05D4.\"","\u05E8\u05D5\u05E0\u05D9 \u05D5\u05D9\u05D5\u05D1\u05DC","\u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA 16 \u05E9\u05E0\u05D9\u05DD","\"\u05D0\u05D2\u05D9\u05D3 \u05D0\u05EA \u05D6\u05D4 \u05DB\u05DB\u05D4 - \u05D4\u05D9\u05D5\u05DD \u05D6\u05D5 \u05D4\u05E9\u05D9\u05D7\u05D4 \u05D4\u05E7\u05D1\u05D5\u05E2\u05D4 \u05E9\u05DC \u05D9\u05D5\u05DD \u05E9\u05E0\u05D9 \u05D1\u05E2\u05E8\u05D1 \u05D0\u05E6\u05DC\u05E0\u05D5: '\u05DE\u05D4 \u05D4\u05DE\u05E9\u05D9\u05DE\u05D4 \u05D4\u05E4\u05E2\u05DD?'. \u05E2\u05D9\u05D3\u05DF \u05E8\u05E5 \u05DC\u05D1\u05D3\u05D5\u05E7 \u05DE\u05D4 \u05D9\u05E9 \u05D1\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05E4\u05E0\u05D9. \u05D3\u05D1\u05E8 \u05E9\u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05D9\u05DB\u05D5\u05DC \u05DC\u05E7\u05E8\u05D5\u05EA \u05D0\u05E6\u05DC\u05E0\u05D5.\"","\u05DE\u05D9\u05DB\u05DC \u05D5\u05E2\u05D9\u05D3\u05DF","\u05E0\u05E9\u05D5\u05D0\u05D9\u05DD 8 \u05E9\u05E0\u05D9\u05DD","\"\u05DC\u05E7\u05D7\u05EA\u05D9 \u05D0\u05EA \u05D1\u05E2\u05DC\u05D9 \u05DC\u05DE\u05DC\u05D5\u05DF \u05DC\u05D9\u05D5\u05DD \u05D4\u05D5\u05DC\u05D3\u05EA, \u05D5\u05E4\u05EA\u05D0\u05D5\u05DD \u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05D0\u05D9\u05DF \u05DC\u05E0\u05D5 \u05DE\u05DE\u05E9 \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05DC\u05E2\u05E8\u05D1. \u05D4\u05D5\u05E8\u05D3\u05EA\u05D9 \u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9, \u05D5\u05D6\u05D4 \u05D4\u05E6\u05D9\u05DC \u05D0\u05EA \u05D4\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4. \u05E6\u05D7\u05E7\u05E0\u05D5, \u05E9\u05EA\u05D9\u05E0\u05D5, \u05D5\u05D3\u05D9\u05D1\u05E8\u05E0\u05D5 \u05E2\u05DC \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DC\u05D0 \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5 \u05E2\u05DC\u05D9\u05D4\u05DD \u05D1\u05D7\u05D9\u05D9\u05DD. \u05D4\u05D5\u05D0 \u05E2\u05D5\u05D3 \u05DE\u05D3\u05D1\u05E8 \u05E2\u05DC \u05D4\u05E2\u05E8\u05D1 \u05D4\u05D6\u05D4.\"","\u05E2\u05D9\u05E0\u05EA \u05D1\u05E8\u05D5\u05DA","\u05E0\u05E9\u05D5\u05D0\u05D4 9 \u05E9\u05E0\u05D9\u05DD","\"\u05D1\u05D9\u05D5\u05DD \u05D4\u05D0\u05D4\u05D1\u05D4 \u05DB\u05DC \u05D4\u05DE\u05E1\u05E2\u05D3\u05D5\u05EA \u05D4\u05D9\u05D5 \u05DE\u05DC\u05D0\u05D5\u05EA, \u05D0\u05D6 \u05D1\u05DE\u05E7\u05D5\u05DD \u05DC\u05E6\u05D0\u05EA - \u05D4\u05D5\u05E8\u05D3\u05E0\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D1\u05D1\u05D9\u05EA. \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05E2\u05E8\u05D1 \u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05D8\u05D5\u05D1 \u05DE\u05DB\u05DC \u05DE\u05E1\u05E2\u05D3\u05D4 \u05E9\u05D4\u05D9\u05D9\u05E0\u05D5 \u05D1\u05D4 \u05D4\u05E9\u05E0\u05D4. \u05E8\u05E6\u05D9\u05E0\u05D9\u05EA.\"","\u05D8\u05DC \u05D5\u05E2\u05D5\u05DE\u05E8\u05D9","\u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA 6 \u05E9\u05E0\u05D9\u05DD","\u05D0\u05D1\u05D7\u05D5\u05DF \u05E9\u05DC 5 \u05D3\u05E7\u05D5\u05EA","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E6\u05DE\u05D5\u05D3","\u05DC\u05DC\u05D0 \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D0\u05E9\u05E8\u05D0\u05D9","\u05DC\u05DE\u05D4 \u05D4\u05DE\u05E1\u05E2 \u05D4\u05D6\u05D4","\u05DC\u05D0 \u05E2\u05D5\u05D3 \u05E2\u05E6\u05D5\u05EA \u05DB\u05DC\u05DC\u05D9\u05D5\u05EA. \u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05E0\u05D1\u05E0\u05D4 \u05E1\u05D1\u05D9\u05D1\u05DB\u05DD.","\u05E9\u05DC\u05D5\u05E9\u05D4 \u05E6\u05E2\u05D3\u05D9\u05DD \u05E2\u05D3 \u05DC\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DC\u05DB\u05DD","\u05DE\u05D4 \u05D1\u05E4\u05E0\u05D9\u05DD","\u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05E7\u05D8\u05E0\u05D9\u05DD \u05E9\u05DE\u05E9\u05E0\u05D9\u05DD \u05D4\u05E8\u05D1\u05D4","\u05D4\u05D0\u05D1\u05D7\u05D5\u05DF \u05D7\u05D9\u05E0\u05DD. \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05DE\u05EA\u05D7\u05D9\u05DC \u05DB\u05E9\u05EA\u05D3\u05E2\u05D5 \u05E9\u05D0\u05EA\u05DD \u05D1\u05E4\u05E0\u05D9\u05DD.","5 \u05D3\u05E7\u05D5\u05EA, \u05D0\u05D1\u05D7\u05D5\u05DF \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9, \u05D5\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA \u05DE\u05D7\u05DB\u05D4 \u05DC\u05DB\u05DD. \u05D0\u05D9\u05DF \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA, \u05D0\u05D9\u05DF \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D0\u05E9\u05E8\u05D0\u05D9 - \u05E8\u05E7 \u05DB\u05D9\u05D5\u05D5\u05DF.","\u05DC\u05DE\u05D9 \u05D6\u05D4 \u05DE\u05D5\u05DE\u05DC\u05E5","\u05D4\u05D0\u05DD \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D4\u05D6\u05D4 \u05DC\u05DB\u05DD?","\u05D4\u05D5\u05D0 \u05DC\u05D0 \u05DC\u05DB\u05DC \u05D0\u05D7\u05D3, \u05D5\u05D1\u05DB\u05D5\u05D5\u05E0\u05D4. \u05D4\u05D5\u05D0 \u05D1\u05E0\u05D5\u05D9 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05E9\u05DE\u05E9\u05D4\u05D5 \u05D7\u05E1\u05E8 \u05D5\u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05E9\u05D4\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E2\u05E9\u05D5\u05EA \u05E2\u05D1\u05D5\u05D3\u05D4 \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA.","\u05E9\u05D0\u05DC\u05EA\u05DD, \u05E2\u05E0\u05D9\u05E0\u05D5","\u05D4\u05DE\u05E1\u05E2","\u2014 \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD.","\u05DE\u05D2\u05D9\u05E2 \u05DC\u05DB\u05DD \u05DC\u05D9\u05D5\u05D5\u05D9 \u05E9\u05E0\u05D1\u05E0\u05D4 \u05D1\u05DE\u05D9\u05D5\u05D7\u05D3 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u2014 \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD, \u05D0\u05D1\u05D7\u05D5\u05DF, \u05E9\u05D9\u05D7\u05D5\u05EA, \u05D5\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05D7\u05D5\u05D3\u05E9\u05D9\u05D5\u05EA \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5. \u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC \u05D1\u05DE\u05E0\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05D0\u05D7\u05D3.","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E8\u05D5\u05E6\u05D9\u05DD \u05E9\u05EA\u05E4\u05E1\u05E4\u05E1\u05D5 \u05D0\u05EA \u05D6\u05D4.","\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DC\u05DB\u05DD","5 \u05D3\u05E7\u05D5\u05EA"," \u05DE\u05E4\u05E8\u05D9\u05D3\u05D5\u05EA \u05D0\u05EA\u05DB\u05DD","\u05DE\u05DE\u05E1\u05DC\u05D5\u05DC \u05D0\u05D9\u05E9\u05D9 ","\u05E9\u05E0\u05DB\u05EA\u05D1 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DC\u05DB\u05DD","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05D7\u05D9\u05E0\u05DD - \u05D1\u05DC\u05D9 \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D0\u05E9\u05E8\u05D0\u05D9.","\u05D4\u05D0\u05D1\u05D7\u05D5\u05DF \u05E4\u05EA\u05D5\u05D7 \u05DC\u05DB\u05D5\u05DC\u05DD","\u05D9\u05E9 \u05DC\u05DB\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05E2\u05DC \u05D4\u05DE\u05E1\u05E2?","\u05D9\u05E9 \u05DC\u05E0\u05D5 \u05EA\u05E9\u05D5\u05D1\u05D5\u05EA.","\u05D0\u05E1\u05E4\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05D0\u05D5\u05EA\u05E0\u05D5 \u05E2\u05DC \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF, \u05E2\u05DC \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D5\u05E2\u05DC \u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4 \u05D0\u05D7\u05E8\u05D9. \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05DE\u05E6\u05D0\u05EA\u05DD \u05EA\u05E9\u05D5\u05D1\u05D4?","\u05D4\u05DE\u05E1\u05E4\u05E8\u05D9\u05DD","\u05DB\u05D1\u05E8 "," \u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05E8\u05D7\u05D1\u05D9 \u05D4\u05E2\u05D5\u05DC\u05DD","\u05E9\u05D9\u05D7\u05E7\u05D5 \u05D1","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D1\u05E7\u05DC\u05D9\u05E7 \u05D0\u05D7\u05D3 \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05DC\u05E9\u05D7\u05E7 \u05E2\u05DB\u05E9\u05D9\u05D5","\u05DC\u05DE\u05D9","\u05D0\u05D9\u05DF \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DE\u05E9\u05E2\u05DE\u05DE\u05EA.","\u05E8\u05E7 \u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC\u05D0 \u05E0\u05E9\u05D0\u05DC\u05D5.","\u05D1\u05DB\u05DC \u05E9\u05DC\u05D1 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DE\u05D7\u05DB\u05D5\u05EA \u05E9\u05D0\u05DC\u05D5\u05EA. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E8\u05E7 \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05DE\u05EA\u05D9 \u05DC\u05E9\u05D0\u05D5\u05DC \u05D0\u05D5\u05EA\u05DF.","\u05DC\u05DE\u05D4 \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3","\u05E9\u05D0\u05DC\u05D4 \u05D0\u05D7\u05EA.","\u05E2\u05E8\u05D1 \u05E9\u05DC\u05DD \u05D0\u05D7\u05E8.","\u05DC\u05D0 \u05D8\u05D9\u05E4\u05D5\u05DC. \u05DC\u05D0 \u05E7\u05D5\u05E8\u05E1. \u05DC\u05D0 '\u05DB\u05DC\u05D9\u05DD \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA'. \u05DE\u05E9\u05D7\u05E7. \u05D0\u05D1\u05DC \u05D0\u05D7\u05D3 \u05E9\u05E2\u05D5\u05D1\u05D3.","- \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05E9\u05D9\u05E0\u05D5\u05D9 \u05DC\u05D0 \u05D3\u05D5\u05E8\u05E9 \u05DE\u05D4\u05E4\u05DB\u05D4. \u05E8\u05E7 \u05D4\u05EA\u05D7\u05DC\u05D4.","\u05DE\u05D4 \u05E9\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD.","\u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D4\u05D7\u05D5\u05D6\u05E8\u05D5\u05EA \u05E2\u05DC \u05DE\u05E9\u05D7\u05E7\u05D9 \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05D0\u05D9\u05DA \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3, \u05DC\u05DE\u05D9 \u05D6\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD, \u05D5\u05DB\u05DE\u05D4 \u05D6\u05D4 \u05E2\u05D5\u05DC\u05D4. \u05D0\u05DD \u05DC\u05D0 \u05E2\u05E0\u05D9\u05E0\u05D5 \u05E2\u05DC \u05E9\u05D0\u05DC\u05D4 \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9\u05EA - \u05D3\u05D1\u05E8\u05D5 \u05D0\u05D9\u05EA\u05E0\u05D5.","<p>\u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DE\u05E9\u05D7\u05E7 \u05D1\u05D0\u05EA\u05E8, \u05E4\u05D5\u05EA\u05D7\u05D9\u05DD \u05E2\u05DC \u05D4\u05D8\u05DC\u05E4\u05D5\u05DF, \u05D5\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD. \u05D4\u05DB\u05DC \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF - \u05D1\u05DC\u05D9 \u05D4\u05D5\u05E8\u05D3\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05EA\u05E7\u05E0\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05E8\u05E9\u05DE\u05D4 \u05DE\u05E1\u05D5\u05D1\u05DB\u05EA. \u05EA\u05D5\u05DA 30 \u05E9\u05E0\u05D9\u05D5\u05EA \u05D0\u05EA\u05DD \u05DB\u05D1\u05E8 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD.</p>","\u05E6\u05E8\u05D9\u05DA \u05E9\u05E0\u05D9 \u05D8\u05DC\u05E4\u05D5\u05E0\u05D9\u05DD \u05D0\u05D5 \u05D0\u05D7\u05D3?","<p>\u05DE\u05E1\u05E4\u05D9\u05E7 \u05D8\u05DC\u05E4\u05D5\u05DF \u05D0\u05D7\u05D3. \u05D0\u05EA\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D0\u05D7\u05D3 \u05DE\u05D5\u05DC \u05D4\u05E9\u05E0\u05D9 - \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E2\u05D5\u05D1\u05E8\u05D5\u05EA \u05D1\u05D9\u05E0\u05D9\u05DB\u05DD \u05D1\u05EA\u05D5\u05E8\u05D5\u05EA, \u05D0\u05D5 \u05E2\u05DC \u05DE\u05E1\u05DA \u05DE\u05E9\u05D5\u05EA\u05E3. \u05D2\u05DD \u05D1\u05E1\u05DC\u05D5\u05DF. \u05D2\u05DD \u05D1\u05DE\u05D9\u05D8\u05D4. \u05D2\u05DD \u05D1\u05E8\u05DB\u05D1, \u05D0\u05DD \u05E0\u05E1\u05E2\u05EA\u05DD \u05DC\u05D7\u05D5\u05E4\u05E9\u05D4.</p>","\u05D4\u05D0\u05DD \u05D6\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E2\u05DD \u05D5\u05D5\u05EA\u05E7 \u05D0\u05D5 \u05E8\u05E7 \u05DC\u05D7\u05D3\u05E9\u05D9\u05DD?","<p>\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D1\u05E0\u05D5\u05D9 \u05D1\u05E2\u05D9\u05E7\u05E8 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E2\u05DD \u05E9\u05E0\u05D9\u05DD \u05E9\u05DC \u05D4\u05D9\u05DB\u05E8\u05D5\u05EA - \u05DE\u05E7\u05D5\u05DD \u05E9\u05D1\u05D5 \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D4\u05E7\u05DC\u05D5\u05EA \u05DB\u05D1\u05E8 \u05E0\u05E9\u05D0\u05DC\u05D5, \u05D5\u05D9\u05E9 \u05DE\u05D4 \u05DC\u05D2\u05DC\u05D5\u05EA \u05DE\u05D7\u05D3\u05E9. \u05D0\u05D1\u05DC \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3 \u05D2\u05DD \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E6\u05E2\u05D9\u05E8\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05E2\u05DE\u05D9\u05E7 \u05DB\u05D1\u05E8 \u05E2\u05DB\u05E9\u05D9\u05D5.</p>","\u05DB\u05DE\u05D4 \u05D6\u05DE\u05DF \u05DC\u05D5\u05E7\u05D7 \u05DC\u05E9\u05D7\u05E7?","<p>\u05EA\u05DC\u05D5\u05D9 \u05D1\u05DB\u05DD. \u05D9\u05E9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05E1\u05D9\u05D9\u05DE\u05D9\u05DD \u05E1\u05D1\u05D1 \u05D1-20 \u05D3\u05E7\u05D5\u05EA. \u05D9\u05E9 \u05DB\u05D0\u05DC\u05D4 \u05E9\u05E9\u05D0\u05DC\u05D4 \u05D0\u05D7\u05EA \u05E4\u05D5\u05EA\u05D7\u05EA \u05E9\u05D9\u05D7\u05D4 \u05E9\u05DC \u05E9\u05E2\u05EA\u05D9\u05D9\u05DD. \u05D0\u05D9\u05DF \u05DB\u05DC\u05DC\u05D9\u05DD - \u05EA\u05E4\u05E1\u05D9\u05E7\u05D5 \u05DB\u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD, \u05EA\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DB\u05E9\u05D1\u05D0 \u05DC\u05DB\u05DD.</p>","\u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D5\u05DC\u05D2\u05E8\u05D9\u05D5\u05EA \u05D0\u05D5 \u05DE\u05D1\u05D9\u05DB\u05D5\u05EA?","<p>\u05DC\u05D0. \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05E0\u05D5\u05D2\u05E2\u05D5\u05EA, \u05E1\u05E7\u05E8\u05E0\u05D9\u05D5\u05EA, \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05E0\u05D5\u05E2\u05D6\u05D5\u05EA - \u05D0\u05D1\u05DC \u05EA\u05DE\u05D9\u05D3 \u05DE\u05DB\u05D1\u05D3\u05D5\u05EA. \u05DB\u05EA\u05D1\u05D5 \u05D0\u05D5\u05EA\u05DF \u05DE\u05D5\u05DE\u05D7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05DC\u05D0 \u05D9\u05D5\u05E6\u05E8\u05D9 \u05EA\u05D5\u05DB\u05DF. \u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05E9\u05D7\u05E7 \u05D1\u05DC\u05D9 \u05DC\u05D7\u05E9\u05D5\u05E9 \u05E9\u05EA\u05D9\u05EA\u05E7\u05DC\u05D5 \u05D1\u05DE\u05E9\u05D4\u05D5 \u05E9\u05D9\u05E4\u05D2\u05E2 \u05D1\u05DE\u05D9\u05E9\u05D4\u05D5 \u05DE\u05DB\u05DD.</p>","\u05DE\u05D4 \u05D0\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05DF/\u05D4?","<p>\u05D0\u05DC \u05EA\u05E6\u05D9\u05D2\u05D5 \u05D0\u05EA \u05D6\u05D4 \u05DB&quot;\u05EA\u05D9\u05E7\u05D5\u05DF&quot; \u05D0\u05D5 &quot;\u05D8\u05D9\u05E4\u05D5\u05DC&quot;. \u05E4\u05E9\u05D5\u05D8 \u05EA\u05D2\u05D9\u05D3\u05D5 &quot;\u05D1\u05D0 \u05DC\u05D9 \u05DC\u05E0\u05E1\u05D5\u05EA \u05DE\u05E9\u05D7\u05E7 \u05D7\u05D3\u05E9 \u05D0\u05D9\u05EA\u05DA \u05D4\u05E2\u05E8\u05D1&quot;. \u05E8\u05D5\u05D1 \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05DB\u05DB\u05D4 - \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD \u05D1\u05DB\u05D9\u05E3. \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DE\u05D5\u05DB\u05D9\u05D7 \u05D0\u05EA \u05E2\u05E6\u05DE\u05D5 \u05D1\u05E9\u05D0\u05DC\u05D4 \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4.</p>","\u05E2\u05D3 \u05DB\u05DE\u05D4 \u05D6\u05D4 \u05E4\u05E8\u05D8\u05D9? \u05D4\u05D0\u05DD \u05D4\u05E0\u05EA\u05D5\u05E0\u05D9\u05DD \u05E0\u05E9\u05DE\u05E8\u05D9\u05DD?","<p>\u05D4\u05DB\u05DC \u05E4\u05E8\u05D8\u05D9 \u05DC\u05D7\u05DC\u05D5\u05D8\u05D9\u05DF. \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E0\u05E9\u05D0\u05E8\u05D5\u05EA \u05D1\u05D9\u05E0\u05DB\u05DD - \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA, \u05DC\u05D0 \u05E9\u05D5\u05DE\u05E8\u05D9\u05DD \u05D0\u05D5\u05EA\u05DF, \u05DC\u05D0 \u05DE\u05E9\u05EA\u05E4\u05D9\u05DD \u05D0\u05D5\u05EA\u05DF \u05E2\u05DD \u05D0\u05E3 \u05D0\u05D7\u05D3. \u05D4\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05E7\u05D3\u05D5\u05E9\u05D4.</p>","\u05DB\u05DE\u05D4 \u05D6\u05D4 \u05E2\u05D5\u05DC\u05D4?","<p>\u05D4\u05EA\u05E0\u05E1\u05D5\u05EA - \u05D7\u05D9\u05E0\u05DE\u05D9\u05EA, \u05D1\u05DC\u05D9 \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D0\u05E9\u05E8\u05D0\u05D9. \u05D0\u05D7\u05E8 \u05DB\u05DA \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05DB\u05D5\u05E9 \u05DE\u05E0\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05E2\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD &quot;\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF&quot;. \u05D1\u05DC\u05D9 \u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05E7\u05E0\u05E1\u05D5\u05EA - \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D1\u05DC\u05D7\u05D9\u05E6\u05EA \u05DB\u05E4\u05EA\u05D5\u05E8.</p>","\u05E2\u05E5","\u05E4\u05DC\u05D9","\u05D4\u05D8\u05DC\u05EA \u05DE\u05D8\u05D1\u05E2","\u05E2\u05E5 = +3 \u05E6\u05E2\u05D3\u05D9\u05DD (\u05D1\u05E8\u05D9\u05E8\u05EA \u05DE\u05D7\u05D3\u05DC)","\u05E4\u05DC\u05D9 = +1 \u05E6\u05E2\u05D3 (\u05D1\u05E8\u05D9\u05E8\u05EA \u05DE\u05D7\u05D3\u05DC)","\u05E8\u05E7 \u05D4\u05E9\u05D7\u05E7\u05DF \u05D1\u05EA\u05D5\u05E8 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D8\u05D9\u05DC","\u05D0\u05D9\u05DF \u05DC\u05D5\u05D2 \u05E2\u05D3\u05D9\u05D9\u05DF\u2026","\u05E9\u05D1\u05D5\u05E2\u05D9","\u05D7\u05D5\u05D3\u05E9\u05D9","\u05E9\u05E0\u05EA\u05D9","\u05E4\u05E8\u05D8\u05D9 \u05D4\u05D7\u05D1\u05E8\u05D4","\u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE","\u05D7.\u05E4. 515960508","\u05D0\u05D3\u05E8 9, \u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF\u05BE\u05DE\u05DB\u05D1\u05D9\u05DD\u05BE\u05E8\u05E2\u05D5\u05EA 7176346","mioshyoffice@gmail.com","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D4\u05D5\u05D0 \u05DE\u05D5\u05EA\u05D2 \u05D1\u05D1\u05E2\u05DC\u05D5\u05EA \u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE. \u05DC\u05DB\u05DC \u05E4\u05E0\u05D9\u05D9\u05D4 \u05DE\u05E9\u05E4\u05D8\u05D9\u05EA, \u05E4\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D9\u05DC \u05DC\u05DB\u05EA\u05D5\u05D1\u05EA \u05DC\u05E2\u05D9\u05DC.","\u05EA\u05E0\u05D0\u05D9 \u05E9\u05D9\u05DE\u05D5\u05E9 \u00B7 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05EA\u05E0\u05D0\u05D9 \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u2013 \u05DE\u05D5\u05EA\u05D2 \u05D1\u05D1\u05E2\u05DC\u05D5\u05EA \u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE. \u05DB\u05E4\u05D5\u05E3 \u05DC\u05D3\u05D9\u05E0\u05D9 \u05DE\u05D3\u05D9\u05E0\u05EA \u05D9\u05E9\u05E8\u05D0\u05DC.","06.05.2026","\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD \u00B7 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DB\u05DC \u05D4\u05DE\u05DB\u05D9\u05E8\u05D5\u05EA \u05E1\u05D5\u05E4\u05D9\u05D5\u05EA. \u05D4\u05E1\u05D1\u05E8 \u05DE\u05DC\u05D0 \u05E2\u05DC \u05D0\u05D5\u05E4\u05DF \u05D4\u05D1\u05D9\u05D8\u05D5\u05DC \u05D5\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05D4\u05E6\u05E8\u05DB\u05DF \u05D4\u05D9\u05E9\u05E8\u05D0\u05DC\u05D9.","\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD","\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u00B7 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D0\u05D9\u05D6\u05D4 \u05DE\u05D9\u05D3\u05E2 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D0\u05D5\u05E1\u05E4\u05EA, \u05D0\u05D9\u05DA \u05D4\u05D5\u05D0 \u05E0\u05E9\u05DE\u05E8 \u05D5\u05DC\u05DE\u05D9 \u05DE\u05E9\u05D5\u05EA\u05E3.","\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05E4\u05E8\u05D8\u05D9\u05D5\u05EA","\u05D4\u05E6\u05D4\u05E8\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u00B7 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D4\u05EA\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05E2\u05DE\u05D9\u05D3\u05D4 \u05D1\u05EA\u05E7\u05DF WCAG 2.1 \u05D1\u05E8\u05DE\u05D4 AA \u05D5\u05D1\u05EA\u05E7\u05E0\u05D5\u05EA \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D1\u05D9\u05E9\u05E8\u05D0\u05DC.","\u05D4\u05E6\u05D4\u05E8\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA","\u05E7\u05D9\u05E9\u05D5\u05E8\u05D9\u05DD \u05DE\u05E9\u05E4\u05D8\u05D9\u05D9\u05DD","\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA","\u00A9 {year} \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u00B7 \u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE","\u05DE\u05E2\u05DC 20 \u05E9\u05E0\u05D4 \u05E9\u05DC \u05DE\u05D5\u05DE\u05D7\u05D9\u05D5\u05EA \u05D6\u05D5\u05D2\u05D9\u05EA","Ask Deep. Dare More.","\u05EA\u05E9\u05D0\u05DC\u05D5 \u05E2\u05DE\u05D5\u05E7. \u05EA\u05E2\u05D9\u05D6\u05D5 \u05D9\u05D5\u05EA\u05E8.","Couples games that heat up what already exists.","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D7\u05DE\u05DE\u05D9\u05DD \u05D0\u05EA \u05DE\u05D4 \u05E9\u05DB\u05D1\u05E8 \u05E7\u05D9\u05D9\u05DD","\u05E9\u05D7\u05E7\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D1\u05D7\u05D9\u05E0\u05DD","\u05D4\u05DE\u05E7\u05D5\u05DD \u05E9\u05DC \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD","\u05E0\u05D5\u05E1\u05D3 \u05D1-2021 \u2022 \u05D9\u05E6\u05D7\u05E7 \u05D1\u05E8\u05DC\u05D1","\u05DE\u05E6\u05D8\u05E8\u05E4\u05D9\u05DD \u05DC-{count} \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DB\u05D1\u05E8 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","{value} \u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u2022 {count} \u05D1\u05D9\u05E7\u05D5\u05E8\u05D5\u05EA","\u05D6\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD \u05D0\u05DD...","\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E4\u05E2\u05D9\u05DC\u05D9\u05DD \u05E0\u05D8\u05E2\u05E0\u05D9\u05DD \u05DE\u05D4\u05DE\u05E2\u05E8\u05DB\u05EA - \u05D1\u05DC\u05D9 \u05D4\u05EA\u05E7\u05E0\u05D5\u05EA. \u05E4\u05E9\u05D5\u05D8 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD.","\u05E2\u05D5\u05D3 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05E7\u05E8\u05D5\u05D1","\u05D7\u05D5\u05D5\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D5\u05EA \u05D1\u05D3\u05E8\u05DA - \u05D7\u05DE\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8, \u05E2\u05DE\u05D5\u05E7\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8, \u05D8\u05D5\u05D1\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8.","\u05E4\u05E9\u05D5\u05D8. \u05E0\u05E7\u05D9. \u05DE\u05DE\u05DB\u05E8.","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DC\u05E0\u05D5","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DC\u05D9\u05D7\u05E1\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD | \u05DE\u05DC\u05D5\u05D5\u05D4 \u05D6\u05D5\u05D2\u05D5\u05EA \u05DE-2001","Mioshy \u05E0\u05D1\u05E0\u05D4 \u05DE\u05EA\u05D5\u05DA \u05E2\u05D1\u05D5\u05D3\u05D4 \u05D6\u05D5\u05D2\u05D9\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA: \u05DE\u05D1\u05E0\u05D4 \u05D1\u05E8\u05D5\u05E8, \u05D0\u05D9\u05E0\u05D8\u05DC\u05D9\u05D2\u05E0\u05E6\u05D9\u05D4 \u05E8\u05D2\u05E9\u05D9\u05EA, \u05D5\u05E7\u05E6\u05D4 \u05DE\u05E9\u05D7\u05E7\u05D9 \u05E0\u05D5\u05E2\u05D6. \u05D4\u05D5\u05D0 \u05E0\u05D5\u05E2\u05D3 \u05DC\u05D4\u05D3\u05DC\u05D9\u05E7 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D1\u05DC\u05D9 \u05DC\u05D4\u05E4\u05D5\u05DA \u05D0\u05D5\u05EA\u05D4 \u05DC\u05D1\u05D3\u05D9\u05D7\u05D4.","\u05DE\u05D0\u05D5\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D9\u05E4\u05E8\u05D5 \u05D0\u05EA \u05D7\u05D9\u05D9\u05D4\u05DD \u05D4\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D9\u05DD \u05D1\u05E2\u05D6\u05E8\u05EA \u05D4\u05E9\u05D9\u05D8\u05D4 \u05E9\u05DC\u05E0\u05D5","\u05DE\u05E0\u05D5\u05D9\u05D9\u05DD","\u05D2\u05D9\u05E9\u05D4 \u05DE\u05DC\u05D0\u05D4. \u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 - \u05D1\u05DC\u05D9 \u05D3\u05E8\u05DE\u05D4.","\u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2","\u05DC\u05DB\u05DC \u05D4\u05DB\u05EA\u05D1\u05D5\u05EA","\u05E7\u05D9\u05E9\u05D5\u05E8\u05D9\u05DD","\u05E8\u05E9\u05EA\u05D5\u05EA","\u05D8\u05D5\u05DF","\u05E0\u05D5\u05E2\u05D6. \u05D7\u05DD. \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9. \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD - \u05DC\u05D0 \u05DC\u05D9\u05DC\u05D3\u05D9\u05DD.","\u00A9 2021 Mioshy | \u05DB\u05DC \u05D4\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05E9\u05DE\u05D5\u05E8\u05D5\u05EA","\u05D0\u05E4\u05DC \u2022 \u05E4\u05E8\u05D9\u05DE\u05D9\u05D5\u05DD \u2022 \u05D0\u05DE\u05D9\u05EA\u05D9","\u05DE\u05D7\u05D9\u05E8\u05D9\u05DD","\u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05EA\u05D5\u05DB\u05DF \u05D7\u05D3\u05E9 \u05D1\u05D0\u05D5\u05E4\u05DF \u05E7\u05D1\u05D5\u05E2","\u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DE\u05E9\u05D7\u05E7","\u05D1\u05D7\u05E8\u05D5 \u05D0\u05EA \u05D4\u05D5\u05D9\u05D9\u05D1 \u05E9\u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05E2\u05E8\u05D1 \u05D4\u05D6\u05D4.","\u05DE\u05E1\u05D5\u05D1\u05D1\u05D9\u05DD \u05D0\u05EA \u05D4\u05D2\u05DC\u05D2\u05DC","\u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05D2\u05D5\u05E8\u05DC \u05DC\u05D1\u05D7\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E6\u05E2\u05D3 \u05D4\u05D1\u05D0.","\u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05EA \u05D6\u05D4 \uF609","\u05D1\u05DC\u05D9 \u05DC\u05D7\u05E9\u05D5\u05D1 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D3\u05D9 - \u05E4\u05E9\u05D5\u05D8 \u05E7\u05D3\u05D9\u05DE\u05D4.","\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D3\u05E9","\u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05DE\u05E9\u05D9\u05DE\u05D5\u05EA \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D5\u05EA \u05D1\u05D5\u05D2\u05E8\u05D5\u05EA - \u05DC\u05D0 \u05D9\u05DC\u05D3\u05D5\u05EA\u05D9\u05D5\u05EA.","\u05D0\u05EA\u05DD \u05D1\u05EA\u05D4\u05DC\u05D9\u05DA \u05D8\u05D9\u05E4\u05D5\u05DC\u05D9","\u05DE\u05E1\u05D2\u05E8\u05EA \u05D1\u05D8\u05D5\u05D7\u05D4 \u05DC\u05EA\u05E8\u05D2\u05DC \u05E7\u05E8\u05D1\u05D4 \u05D5\u05DB\u05E0\u05D5\u05EA.","\u05D0\u05EA\u05DD \u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05E4\u05DC\u05E8\u05D8\u05D5\u05D8 \u05D5\u05DE\u05E9\u05D7\u05E7","\u05DC\u05D4\u05E4\u05D5\u05DA \u05DE\u05EA\u05D7 \u05DC\u05E7\u05E8\u05D1\u05D4 - \u05D1\u05D1\u05D9\u05D8\u05D7\u05D5\u05DF.","\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E2\u05DE\u05D9\u05E7 \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8","\u05DC\u05E2\u05D1\u05D5\u05E8 \u05DE\u05E2\u05D1\u05E8 \u05DC\u05E9\u05D9\u05D7\u05D5\u05EA \u05E9\u05D8\u05D7\u05D9\u05D5\u05EA \u05D5\u05DC\u05D4\u05D9\u05E9\u05D0\u05E8 \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD.","\u05EA\u05D5\u05DA \u05D3\u05E7\u05D5\u05EA \u05DB\u05D1\u05E8 \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5 \u05D1\u05D0\u05DE\u05EA - \u05D5\u05E6\u05D7\u05E7\u05E0\u05D5.","\u05E0\u05D5\u05E2\u05D6, \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9, \u05D5\u05DE\u05E8\u05D2\u05D9\u05E9 \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9.","\u05D4\u05D2\u05DC\u05D2\u05DC \u05E2\u05D5\u05E9\u05D4 \u05D0\u05EA \u05D6\u05D4 \u05E7\u05DC \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA \u05D0\u05EA \u05D4\u05D7\u05D5\u05DD.","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05D5\u05D0\u05E4\u05EA \u05DC\u05D4\u05E0\u05D2\u05D9\u05E9 \u05D0\u05EA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05E9\u05DC\u05D4 \u05DC\u05DB\u05DC\u05DC \u05D4\u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD, \u05DC\u05E8\u05D1\u05D5\u05EA \u05D0\u05E0\u05E9\u05D9\u05DD \u05E2\u05DD \u05DE\u05D5\u05D2\u05D1\u05DC\u05D5\u05EA. \u05D0\u05E0\u05D5 \u05E4\u05D5\u05E2\u05DC\u05D9\u05DD \u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05EA\u05E7\u05E0\u05D5\u05EA \u05E9\u05D5\u05D5\u05D9\u05D5\u05DF \u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05E2\u05DD \u05DE\u05D5\u05D2\u05D1\u05DC\u05D5\u05EA (\u05D4\u05EA\u05D0\u05DE\u05D5\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA), \u05D4\u05EA\u05E9\u05E2\u05F4\u05D2\u05BE2013, \u05D5\u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05EA\u05E7\u05DF \u05D4\u05D9\u05E9\u05E8\u05D0\u05DC\u05D9 \u05EA\u05F4\u05D9 5568 \u05D4\u05DE\u05D1\u05D5\u05E1\u05E1 \u05E2\u05DC WCAG 2.1 \u05D1\u05E8\u05DE\u05D4 AA.","\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA\u05DB\u05DD \u05D7\u05E9\u05D5\u05D1\u05D4 \u05DC\u05E0\u05D5. \u05DE\u05E1\u05DE\u05DA \u05D6\u05D4 \u05DE\u05E1\u05D1\u05D9\u05E8 \u05D0\u05D9\u05D6\u05D4 \u05DE\u05D9\u05D3\u05E2 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D0\u05D5\u05E1\u05E4\u05D9\u05DD, \u05D0\u05D9\u05DA \u05D4\u05D5\u05D0 \u05E0\u05E9\u05DE\u05E8 \u05D5\u05DC\u05DE\u05D9 \u05D4\u05D5\u05D0 \u05E2\u05E9\u05D5\u05D9 \u05DC\u05D4\u05D9\u05D7\u05E9\u05E3. \u05D1\u05DB\u05DC \u05E9\u05D0\u05DC\u05D4, \u05E4\u05E0\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D9\u05DC mioshyoffice@gmail.com.","\u05EA\u05D5\u05DB\u05DF \u05D6\u05D4 \u05DE\u05E4\u05E8\u05D8 \u05D0\u05EA \u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D4\u05D4\u05D7\u05D6\u05E8\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D4\u05DE\u05E1\u05DE\u05DA \u05DE\u05E9\u05DC\u05D9\u05DD \u05D0\u05EA \u05EA\u05E0\u05D0\u05D9 \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D5\u05D0\u05D9\u05E0\u05D5 \u05DE\u05D7\u05DC\u05D9\u05E3 \u05D0\u05D5\u05EA\u05DD.","\u05D1\u05E8\u05D5\u05DB\u05D9\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD \u05DC\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05DE\u05D5\u05E4\u05E2\u05DC \u05E2\u05DC \u05D9\u05D3\u05D9 \u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE (\u05DC\u05D4\u05DC\u05DF: \u05F4\u05D4\u05D7\u05D1\u05E8\u05D4\u05F4, \u05F4\u05D0\u05E0\u05D7\u05E0\u05D5\u05F4). \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05D0\u05EA\u05E8 \u05D5\u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05DB\u05E4\u05D5\u05E3 \u05DC\u05EA\u05E0\u05D0\u05D9\u05DD \u05E9\u05DC\u05D4\u05DC\u05DF. \u05D0\u05E0\u05D0 \u05E7\u05E8\u05D0\u05D5 \u05D0\u05D5\u05EA\u05DD \u05D1\u05E2\u05D9\u05D5\u05DF \u2013 \u05E2\u05E6\u05DD \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05DE\u05D4\u05D5\u05D5\u05D4 \u05D4\u05E1\u05DB\u05DE\u05D4 \u05DC\u05EA\u05E0\u05D0\u05D9\u05DD \u05D0\u05DC\u05D4.","\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD \u05D0\u05EA \u05D4\u05D1\u05DC\u05D5\u05E7 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF","\u05E2\u05D5\u05D3 \u05E8\u05D2\u05E2 \u05D5\u05E0\u05E9\u05D0\u05DC \u05D0\u05D9\u05DA \u05D0\u05EA\u05DD \u05DE\u05EA\u05DE\u05D5\u05D3\u05D3\u05D9\u05DD \u05D1\u05E8\u05D2\u05E2\u05D9\u05DD \u05D4\u05E7\u05E9\u05D9\u05DD \u05D9\u05D5\u05EA\u05E8 \u05D9\u05D7\u05D3. \u05EA\u05D9\u05E7\u05D7\u05D5 \u05E0\u05E9\u05D9\u05DE\u05D4.","\u05D6\u05D4 \u05D4\u05D7\u05DC\u05E7 \u05D4\u05D0\u05D9\u05E9\u05D9","\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA \u05D5\u05D7\u05D9\u05D1\u05D5\u05E8 \u05E8\u05D2\u05E9\u05D9. \u05D1\u05DC\u05D9 \u05E9\u05D9\u05E4\u05D5\u05D8, \u05D1\u05DC\u05D9 \u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05E0\u05DB\u05D5\u05E0\u05D5\u05EA. \u05E2\u05D5\u05D3 \u05E9\u05E0\u05D9\u05D9\u05DD-\u05E9\u05DC\u05D5\u05E9\u05D4 \u05D1\u05DC\u05D5\u05E7\u05D9\u05DD.","\u05D7\u05D1\u05E8\u05D5\u05EA \u05D6\u05D5\u05D2\u05D9\u05EA \u2014 \u05D4\u05D1\u05E1\u05D9\u05E1 \u05E9\u05DC \u05D4\u05DB\u05DC","\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD. \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E0\u05D9\u05D2\u05E2 \u05D1\u05D7\u05D9\u05D9\u05DD \u05D4\u05D9\u05D5\u05DE\u05D9\u05D5\u05DE\u05D9\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u2014 \u05D5\u05D0\u05D6 \u05D1\u05E2\u05D3\u05D9\u05E4\u05D5\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD.","\u05DB\u05DE\u05E2\u05D8 \u05E1\u05D9\u05D9\u05DE\u05EA\u05DD","\u05D4\u05E9\u05DC\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF: \u05DC\u05D3\u05E8\u05D2 \u05D0\u05EA \u05D4\u05E2\u05D3\u05D9\u05E4\u05D5\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD. \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05DE\u05DB\u05D5\u05D5\u05DF \u05D0\u05EA \u05DB\u05DC \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05DC\u05D0\u05D4.","\u05DE\u05E1\u05E2 \u05D6\u05D5\u05D2\u05D9 \u00B7 \u05D4\u05E6\u05D9\u05E8 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD - \u05E4\u05E8\u05E7\u05D9\u05DD \u05E9\u05E0\u05E4\u05EA\u05D7\u05D9\u05DD \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD, \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05D5\u05EA\u05D5\u05D1\u05E0\u05D5\u05EA.","\u05D4\u05E6\u05D9\u05E8 \u05E9\u05DC\u05DB\u05DD \u05E2\u05D3\u05D9\u05D9\u05DF \u05E8\u05D9\u05E7","\u05DC\u05D0\u05D7\u05E8 \u05E9\u05EA\u05E6\u05D8\u05E8\u05E4\u05D5 \u05DC\u05DE\u05E1\u05DC\u05D5\u05DC, \u05E4\u05E8\u05E7\u05D9\u05DD \u05D0\u05D9\u05E9\u05D9\u05D9\u05DD \u05D9\u05D9\u05E4\u05EA\u05D7\u05D5 \u05DB\u05D0\u05DF \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD - \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD, \u05E9\u05D9\u05D7\u05D5\u05EA \u05D5\u05D8\u05E7\u05E1\u05D9 \u05E9\u05D1\u05D5\u05E2.","\u05D2\u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E1\u05E2","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05D1\u05D0\u05D1\u05D7\u05D5\u05DF \u05E9\u05DC 5 \u05D3\u05E7\u05F3","\u05E2\u05D5\u05D2\u05DF \u05D0\u05DE\u05D5\u05DF","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9 \u05DE\u05D0\u05D6 2001","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DC\u05D9\u05D7\u05E1\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD \u00B7 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05DC\u05DE\u05E2\u05DC\u05D4 \u05DE-25 \u05E9\u05E0\u05D4","\u05DB\u05DC \u05E4\u05E8\u05E7 \u05D1\u05DE\u05E1\u05E2 \u05E0\u05D1\u05E0\u05D4 \u05E2\u05DC \u05D1\u05E1\u05D9\u05E1 \u05D0\u05DC\u05E4\u05D9 \u05E9\u05D9\u05D7\u05D5\u05EA \u05E2\u05DD \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD - \u05DC\u05D0 \u05EA\u05D5\u05DB\u05DF \u05D2\u05E0\u05E8\u05D9, \u05D0\u05DC\u05D0 \u05E6\u05E2\u05D3\u05D9\u05DD \u05E9\u05E2\u05D5\u05D1\u05D3\u05D9\u05DD.","\u05D4\u05D5\u05E9\u05DC\u05DE\u05D5","\u05E4\u05EA\u05D5\u05D7\u05D9\u05DD","\u05E0\u05E2\u05D5\u05DC\u05D9\u05DD","\u05D4\u05EA\u05E7\u05D3\u05DE\u05D5\u05EA: {completed} \u05DE\u05EA\u05D5\u05DA {total}","1. \u05E7\u05D1\u05DC\u05EA \u05D4\u05E7\u05D5\u05D3","\u05D1\u05E8\u05D2\u05E2 \u05E9\u05D9\u05E9 \u05DC\u05DB\u05DD \u05DE\u05E0\u05D5\u05D9 \u05E4\u05E2\u05D9\u05DC, \u05D9\u05D5\u05E4\u05D9\u05E2 \u05D1'\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9' \u05E7\u05D5\u05D3 \u05D0\u05D9\u05E9\u05D9 \u05D1\u05DF 6 \u05EA\u05D5\u05D5\u05D9\u05DD. \u05D4\u05E7\u05D5\u05D3 \u05E9\u05D9\u05D9\u05DA \u05DC\u05D6\u05D5\u05D2 \u05E9\u05DC\u05DB\u05DD \u05D1\u05DC\u05D1\u05D3 \u05D5\u05DC\u05D0 \u05E0\u05D9\u05EA\u05DF \u05DC\u05E0\u05D7\u05E9 \u05D0\u05D5\u05EA\u05D5.","2. \u05E9\u05DC\u05D9\u05D7\u05D4 \u05DC\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05DC\u05D7\u05D9\u05E6\u05D4 \u05E2\u05DC 'WhatsApp' \u05D0\u05D5 'SMS' \u05E4\u05D5\u05EA\u05D7\u05EA \u05D4\u05D5\u05D3\u05E2\u05D4 \u05DE\u05D5\u05DB\u05E0\u05D4 \u05E2\u05DD \u05D4\u05E7\u05D5\u05D3 \u05D5\u05E7\u05D9\u05E9\u05D5\u05E8 \u05D9\u05E9\u05D9\u05E8 \u05DC\u05D4\u05E8\u05E9\u05DE\u05D4. \u05D0\u05E4\u05E9\u05E8 \u05D2\u05DD \u05DC\u05D4\u05E2\u05EA\u05D9\u05E7 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3 \u05D0\u05D5 \u05DC\u05D1\u05E7\u05E9 \u05E9\u05D9\u05E1\u05E8\u05E7\u05D5 QR \u2014 \u05DE\u05D4 \u05E9\u05D9\u05D5\u05EA\u05E8 \u05E0\u05D5\u05D7 \u05DC\u05DB\u05DD.","3. \u05D4\u05E8\u05E9\u05DE\u05D4 \u05E9\u05DC \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05D4\u05E7\u05D9\u05E9\u05D5\u05E8 \u05DE\u05D5\u05D1\u05D9\u05DC \u05DC\u05E2\u05DE\u05D5\u05D3 \u05D4\u05E8\u05E9\u05DE\u05D4 \u05DB\u05E9\u05D4\u05E7\u05D5\u05D3 \u05DB\u05D1\u05E8 \u05DE\u05DE\u05D5\u05DC\u05D0 \u05D1\u05E4\u05E0\u05D9\u05DD. \u05E9\u05DD, \u05D0\u05D9\u05DE\u05D9\u05D9\u05DC, \u05E0\u05D9\u05D9\u05D3 \u05D5\u05E1\u05D9\u05E1\u05DE\u05D4 \u2014 \u05D5\u05E4\u05D7\u05D5\u05EA \u05DE\u05D3\u05E7\u05D4 \u05D0\u05D7\u05E8 \u05DB\u05DA \u05D4\u05D7\u05E9\u05D1\u05D5\u05E0\u05D5\u05EA \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD.","4. \u05D4\u05DB\u05DC \u05E4\u05EA\u05D5\u05D7 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD","\u05D1\u05E8\u05D2\u05E2 \u05E9\u05D4\u05D4\u05E8\u05E9\u05DE\u05D4 \u05DE\u05E1\u05EA\u05D9\u05D9\u05DE\u05EA, \u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2 \u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA \u05D0\u05D5\u05EA\u05DD \u05EA\u05DB\u05E0\u05D9\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7. \u05D4\u05E7\u05D5\u05D3 \u05E0\u05E2\u05DC\u05DD \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05DE\u05D4\u05DE\u05E1\u05DA \u2014 \u05D0\u05D9\u05DF \u05E6\u05D5\u05E8\u05DA \u05DC\u05E2\u05E9\u05D5\u05EA \u05E9\u05D5\u05DD \u05D3\u05D1\u05E8 \u05E0\u05D5\u05E1\u05E3.","\u05D0\u05D9\u05E6\u05D9\u05E7 \u05D1\u05E8\u05DC\u05D1 - \u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D4\u05DE\u05E1\u05E2 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC \u05D0\u05D9\u05E6\u05D9\u05E7 \u05D1\u05E8\u05DC\u05D1, \u05DE\u05D9\u05D9\u05E1\u05D3 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05DE\u05D4\u05DE\u05E9\u05D1\u05E8 \u05D4\u05D6\u05D5\u05D2\u05D9 \u05E9\u05DB\u05DE\u05E2\u05D8 \u05E4\u05D9\u05E8\u05E7 \u05D0\u05EA \u05D4\u05E0\u05D9\u05E9\u05D5\u05D0\u05D9\u05DD, \u05D3\u05E8\u05DA 600 \u05E1\u05E4\u05E8\u05D9\u05DD \u05D1\u05E9\u05DC\u05D5\u05E9 \u05E9\u05E4\u05D5\u05EA, \u05D5\u05E2\u05D3 \u05DC\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05D2\u05DD \u05E9\u05DC\u05DB\u05DD.","\u05D7\u05D6\u05E8\u05D4 \u05DC\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D0\u05D9\u05E6\u05D9\u05E7 <em>\u05D1\u05E8\u05DC\u05D1</em>","\u05D1\u05DF 45 \u00B7 \u05E0\u05E9\u05D5\u05D9 17 \u05E9\u05E0\u05D4 \u00B7 \u05D0\u05D1\u05D0 \u05DC\u05DC\u05D9\u05D0\u05DF (16), \u05E0\u05D3\u05D1 (14) \u05D5\u05E0\u05D5\u05E2\u05DD (7) \u00B7 \u05DE\u05D9\u05D9\u05E1\u05D3 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05E4\u05E2\u05DD \u05D7\u05E9\u05D1\u05E0\u05D5 \u05DC\u05D4\u05EA\u05E4\u05E8\u05E7. \u05D4\u05D9\u05D5\u05DD \u05D0\u05E0\u05D9 \u05D1\u05D5\u05E0\u05D4 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DE\u05D7\u05D6\u05D9\u05E8\u05D9\u05DD \u05DC\u05D0\u05DC\u05E4\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4 \u05E9\u05D0\u05D9\u05D1\u05D3\u05D5.","\u05D4\u05E8\u05D2\u05E2 \u05E9\u05DB\u05DE\u05E2\u05D8 \u05E4\u05D9\u05E8\u05E7 \u05D0\u05D5\u05EA\u05E0\u05D5","\u05DB\u05DE\u05D5 \u05D0\u05E6\u05DC \u05D4\u05E8\u05D1\u05D4 \u05D6\u05D5\u05D2\u05D5\u05EA, \u05D2\u05DD \u05D0\u05E6\u05DC\u05E0\u05D5 \u05D6\u05D4 \u05D4\u05EA\u05D7\u05D9\u05DC \u05D1\u05DC\u05D9 \u05D3\u05E8\u05DE\u05D4. \u05D4\u05D9\u05DC\u05D3\u05D9\u05DD \u05E2\u05D5\u05D3 \u05D4\u05D9\u05D5 \u05E7\u05D8\u05E0\u05D9\u05DD, \u05D4\u05D7\u05D9\u05D9\u05DD \u05D6\u05D6\u05D5 \u05DE\u05D4\u05E8, \u05D5\u05D0\u05D9\u05DB\u05E9\u05D4\u05D5, \u05D1\u05D0\u05D9\u05D6\u05E9\u05D4\u05D5 \u05E8\u05D2\u05E2, \u05D4\u05D1\u05D8\u05E0\u05D5 \u05D0\u05D7\u05EA \u05D1\u05E9\u05E0\u05D9 \u05D5\u05DB\u05D1\u05E8 \u05DC\u05D0 \u05D6\u05D9\u05D4\u05D9\u05E0\u05D5 \u05D0\u05EA \u05E2\u05E6\u05DE\u05E0\u05D5.","\u05D4\u05E9\u05D2\u05E8\u05D4 \u05D4\u05E6\u05DE\u05D9\u05D7\u05D4 \u05E8\u05D2\u05DC\u05D9\u05D9\u05DD. \u05E2\u05D1\u05D5\u05D3\u05D4, \u05D2\u05DF, \u05D0\u05E8\u05D5\u05D7\u05D5\u05EA \u05E2\u05E8\u05D1, \u05D4\u05E8\u05D3\u05DE\u05EA \u05D9\u05DC\u05D3\u05D9\u05DD, \u05E9\u05D9\u05E0\u05D4. \u05D5\u05D1\u05E1\u05D5\u05E3 \u05D4\u05E9\u05D1\u05D5\u05E2 - \u05D0\u05D5\u05EA\u05D5 \u05D3\u05D1\u05E8. \u05DB\u05E9\u05E0\u05D9\u05E1\u05D9\u05E0\u05D5 \u05DC\u05D4\u05D6\u05DB\u05E8 \u05DE\u05EA\u05D9 \u05D1\u05E4\u05E2\u05DD \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05E6\u05D7\u05E7\u05E0\u05D5 \u05D1\u05D9\u05D7\u05D3 \u05E2\u05D3 \u05D3\u05DE\u05E2\u05D5\u05EA, \u05D1\u05D0\u05DE\u05EA \u05DC\u05D0 \u05D9\u05D3\u05E2\u05E0\u05D5 \u05DC\u05E2\u05E0\u05D5\u05EA.","\u05DB\u05E9\u05E9\u05D9\u05D7\u05D4 \u05D0\u05D7\u05EA \u05DC\u05D0 \u05D4\u05E1\u05E4\u05D9\u05E7\u05D4, \u05E4\u05E0\u05D9\u05E0\u05D5 \u05DC\u05D9\u05D9\u05E2\u05D5\u05E5 \u05D6\u05D5\u05D2\u05D9. \u05DB\u05E9\u05D2\u05DD \u05D6\u05D4 \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05DE\u05E1\u05E4\u05D9\u05E7, \u05D4\u05D5\u05E1\u05E4\u05E0\u05D5 \u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05EA. \u05D9\u05E9\u05D1\u05E0\u05D5 \u05DE\u05D5\u05DC \u05D0\u05E0\u05E9\u05D9\u05DD \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9\u05D9\u05DD, \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5, \u05D1\u05DB\u05D9\u05E0\u05D5, \u05E0\u05D9\u05E1\u05D9\u05E0\u05D5.","\u05D5\u05D6\u05D4 \u05DC\u05D0 \u05E2\u05D6\u05E8.","\u05D4\u05D4\u05D7\u05DC\u05D8\u05D4 - \u05DC\u05E7\u05D7\u05EA \u05D0\u05EA \u05D6\u05D4 \u05DC\u05D9\u05D3\u05D9\u05D9\u05DD","\u05D4\u05D9\u05D9\u05EA\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA \u05DC\u05D7\u05E4\u05E9 \u05DE\u05D8\u05E4\u05DC \u05D0\u05D7\u05E8, \u05D2\u05D9\u05E9\u05D4 \u05D0\u05D7\u05E8\u05EA, \u05D0\u05D9\u05D6\u05E9\u05D4\u05D5 \u05E4\u05EA\u05E8\u05D5\u05DF \u05DE\u05D1\u05D7\u05D5\u05E5. \u05D1\u05DE\u05E7\u05D5\u05DD \u05D6\u05D4, \u05D4\u05D7\u05DC\u05D8\u05EA\u05D9 \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8: \u05D0\u05DD \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05D4\u05D5\u05DC\u05DA \u05DC\u05D4\u05E6\u05D9\u05DC \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 - \u05D0\u05E0\u05D9 \u05D0\u05E2\u05E9\u05D4 \u05D0\u05EA \u05D6\u05D4 \u05D1\u05E2\u05E6\u05DE\u05D9.","\u05D4\u05E4\u05E1\u05E7\u05EA\u05D9 \u05DC\u05D7\u05DB\u05D5\u05EA \u05DC\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA. \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05D7\u05E4\u05E9 \u05D0\u05D5\u05EA\u05DF. \u05DE\u05D4 \u05D4\u05E9\u05EA\u05D1\u05E9 \u05D1\u05D3\u05E8\u05DA? \u05D0\u05D9\u05E4\u05D4 \u05D0\u05D9\u05D1\u05D3\u05E0\u05D5 \u05D0\u05D7\u05D3 \u05D0\u05EA \u05D4\u05E9\u05E0\u05D9? \u05D5\u05D4\u05DB\u05D9 \u05D7\u05E9\u05D5\u05D1 - \u05D4\u05D0\u05DD \u05D1\u05DB\u05DC\u05DC \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D7\u05D6\u05D5\u05E8?","\u05D9\u05D3\u05E2\u05EA\u05D9 \u05E9\u05D6\u05D4 \u05DC\u05D0 \u05D9\u05D9\u05E4\u05EA\u05E8 \u05D1\u05E1\u05D5\u05E3 \u05E9\u05D1\u05D5\u05E2 \u05D0\u05E8\u05D5\u05DA. \u05D0\u05DD \u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E8\u05D0\u05D5\u05EA \u05E9\u05D5\u05D1 \u05D0\u05EA \u05D0\u05D5\u05E9\u05E8\u05EA \u05DB\u05E4\u05D9 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D4 \u05DB\u05E9\u05D4\u05DB\u05E8\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D4 - \u05D0\u05E6\u05D8\u05E8\u05DA \u05DC\u05DC\u05DB\u05EA \u05E2\u05DD \u05D6\u05D4 \u05E2\u05D3 \u05D4\u05E1\u05D5\u05E3.","\u05DE\u05D0\u05D5\u05EA \u05E1\u05E4\u05E8\u05D9\u05DD. \u05E9\u05DC\u05D5\u05E9 \u05E9\u05E4\u05D5\u05EA.","\u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05E7\u05E8\u05D5\u05D0. \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA, \u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA, \u05D5\u05D1\u05D0\u05D9\u05D8\u05DC\u05E7\u05D9\u05EA - \u05E9\u05DC\u05D5\u05E9 \u05E9\u05E4\u05D5\u05EA, \u05DE\u05D0\u05D5\u05EA \u05E1\u05E4\u05E8\u05D9\u05DD. \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05EA\u05E9\u05D5\u05E7\u05D4, \u05D0\u05D4\u05D1\u05D4, \u05E4\u05E1\u05D9\u05DB\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4, \u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05DE\u05E6\u05D0\u05EA\u05D9, \u05E7\u05E8\u05D0\u05EA\u05D9. \u05D1\u05DC\u05D9\u05DC\u05D5\u05EA, \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05D9\u05DC\u05D3\u05D9\u05DD \u05E0\u05E8\u05D3\u05DE\u05D5, \u05D1\u05E0\u05E1\u05D9\u05E2\u05D5\u05EA \u05DC\u05E2\u05D1\u05D5\u05D3\u05D4, \u05D1\u05DB\u05DC \u05D7\u05D5\u05E8 \u05E9\u05DC \u05D6\u05DE\u05DF.","\u05DC\u05D0 \u05D4\u05E1\u05EA\u05E4\u05E7\u05EA\u05D9 \u05D1\u05E1\u05E4\u05E8\u05D9\u05DD. \u05E0\u05E8\u05E9\u05DE\u05EA\u05D9 \u05DC\u05E7\u05D5\u05E8\u05E1\u05D9\u05DD - \u05D9\u05D9\u05E2\u05D5\u05E5 \u05D6\u05D5\u05D2\u05D9, NLP, \u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4. \u05E8\u05E6\u05D9\u05EA\u05D9 \u05E9\u05D9\u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D2\u05DD \u05D4\u05D9\u05D3\u05E2 \u05D4\u05EA\u05D9\u05D0\u05D5\u05E8\u05D8\u05D9 \u05D5\u05D2\u05DD \u05D4\u05DB\u05DC\u05D9\u05DD \u05D4\u05DE\u05E2\u05E9\u05D9\u05D9\u05DD. \u05E8\u05E6\u05D9\u05EA\u05D9 \u05DC\u05D4\u05D1\u05D9\u05DF \u05D0\u05EA \u05D6\u05D4 \u05DB\u05DC \u05D4\u05D3\u05E8\u05DA \u05E2\u05D3 \u05D4\u05E1\u05D5\u05E3.","\u05DC\u05D0 \u05D7\u05D9\u05E4\u05E9\u05EA\u05D9 \u05EA\u05D9\u05D0\u05D5\u05E8\u05D9\u05D4. \u05D7\u05D9\u05E4\u05E9\u05EA\u05D9 \u05EA\u05E8\u05D5\u05E4\u05D4.","\u05D5\u05DB\u05DB\u05DC \u05E9\u05E6\u05DC\u05DC\u05EA\u05D9 \u05E2\u05DE\u05D5\u05E7 \u05D9\u05D5\u05EA\u05E8, \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05E8\u05D0\u05D5\u05EA \u05E9\u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05DC\u05E0\u05D5 \u05DC\u05D0 \u05D9\u05D5\u05E6\u05D0 \u05D3\u05D5\u05E4\u05DF. \u05D6\u05D5\u05D2\u05D5\u05EA \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD \u05E9\u05D5\u05D1 \u05D5\u05E9\u05D5\u05D1 \u05DC\u05D0\u05D5\u05EA\u05DF \u05D4\u05DE\u05DC\u05DB\u05D5\u05D3\u05D5\u05EA. \u05D0\u05D1\u05DC \u05D2\u05D9\u05DC\u05D9\u05EA\u05D9 \u05D2\u05DD \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8 - \u05E9\u05D9\u05E9 \u05D3\u05E8\u05DB\u05D9\u05DD \u05D0\u05D7\u05E8\u05D5\u05EA \u05DC\u05E6\u05D0\u05EA \u05DE\u05D4\u05DF. \u05DC\u05D0 \u05D3\u05E8\u05DA \u05D4\u05E1\u05E4\u05D4 \u05D0\u05E6\u05DC \u05D4\u05DE\u05D8\u05E4\u05DC, \u05D5\u05DC\u05D0 \u05D3\u05E8\u05DA \u05DC\u05D9\u05DC\u05D5\u05EA \u05E9\u05DC \u05D1\u05DB\u05D9. \u05D3\u05E8\u05DB\u05D9\u05DD \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D5\u05EA \u05D0\u05D7\u05E8\u05EA \u05DC\u05D2\u05DE\u05E8\u05D9. \u05E7\u05DC\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8. \u05D7\u05DE\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8. \u05D1\u05D9\u05D7\u05D3.","\u05D4\u05E8\u05D2\u05E2 \u05E9\u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3","\u05D4\u05EA\u05D5\u05E6\u05D0\u05D4 \u05DC\u05D0 \u05D0\u05D9\u05D7\u05E8\u05D4 \u05DC\u05D1\u05D5\u05D0. \u05D4\u05D7\u05D6\u05E8\u05E0\u05D5 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4. \u05D0\u05EA \u05D4\u05DE\u05D1\u05D8\u05D9\u05DD \u05DE\u05E2\u05D1\u05E8 \u05DC\u05D7\u05D3\u05E8. \u05D0\u05EA \u05D4\u05E6\u05D7\u05D5\u05E7 \u05E9\u05E7\u05D9\u05D9\u05DD \u05E8\u05E7 \u05D1\u05D9\u05DF \u05E9\u05E0\u05D9 \u05D0\u05E0\u05E9\u05D9\u05DD \u05E9\u05D1\u05D7\u05E8\u05D5 \u05D0\u05D7\u05D3 \u05D1\u05E9\u05E0\u05D9, \u05D5\u05D6\u05D5\u05DB\u05E8\u05D9\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DC\u05DE\u05D4.","\u05DC\u05D0 \u05D4\u05D9\u05D4 \u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3 \u05D3\u05E8\u05DE\u05D8\u05D9. \u05D4\u05D9\u05D4 \u05EA\u05D4\u05DC\u05D9\u05DA. \u05D0\u05D1\u05DC \u05D1\u05E0\u05E7\u05D5\u05D3\u05D4 \u05DE\u05E1\u05D5\u05D9\u05DE\u05EA \u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05D9 \u05E2\u05DC \u05D0\u05D5\u05E9\u05E8\u05EA \u05D5\u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05DE\u05E9\u05D4\u05D5 \u05D4\u05E9\u05EA\u05E0\u05D4 - \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E9\u05D5\u05D1 <em>\u05D0\u05E0\u05D7\u05E0\u05D5</em>. \u05D5\u05DB\u05DC \u05DE\u05D4 \u05E9\u05E2\u05D1\u05E8\u05E0\u05D5 \u05E2\u05D3 \u05D0\u05D6 \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05D4\u05E1\u05D5\u05E3 - \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D4\u05EA\u05D7\u05DC\u05D4 \u05D7\u05D3\u05E9\u05D4.","\u05DC\u05DE\u05D4 \u05D3\u05D5\u05D5\u05E7\u05D0 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05EA\u05DE\u05D9\u05D3 \u05D0\u05D4\u05D1\u05EA\u05D9 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD. \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA \u05E9\u05D1\u05D4 \u05D4\u05DD \u05E4\u05D5\u05EA\u05D7\u05D9\u05DD \u05E9\u05D9\u05D7\u05D5\u05EA \u05E9\u05DC\u05E2\u05D5\u05DC\u05DD \u05DC\u05D0 \u05D4\u05D9\u05D5 \u05E0\u05E4\u05EA\u05D7\u05D5\u05EA \u05D0\u05D7\u05E8\u05EA. \u05D0\u05EA \u05D4\u05D0\u05D5\u05E4\u05DF \u05E9\u05D1\u05D5 \u05D4\u05DD \u05DE\u05D0\u05E4\u05E9\u05E8\u05D9\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05E4\u05D2\u05D9\u05E2\u05D9\u05DD \u05D1\u05DC\u05D9 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05DE\u05D0\u05D5\u05D9\u05DE\u05D9\u05DD. \u05D0\u05EA \u05D6\u05D4 \u05E9\u05D1\u05DE\u05E9\u05D7\u05E7, \u05DE\u05D5\u05EA\u05E8 \u05DC\u05E9\u05D0\u05D5\u05DC \u05DE\u05D4 \u05E9\u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA \u05DE\u05E2\u05D6 \u05DC\u05E9\u05D0\u05D5\u05DC \u05D1\u05D0\u05E8\u05D5\u05D7\u05EA \u05E2\u05E8\u05D1.","\u05D1\u05E8\u05D2\u05E2 \u05E9\u05D7\u05D9\u05D1\u05E8\u05EA\u05D9 \u05D1\u05D9\u05DF \u05D4\u05D9\u05D3\u05E2 \u05E9\u05E6\u05D1\u05E8\u05EA\u05D9 \u05DC\u05D1\u05D9\u05DF \u05D4\u05D0\u05D4\u05D1\u05D4 \u05D4\u05D6\u05D0\u05EA - \u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05D9\u05E9 \u05E4\u05D4 \u05DE\u05E9\u05D4\u05D5. \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05D9\u05E6\u05D5\u05E8 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD. \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4 \u05E8\u05E7 \u05DC\u05D0\u05D5\u05E9\u05E8\u05EA \u05D5\u05DC\u05D9. \u05D0\u05D7\u05E8-\u05DB\u05DA \u05DC\u05D7\u05D1\u05E8\u05D9\u05DD \u05E7\u05E8\u05D5\u05D1\u05D9\u05DD - \u05D0\u05DC\u05D4 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05E6\u05DC\u05DD \u05D0\u05EA \u05D0\u05D5\u05EA\u05DD \u05D4\u05D3\u05E4\u05D5\u05E1\u05D9\u05DD \u05E9\u05D4\u05D9\u05D5 \u05D0\u05E6\u05DC\u05E0\u05D5. \u05D4\u05DD \u05E2\u05D1\u05D3\u05D5. \u05E9\u05DD, \u05D1\u05E1\u05DC\u05D5\u05DF, \u05E2\u05DC \u05D4\u05E9\u05D5\u05DC\u05D7\u05DF \u05D1\u05D0\u05E8\u05D5\u05D7\u05EA \u05E2\u05E8\u05D1 - \u05D4\u05DD \u05E4\u05E9\u05D5\u05D8 \u05E2\u05D1\u05D3\u05D5.","\u05D5\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D4\u05E8\u05D2\u05E2 \u05E9\u05D1\u05D5 \u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E9\u05DE\u05D5\u05E8 \u05D0\u05EA \u05D6\u05D4 \u05DC\u05E2\u05E6\u05DE\u05D9.","\u05DB\u05DB\u05D4 \u05E0\u05D5\u05DC\u05D3\u05D4 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05E2\u05DD \u05D4\u05D9\u05D3\u05E2 \u05E9\u05E6\u05D1\u05E8\u05EA\u05D9, \u05E2\u05DD \u05D4\u05D0\u05D4\u05D1\u05D4 \u05E9\u05DC\u05D9 \u05DC\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05D5\u05E2\u05DD \u05D4\u05D4\u05D1\u05E0\u05D4 \u05E9\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E2\u05D5\u05D1\u05D3 - \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05D1\u05E0\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5 \u05D2\u05D3\u05D5\u05DC \u05D9\u05D5\u05EA\u05E8. \u05DE\u05E7\u05D5\u05DD \u05E9\u05D9\u05EA\u05DF \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DD \u05D0\u05EA \u05D0\u05D5\u05EA\u05DD \u05D4\u05DB\u05DC\u05D9\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7 \u05E9\u05E2\u05D6\u05E8\u05D5 \u05DC\u05E0\u05D5, \u05D1\u05DC\u05D9 \u05E9\u05D9\u05E6\u05D8\u05E8\u05DB\u05D5 \u05DC\u05E2\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA \u05D4\u05D0\u05E8\u05D5\u05DB\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E2\u05D1\u05E8\u05EA\u05D9.","\u05DB\u05DB\u05D4 \u05E0\u05D5\u05DC\u05D3\u05D4 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D1\u05D9\u05EA - \u05D9\u05E6\u05D9\u05E8\u05EA\u05D9, \u05D7\u05DD, \u05D7\u05DB\u05DD, \u05D5\u05E2\u05DD \u05DE\u05D8\u05E8\u05D4 \u05D0\u05D7\u05EA \u05D1\u05E8\u05D5\u05E8\u05D4: \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05EA \u05D4\u05E8\u05D5\u05D7 \u05E9\u05DC\u05D4. \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05E4\u05D9\u05EA\u05D7\u05EA\u05D9 \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05E9\u05E0\u05D9\u05DD \u05DE\u05D5\u05D1\u05D9\u05DC\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD \u05DC\u05DE\u05E1\u05E2 \u05E9\u05DE\u05D7\u05D1\u05E8 \u05D0\u05EA\u05DB\u05DD \u05DE\u05D7\u05D3\u05E9 - \u05D1\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA, \u05D1\u05EA\u05E9\u05D5\u05E7\u05D4, \u05D1\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05D1\u05E7\u05D3\u05DE\u05EA \u05D4\u05D1\u05DE\u05D4. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D1\u05E8\u05E7\u05E2, \u05DE\u05DC\u05D5\u05D5\u05D9\u05DD. \u05E6\u05E2\u05D3 \u05D0\u05D7\u05E8 \u05E6\u05E2\u05D3.","\u05D5\u05DC\u05DE\u05D9 \u05E9\u05DE\u05D5\u05DB\u05DF \u05DC\u05DC\u05DB\u05EA \u05E8\u05D7\u05D5\u05E7 \u05D9\u05D5\u05EA\u05E8 - \u05E4\u05EA\u05D7\u05E0\u05D5 \u05D3\u05DC\u05EA \u05D2\u05DD \u05DC\u05E2\u05D5\u05DC\u05DD \u05E9\u05DC \u05D0\u05D1\u05D9\u05D6\u05E8\u05D9 \u05D4\u05DE\u05D9\u05DF. \u05D1\u05E2\u05D3\u05D9\u05E0\u05D5\u05EA, \u05D1\u05D4\u05D3\u05E8\u05D2\u05D4, \u05D3\u05E8\u05DA \u05DE\u05D0\u05E8\u05D6\u05D9 \u05EA\u05E9\u05D5\u05E7\u05D4 \u05D5\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05D9\u05E6\u05E8\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D5\u05D7\u05D3 \u05DC\u05DE\u05D8\u05E8\u05D4 \u05D4\u05D6\u05D5. \u05EA\u05DE\u05D9\u05D3 \u05D1\u05D0\u05D9\u05DB\u05D5\u05EA. \u05EA\u05DE\u05D9\u05D3 \u05D1\u05D8\u05E2\u05DD \u05D8\u05D5\u05D1. \u05D5\u05EA\u05DE\u05D9\u05D3 \u05DE\u05DE\u05E7\u05D5\u05DD \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05D5\u05DE\u05D3\u05D9\u05DD \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9\u05D5 - \u05DB\u05D9 \u05D2\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05D1\u05E8\u05E0\u05D5 \u05D0\u05EA \u05D4\u05D3\u05E8\u05DA \u05D4\u05D6\u05D5.","\u05DC\u05DE\u05D4 \"\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9\"?","\u05D4\u05E9\u05DD \"\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9\" \u05DC\u05D0 \u05D4\u05D5\u05DE\u05E6\u05D0 \u05D1\u05D7\u05D3\u05E8 \u05D9\u05E9\u05D9\u05D1\u05D5\u05EA, \u05D5\u05DC\u05D0 \u05E0\u05D1\u05D7\u05E8 \u05E2\u05DC \u05D9\u05D3\u05D9 \u05DE\u05E9\u05E8\u05D3 \u05E4\u05E8\u05E1\u05D5\u05DD. \u05D4\u05D5\u05D0 \u05D9\u05E6\u05D0 \u05DE\u05EA\u05D5\u05DA \u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05D4\u05DB\u05D9 \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05E0\u05D5.","\u05D0\u05E8\u05D1\u05E2 \u05E9\u05E0\u05D9\u05DD \u05DE\u05D8\u05E8\u05D9\u05E4\u05D5\u05EA \u05D1\u05D9\u05DC\u05D9\u05EA\u05D9 \u05D1\u05D0\u05D9\u05D8\u05DC\u05D9\u05D4 - \u05E2\u05DD \u05D0\u05D5\u05E9\u05E8\u05EA, \u05D0\u05E9\u05EA\u05D9, \u05E9\u05D0\u05D6 \u05E2\u05D5\u05D3 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D4\u05D7\u05D1\u05E8\u05D4 \u05E9\u05DC\u05D9. \u05D0\u05D9\u05D8\u05DC\u05E7\u05D9\u05EA - \u05D4\u05E9\u05E4\u05D4 \u05D4\u05E1\u05E7\u05E1\u05D9\u05EA \u05D1\u05D9\u05D5\u05EA\u05E8 \u05E9\u05D9\u05E9 - \u05E0\u05DB\u05E0\u05E1\u05D4 \u05DC\u05D9 \u05DC\u05D3\u05DD. \u05DB\u05E9\u05D7\u05D6\u05E8\u05E0\u05D5 \u05D4\u05D1\u05D9\u05EA\u05D4, \u05D4\u05D9\u05D0 \u05E0\u05E9\u05D0\u05E8\u05D4 \u05D0\u05D9\u05EA\u05E0\u05D5. \u05DB\u05D9\u05E0\u05D5\u05D9\u05D9 \u05D4\u05D7\u05D9\u05D1\u05D4, \u05D4\u05DE\u05E9\u05E4\u05D8\u05D9\u05DD \u05D4\u05E7\u05D8\u05E0\u05D9\u05DD, \u05D4\u05E6\u05D5\u05E8\u05D4 \u05E9\u05D1\u05D4 \u05E7\u05D5\u05E8\u05D0\u05D9\u05DD \u05DC\u05D0\u05D4\u05D5\u05D1.","\u05D5\u05DB\u05DB\u05D4, \u05D1\u05DC\u05D9 \u05E9\u05EA\u05DB\u05E0\u05E0\u05D5, \u05E0\u05D1\u05E0\u05D4 \u05D2\u05DD \u05D4\u05E9\u05DD:","\u05DB\u05DC \u05E4\u05E2\u05DD \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D0\u05D5\u05DE\u05E8 \u05D0\u05EA \u05D4\u05E9\u05DD, \u05D4\u05D5\u05D0 \u05D1\u05E2\u05E6\u05DD \u05D0\u05D5\u05DE\u05E8 \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8 \u05D4\u05DB\u05D9 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9 \u05E9\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D9\u05DF \u05E9\u05E0\u05D9 \u05D0\u05E0\u05E9\u05D9\u05DD - <em>\u05D0\u05D9\u05E9\u05D4 \u05E9\u05DC\u05D9</em>. \u05D5\u05D6\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DE\u05D4 \u05E9\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E2\u05D5\u05E1\u05E7\u05EA \u05D1\u05D5.","\u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05D2\u05DD \u05E9\u05DC\u05DB\u05DD","\u05DE\u05D0\u05D4\u05D1\u05D4 \u05D5\u05EA\u05E9\u05D5\u05E7\u05D4 \u05E2\u05E0\u05E7\u05D9\u05D5\u05EA, \u05D3\u05E8\u05DA \u05D4\u05D3\u05E2\u05D9\u05DB\u05D4 \u05E9\u05DE\u05D1\u05D9\u05D0 \u05D0\u05D9\u05EA\u05D5 \u05D4\u05D6\u05DE\u05DF, \u05D5\u05DE\u05E9\u05DD - \u05D4\u05E6\u05EA\u05D4 \u05D7\u05D5\u05D6\u05E8\u05EA \u05E9\u05DC \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D4\u05D3\u05DC\u05D9\u05E7 \u05D0\u05D5\u05EA\u05E0\u05D5 \u05E4\u05E2\u05DD, \u05D1\u05D0\u05D9\u05D8\u05DC\u05D9\u05D4, \u05D1\u05EA\u05D7\u05D9\u05DC\u05EA \u05D4\u05D3\u05E8\u05DA.","\u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05DC\u05D0 \u05E8\u05E7 \u05E9\u05DC\u05D9. \u05D4\u05D5\u05D0 \u05E9\u05DC \u05D0\u05DC\u05E4\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E2\u05D1\u05E8\u05D5 \u05D0\u05D5\u05EA\u05D5 \u05D3\u05E8\u05DA \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D5\u05D1\u05D3\u05D9\u05D5\u05E7 \u05D1\u05E9\u05D1\u05D9\u05DC \u05D6\u05D4 \u05D4\u05E7\u05DE\u05EA\u05D9 \u05D0\u05EA \u05D4\u05DE\u05E7\u05D5\u05DD \u05D4\u05D6\u05D4 - \u05DB\u05D3\u05D9 \u05E9\u05DC\u05D0 \u05EA\u05E6\u05D8\u05E8\u05DB\u05D5 \u05DC\u05E7\u05E8\u05D5\u05D0 \u05DE\u05D0\u05D5\u05EA \u05E1\u05E4\u05E8\u05D9\u05DD, \u05DC\u05E2\u05D1\u05D5\u05E8 \u05E2\u05E9\u05E8\u05D5\u05EA \u05E7\u05D5\u05E8\u05E1\u05D9\u05DD, \u05D5\u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05D4\u05D8\u05E2\u05D5\u05D9\u05D5\u05EA \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05E9\u05D9\u05E0\u05D5, \u05DC\u05E4\u05E0\u05D9 \u05E9\u05EA\u05D7\u05D6\u05E8\u05D5 \u05DC\u05E2\u05E6\u05DE\u05DB\u05DD.","\u05D0\u05DC \u05EA\u05D7\u05D9\u05D5 \"\u05DC\u05D9\u05D3\".","\u05E2\u05E9\u05D5 \u05E6\u05E2\u05D3 \u05D2\u05D3\u05D5\u05DC \u05D0\u05DC \u05D0\u05D4\u05D1\u05D4 \u05E2\u05D5\u05E6\u05DE\u05EA\u05D9\u05EA \u05DE\u05D7\u05D5\u05D3\u05E9\u05EA.","\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5 \u05D0\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05D4\u05DB\u05DC\u05D9\u05DD \u05E9\u05E2\u05D6\u05E8\u05D5 \u05DC\u05E0\u05D5, \u05DE\u05D7\u05DB\u05D9\u05DD \u05D2\u05DD \u05DC\u05DB\u05DD.","\u05D4\u05EA\u05D7\u05D9\u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E1\u05E2 \u05E9\u05DC\u05DB\u05DD","\u05D1\u05D0\u05D4\u05D1\u05D4,\n\u05D0\u05D9\u05E6\u05D9\u05E7","Mio","\u05D1\u05B0\u05BC\u05D0\u05D9\u05D8\u05DC\u05E7\u05D9\u05EA: \"\u05E9\u05DC\u05D9\"","Oshi","\u05D4\u05DB\u05D9\u05E0\u05D5\u05D9 \u05E9\u05DC\u05D9 \u05DC\u05D0\u05D4\u05D5\u05D1\u05EA\u05D9, \u05D0\u05D5\u05E9\u05E8\u05EA","Mio \u00B7 Oshi","\"\u05D0\u05D9\u05E9\u05D4 \u05E9\u05DC\u05D9\" \u00B7 \"\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9\"","\u05D0\u05DC\u05E4\u05D9 \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD","\u05D0\u05D5\u05E6\u05E8 \u05DE\u05D9\u05DC\u05D9\u05DD \u05E9\u05DC \u05E9\u05D9\u05D7\u05D5\u05EA \u05E2\u05D5\u05DE\u05E7, \u05E4\u05DC\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05D5\u05D1\u05D1\u05D9\u05DD \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA \u05D5\u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA.","\u05E9\u05D7\u05E7\u05D5 \u05D9\u05D7\u05D3 - \u05D2\u05DD \u05DE\u05E8\u05D7\u05D5\u05E7","\u05D0\u05D5\u05EA\u05D5 \u05DE\u05E9\u05D7\u05E7, \u05E9\u05E0\u05D9 \u05DE\u05DB\u05E9\u05D9\u05E8\u05D9\u05DD \u05D0\u05D5 \u05DE\u05DB\u05E9\u05D9\u05E8 \u05D0\u05D7\u05D3. Mioshy \u05DE\u05E1\u05E0\u05DB\u05E8\u05DF \u05D0\u05EA\u05DB\u05DD \u05D1\u05D6\u05DE\u05DF \u05D0\u05DE\u05EA.","\u05E2\u05D9\u05E6\u05D5\u05D1 \u05DE\u05E8\u05D2\u05E9 \u05D5\u05D6\u05D5\u05E8\u05DD","\u05D0\u05E0\u05D9\u05DE\u05E6\u05D9\u05D5\u05EA \u05D7\u05DC\u05E7\u05D5\u05EA, \u05E8\u05E7\u05E2\u05D9\u05DD \u05DE\u05D5\u05E0\u05E4\u05E9\u05D9\u05DD, \u05DE\u05D5\u05D6\u05D9\u05E7\u05D4 \u05E2\u05D3\u05D9\u05E0\u05D4 - \u05DB\u05D3\u05D9 \u05E9\u05D4\u05E8\u05D2\u05E2 \u05D9\u05D4\u05D9\u05D4 \u05E9\u05DC\u05DB\u05DD.","\u05D4\u05E9\u05D9\u05D7\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05DC\u05D0 \u05E0\u05E9\u05DE\u05E8\u05D5\u05EA. \u05D0\u05EA\u05DD \u05D1\u05E9\u05DC\u05D9\u05D8\u05D4 \u05E2\u05DC \u05DB\u05DC \u05DE\u05D4 \u05E9\u05E7\u05D5\u05E8\u05D4 \u05E2\u05DC \u05D4\u05DE\u05E1\u05DA.","\u05EA\u05E9\u05D5\u05E7\u05D4","\u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D4\u05E0\u05DB\u05D5\u05E0\u05D5\u05EA \u05DE\u05D7\u05D6\u05D9\u05E8\u05D5\u05EA \u05D0\u05EA \u05D4\u05D4\u05EA\u05E8\u05D2\u05E9\u05D5\u05EA \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D9\u05EA. \u05D1\u05DC\u05D9 \u05DC\u05D3\u05D1\u05E8 \u05E2\u05DC \u05D6\u05D4. \u05D1\u05DC\u05D9 \u05EA\u05E8\u05D2\u05D9\u05DC\u05D9\u05DD.","\u05EA\u05D2\u05DC\u05D5 \u05E2\u05DC \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2 \u05E9\u05DC\u05DB\u05DD \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DC\u05D0 \u05D9\u05D3\u05E2\u05EA\u05DD - \u05D5\u05E2\u05DC \u05D4\u05D7\u05D1\u05E8\u05D9\u05DD, \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05DD \u05DC\u05E9\u05D0\u05D5\u05DC.","\u05DB\u05D9\u05E3","\u05D4\u05E0\u05D0\u05D4 \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA, \u05D1\u05DC\u05D9 \u05EA\u05D9\u05E8\u05D5\u05E6\u05D9\u05DD. \u05E2\u05E8\u05D1 \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC \u05D1\u05E7\u05DC\u05D9\u05E7 \u05D5\u05D4\u05D5\u05E4\u05DA \u05DC\u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC\u05D0 \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E1\u05D9\u05D9\u05DD.","\u05E1\u05E7\u05E8\u05E0\u05D5\u05EA","\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05D7\u05D3\u05E9\u05D9\u05DD","\u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D3\u05E2\u05EA \u05D4\u05DB\u05DC - \u05D0\u05D1\u05DC \"\u05DE\u05D4 \u05D4\u05DB\u05D9 \u05D4\u05E4\u05D7\u05D9\u05D3 \u05D0\u05D5\u05EA\u05DA \u05DB\u05D9\u05DC\u05D3?\" \u05DC\u05D0 \u05E0\u05E9\u05D0\u05DC\u05EA \u05D1\u05E7\u05E4\u05D4 \u05D4\u05E9\u05E0\u05D9. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05D0\u05EA \u05D6\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD, \u05D1\u05D0\u05D5\u05E4\u05DF \u05E9\u05E6\u05D5\u05D7\u05E7 \u05E2\u05DC \u05D4\u05E8\u05E6\u05D9\u05E0\u05D5\u05EA.","\u05F4\u05DC\u05D4\u05DB\u05D9\u05E8 \u05DE\u05D9\u05E9\u05D4\u05D5 \u05DC\u05E2\u05D5\u05DE\u05E7 \u05DC\u05D0 \u05D3\u05D5\u05E8\u05E9 \u05E9\u05E0\u05D9\u05DD. \u05E8\u05E7 \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D4 \u05D4\u05E0\u05DB\u05D5\u05E0\u05D4.\u05F4","\u05EA\u05D6\u05DB\u05D5\u05E8\u05EA","\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D1\u05D0\u05DE\u05E6\u05E2","\u05D0\u05EA\u05DD \u05DC\u05D0 \u05D0\u05D9\u05D1\u05D3\u05EA\u05DD \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA. \u05E8\u05E7 \u05D0\u05EA \u05D4\u05D6\u05DE\u05DF \u05DC\u05D6\u05DB\u05D5\u05E8 \u05D0\u05D5\u05EA\u05D4. \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D3\u05D5\u05D7\u05E1 \u05D1\u05D7\u05E6\u05D9 \u05E9\u05E2\u05D4 \u05D0\u05EA \u05DE\u05D4 \u05E9\u05DE\u05E1\u05E2\u05D3\u05D4 \u05E8\u05D5\u05DE\u05E0\u05D8\u05D9\u05EA \u05E2\u05D5\u05E9\u05D4 \u05D1\u05E9\u05DC\u05D5\u05E9.","\u05F4\u05D7\u05E6\u05D9 \u05E9\u05E2\u05D4 \u05D1\u05DE\u05E7\u05D5\u05DD \u05D4\u05E0\u05DB\u05D5\u05DF - \u05D6\u05D4 \u05DC\u05D0 \u05DE\u05E2\u05D8. \u05D6\u05D4 \u05D4\u05DB\u05DC.\u05F4","\u05D4\u05E4\u05EA\u05E2\u05D4","\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05D5\u05D5\u05EA\u05D9\u05E7\u05D9\u05DD","\u05D0\u05EA\u05DD \u05DE\u05E1\u05D9\u05D9\u05DE\u05D9\u05DD \u05D0\u05D7\u05D3 \u05DC\u05E9\u05E0\u05D9 \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8\u05D9\u05DD. \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E8\u05E7 \u05E6\u05E8\u05D9\u05DA \u05DE\u05E9\u05E4\u05D8\u05D9\u05DD \u05D7\u05D3\u05E9\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E0\u05E1\u05E4\u05E8 \u05DC\u05DB\u05DD \u05DE\u05E9\u05D4\u05D5 \u05E9\u05DC\u05D0 \u05D9\u05D3\u05E2\u05EA\u05DD - \u05E8\u05E7 \u05E0\u05E9\u05D0\u05DC \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D4 \u05E9\u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05DD \u05DC\u05E9\u05D0\u05D5\u05DC.","\u05F4\u05DE\u05D9 \u05E9\u05D7\u05D5\u05E9\u05D1 \u05E9\u05D4\u05D5\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D4\u05DB\u05DC - \u05E9\u05D5\u05D0\u05DC \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05D4\u05DC\u05D0 \u05E0\u05DB\u05D5\u05E0\u05D5\u05EA.\u05F4","1. \u05E7\u05D1\u05DC\u05EA \u05D4\u05EA\u05E0\u05D0\u05D9\u05DD","2. \u05EA\u05D9\u05D0\u05D5\u05E8 \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA","3. \u05E8\u05D9\u05E9\u05D5\u05DD \u05D5\u05D7\u05E9\u05D1\u05D5\u05DF \u05DE\u05E9\u05EA\u05DE\u05E9","4. \u05EA\u05E9\u05DC\u05D5\u05DD \u05D5\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD","5. \u05D1\u05D9\u05D8\u05D5\u05DC \u05DE\u05E0\u05D5\u05D9","6. \u05D4\u05D2\u05D1\u05DC\u05EA \u05D0\u05D7\u05E8\u05D9\u05D5\u05EA","7. \u05E7\u05E0\u05D9\u05D9\u05DF \u05E8\u05D5\u05D7\u05E0\u05D9","8. \u05E9\u05D9\u05DE\u05D5\u05E9 \u05D0\u05E1\u05D5\u05E8","\u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05D0\u05E1\u05D5\u05E8 \u05D1\u05D0\u05D5\u05E4\u05DF \u05D4\u05D1\u05D0:","9. \u05E9\u05D9\u05E0\u05D5\u05D9\u05D9\u05DD \u05D1\u05EA\u05E0\u05D0\u05D9\u05DD","10. \u05D3\u05D9\u05DF \u05D5\u05E9\u05D9\u05E4\u05D5\u05D8","11. \u05E9\u05DE\u05D9\u05E8\u05D4 \u05E2\u05DC \u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05E6\u05E8\u05DB\u05E0\u05D9\u05D5\u05EA","12. \u05D9\u05E6\u05D9\u05E8\u05EA \u05E7\u05E9\u05E8","\u05DB\u05DC \u05D4\u05DE\u05DB\u05D9\u05E8\u05D5\u05EA \u05D4\u05DF \u05E1\u05D5\u05E4\u05D9\u05D5\u05EA","\u05DC\u05DE\u05D4?","\u05D0\u05D9\u05DA \u05DE\u05D1\u05D8\u05DC\u05D9\u05DD \u05DE\u05E0\u05D5\u05D9?","\u05E9\u05D2\u05D9\u05D0\u05D5\u05EA \u05D7\u05D9\u05D5\u05D1","\u05E9\u05DE\u05D9\u05E8\u05D4 \u05E2\u05DC \u05D4\u05D3\u05D9\u05DF \u05D4\u05D9\u05E9\u05E8\u05D0\u05DC\u05D9","\u05DE\u05D9\u05D3\u05E2 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D0\u05D5\u05E1\u05E4\u05D9\u05DD","\u05D1\u05DE\u05D4\u05DC\u05DA \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05E0\u05D0\u05E1\u05E3 \u05E2\u05DC\u05D9\u05DB\u05DD \u05D4\u05DE\u05D9\u05D3\u05E2 \u05D4\u05D1\u05D0:","\u05E2\u05D5\u05D2\u05D9\u05D5\u05EA (Cookies) \u05D5\u05D0\u05E0\u05DC\u05D9\u05D8\u05D9\u05E7\u05D4","\u05E6\u05D3\u05D3\u05D9\u05DD \u05E9\u05DC\u05D9\u05E9\u05D9\u05D9\u05DD","\u05D4\u05DE\u05D9\u05D3\u05E2 \u05E0\u05E9\u05DE\u05E8 \u05D5\u05DE\u05E2\u05D5\u05D1\u05D3 \u05D0\u05E6\u05DC \u05E1\u05E4\u05E7\u05D9 \u05EA\u05E9\u05EA\u05D9\u05EA \u05DE\u05D5\u05D1\u05D9\u05DC\u05D9\u05DD, \u05E9\u05DB\u05E4\u05D5\u05E4\u05D9\u05DD \u05DC\u05E1\u05D8\u05E0\u05D3\u05E8\u05D8\u05D9\u05DD \u05DE\u05D7\u05DE\u05D9\u05E8\u05D9\u05DD \u05E9\u05DC \u05D0\u05D1\u05D8\u05D7\u05D4 \u05D5\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA:","\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA\u05D9\u05DB\u05DD","\u05DB\u05DB\u05DC \u05E9\u05DE\u05D9\u05D3\u05E2 \u05D0\u05D9\u05E9\u05D9 \u05E2\u05DC\u05D9\u05DB\u05DD \u05DE\u05D5\u05D7\u05D6\u05E7 \u05D0\u05E6\u05DC\u05E0\u05D5, \u05D0\u05EA\u05DD \u05D6\u05DB\u05D0\u05D9\u05DD:","\u05E9\u05DE\u05D9\u05E8\u05EA \u05DE\u05D9\u05D3\u05E2","\u05E7\u05D8\u05D9\u05E0\u05D9\u05DD","\u05D9\u05E6\u05D9\u05E8\u05EA \u05E7\u05E9\u05E8 \u05D1\u05E2\u05E0\u05D9\u05D9\u05E0\u05D9 \u05E4\u05E8\u05D8\u05D9\u05D5\u05EA","\u05DE\u05D7\u05D5\u05D9\u05D1\u05D5\u05EA \u05DC\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA","\u05D0\u05DE\u05E6\u05E2\u05D9 \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D1\u05D0\u05EA\u05E8","\u05DB\u05D3\u05D9 \u05DC\u05D4\u05E7\u05DC \u05E2\u05DC \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05D0\u05EA\u05E8, \u05DE\u05D9\u05D5\u05E9\u05DE\u05D5\u05EA \u05D1\u05D5 \u05D4\u05D4\u05EA\u05D0\u05DE\u05D5\u05EA \u05D4\u05D1\u05D0\u05D5\u05EA:","\u05DE\u05D2\u05D1\u05DC\u05D5\u05EA \u05D9\u05D3\u05D5\u05E2\u05D5\u05EA","\u05E8\u05DB\u05D6/\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA","\u05EA\u05D0\u05E8\u05D9\u05DA \u05D4\u05E1\u05E7\u05E8 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF","\u05D0\u05D9\u05DA \u05DE\u05D3\u05D5\u05D5\u05D7\u05D9\u05DD \u05E2\u05DC \u05EA\u05E7\u05DC\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA?","\u20AA9/\u05E9\u05D1\u05D5\u05E2","\u20AA37/\u05D7\u05D5\u05D3\u05E9","\u20AA369/\u05E9\u05E0\u05D4","\u05D4\u05D0\u05DD \u05D6\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DC \u05D6\u05D5\u05D2?","\u05DB\u05DF - \u05DE\u05D6\u05D5\u05D2\u05D5\u05EA \u05D7\u05D3\u05E9\u05D9\u05DD \u05D5\u05E2\u05D3 \u05E7\u05E9\u05E8\u05D9\u05DD \u05D0\u05E8\u05D5\u05DB\u05D9 \u05D8\u05D5\u05D5\u05D7. \u05D0\u05EA\u05DD \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05E6\u05D1 \u05D5\u05D0\u05EA \u05D4\u05D5\u05D9\u05D9\u05D1.","\u05D0\u05D9\u05DA \u05E2\u05D5\u05D1\u05D3 \u05D4\u05DE\u05E0\u05D5\u05D9?","\u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D5\u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E2\u05DD \u05E1\u05E4\u05D9\u05E0\u05D9\u05DD \u05DC\u05DC\u05D0 \u05D4\u05D2\u05D1\u05DC\u05D4.","\u05D4\u05D0\u05DD \u05E0\u05D9\u05EA\u05DF \u05DC\u05D1\u05D8\u05DC \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2?","\u05DB\u05DF. \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D1\u05D8\u05DC \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 \u05DE\u05D4\u05D0\u05D6\u05D5\u05E8 \u05D4\u05D0\u05D9\u05E9\u05D9 - \u05D1\u05DC\u05D9 \u05E9\u05D0\u05DC\u05D5\u05EA.","\u05D4\u05D0\u05DD \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA?","\u05DB\u05DF. \u05D9\u05E9 \u05EA\u05DE\u05D9\u05DB\u05D4 \u05DE\u05DC\u05D0\u05D4 \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA \u05D5\u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA.","\u05DE\u05D4 \u05D4\u05D4\u05D1\u05D3\u05DC \u05D1\u05D9\u05DF \u05D4\u05DE\u05E0\u05D5\u05D9\u05D9\u05DD?","\u05E8\u05E7 \u05EA\u05E7\u05D5\u05E4\u05EA \u05D4\u05D7\u05D9\u05D5\u05D1 \u05DE\u05E9\u05EA\u05E0\u05D4. \u05D4\u05D2\u05D9\u05E9\u05D4 \u05E0\u05E9\u05D0\u05E8\u05EA \u05E4\u05E8\u05D9\u05DE\u05D9\u05D5\u05DD \u05D1\u05DB\u05DC \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA.","\u05D4\u05D0\u05DD \u05D9\u05E9 \u05D0\u05E4\u05E9\u05E8\u05D5\u05EA \u05DC\u05DE\u05E9\u05D7\u05E7 \u05E7\u05D1\u05D5\u05E6\u05EA\u05D9?","\u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 - \u05D6\u05D4 \u05D1\u05EA\u05DB\u05E0\u05D5\u05DF. \u05DB\u05E8\u05D2\u05E2 Mioshy \u05DE\u05D9\u05D5\u05E2\u05D3 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA.","\u05D0\u05D9\u05DA \u05DC\u05E9\u05D0\u05D5\u05DC \u05E9\u05D0\u05DC\u05D5\u05EA \u05E2\u05DE\u05D5\u05E7\u05D5\u05EA","\u05D3\u05E8\u05DA \u05E7\u05E6\u05E8\u05D4 \u05DC\u05E2\u05D1\u05D5\u05E8 \u05DE\u05F4\u05D0\u05D9\u05DA \u05D4\u05D9\u05D4 \u05D4\u05D9\u05D5\u05DD?\u05F4 \u05DC\u05D7\u05D9\u05D1\u05D5\u05E8 \u05D0\u05DE\u05D9\u05EA\u05D9.","\u05DC\u05E4\u05DC\u05E8\u05D8\u05D8 \u05DB\u05DE\u05D5 \u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05DC\u05D0 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D9\u05DC\u05D3\u05D5\u05EA\u05D9. \u05DB\u05DB\u05D4 \u05E9\u05D5\u05DE\u05E8\u05D9\u05DD \u05E2\u05DC \u05E4\u05E8\u05D9\u05DE\u05D9\u05D5\u05DD.","\u05E8\u05D9\u05E1\u05D8 \u05DC\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA","\u05E9\u05DC\u05D5\u05E9 \u05D3\u05E7\u05D5\u05EA \u05E9\u05DE\u05E9\u05E0\u05D5\u05EA \u05D0\u05EA \u05DB\u05DC \u05D4\u05E2\u05E8\u05D1 - \u05D1\u05DC\u05D9 \u05DC\u05D7\u05E5.","\u05D0\u05DD \u05E0\u05EA\u05E7\u05DC\u05EA\u05DD \u05D1\u05E7\u05D5\u05E9\u05D9 \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA\u05D9 \u05D1\u05D0\u05EA\u05E8 \u2013 \u05D0\u05E0\u05D0 \u05E1\u05E4\u05E8\u05D5 \u05DC\u05E0\u05D5. \u05E9\u05DC\u05D7\u05D5 \u05DE\u05D9\u05D9\u05DC \u05DC\u05DB\u05EA\u05D5\u05D1\u05EA mioshyoffice@gmail.com \u05E2\u05DD \u05EA\u05D9\u05D0\u05D5\u05E8 \u05D4\u05E7\u05D5\u05E9\u05D9, \u05D4\u05D3\u05E3 \u05D1\u05D5 \u05E0\u05EA\u05E7\u05DC\u05EA\u05DD \u05D1\u05D5 \u05D5\u05DB\u05DC \u05E4\u05E8\u05D8 \u05E9\u05D9\u05E2\u05D6\u05D5\u05E8 \u05DC\u05E0\u05D5 \u05DC\u05E9\u05D7\u05D6\u05E8 \u05D5\u05DC\u05E4\u05EA\u05D5\u05E8.","\u05E0\u05EA\u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05E9\u05D9\u05D1 \u05DC\u05E4\u05E0\u05D9\u05D9\u05EA \u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D1\u05EA\u05D5\u05DA 14 \u05D9\u05DE\u05D9 \u05E2\u05E1\u05E7\u05D9\u05DD, \u05D5\u05DC\u05EA\u05E7\u05DF \u05D0\u05EA \u05D4\u05DC\u05D9\u05E7\u05D5\u05D9 \u05D4\u05DE\u05D4\u05D5\u05EA\u05D9 \u05D1\u05EA\u05D5\u05DA \u05E4\u05E8\u05E7 \u05D6\u05DE\u05DF \u05E1\u05D1\u05D9\u05E8.","\u05E1\u05E7\u05E8 \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05D1\u05D5\u05E6\u05E2 \u05D1\u05EA\u05D0\u05E8\u05D9\u05DA 06.05.2026. \u05D0\u05E0\u05D5 \u05E2\u05D5\u05E8\u05DB\u05D9\u05DD \u05D1\u05D3\u05D9\u05E7\u05D4 \u05EA\u05E7\u05D5\u05E4\u05EA\u05D9\u05EA \u05DC\u05E4\u05D7\u05D5\u05EA \u05D0\u05D7\u05EA \u05DC\u05E9\u05E0\u05D4.","\u05E0\u05D9\u05EA\u05DF \u05DC\u05E4\u05E0\u05D5\u05EA \u05DC\u05E8\u05DB\u05D6 \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D1\u05DB\u05DC \u05E9\u05D0\u05DC\u05D4, \u05D1\u05E7\u05E9\u05D4 \u05D0\u05D5 \u05D3\u05D9\u05D5\u05D5\u05D7 \u05E2\u05DC \u05EA\u05E7\u05DC\u05D4:","{TODO: Itzik - \u05E0\u05D0 \u05DC\u05DE\u05DC\u05D0 \u05D0\u05EA \u05E9\u05DD \u05E8\u05DB\u05D6/\u05EA \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA, \u05DE\u05E1\u05E4\u05E8 \u05D8\u05DC\u05E4\u05D5\u05DF \u05D5\u05DE\u05D9\u05D9\u05DC \u05D9\u05D9\u05E2\u05D5\u05D3\u05D9 \u05DC\u05E4\u05E0\u05D9\u05D9\u05D4. \u05D1\u05E8\u05D9\u05E8\u05EA \u05DE\u05D7\u05D3\u05DC \u05D6\u05DE\u05E0\u05D9\u05EA: mioshyoffice@gmail.com}","\u05D7\u05DC\u05E7 \u05DE\u05EA\u05DB\u05E0\u05D9 \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05D1\u05D9\u05DD \u05D0\u05E0\u05D9\u05DE\u05E6\u05D9\u05D5\u05EA \u05D5\u05E6\u05DC\u05D9\u05DC\u05D9\u05DD \u05D4\u05D7\u05D9\u05D5\u05E0\u05D9\u05D9\u05DD \u05DC\u05D7\u05D5\u05D5\u05D9\u05D4. \u05D1\u05DB\u05DC \u05DE\u05E7\u05D5\u05DD \u05E9\u05D1\u05D5 \u05E0\u05D9\u05EA\u05DF, \u05DE\u05D5\u05E6\u05E2\u05EA \u05D7\u05DC\u05D5\u05E4\u05D4 (\u05DB\u05D9\u05D1\u05D5\u05D9 \u05E6\u05DC\u05D9\u05DC, \u05D4\u05E9\u05D4\u05D9\u05D9\u05EA \u05D0\u05E0\u05D9\u05DE\u05E6\u05D9\u05D4). \u05D0\u05E0\u05D5 \u05E2\u05D5\u05D1\u05D3\u05D9\u05DD \u05E2\u05DC \u05D4\u05E8\u05D7\u05D1\u05EA \u05D4\u05D7\u05DC\u05D5\u05E4\u05D5\u05EA \u05D4\u05DC\u05DC\u05D5.","\u05D0\u05DD \u05E0\u05EA\u05E7\u05DC\u05EA\u05DD \u05D1\u05D0\u05DC\u05DE\u05E0\u05D8 \u05E9\u05D0\u05D9\u05E0\u05D5 \u05E0\u05D2\u05D9\u05E9 \u2013 \u05D0\u05E0\u05D0 \u05D3\u05D5\u05D5\u05D7\u05D5 \u05DC\u05E0\u05D5, \u05D5\u05E0\u05E4\u05E2\u05DC \u05DC\u05EA\u05E7\u05E0\u05D5 \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05D4\u05D0\u05E4\u05E9\u05E8\u05D9\u05EA.","\u05E0\u05D9\u05D5\u05D5\u05D8 \u05DE\u05DC\u05D0 \u05D1\u05DE\u05E7\u05DC\u05D3\u05EA \u05D1\u05DC\u05D1\u05D3, \u05DC\u05DC\u05D0 \u05E6\u05D5\u05E8\u05DA \u05D1\u05E2\u05DB\u05D1\u05E8.","\u05EA\u05D0\u05D9\u05DE\u05D5\u05EA \u05DC\u05E7\u05D5\u05E8\u05D0\u05D9 \u05DE\u05E1\u05DA \u05E0\u05E4\u05D5\u05E6\u05D9\u05DD (NVDA, JAWS, VoiceOver, TalkBack).","\u05E0\u05D9\u05D2\u05D5\u05D3\u05D9\u05D5\u05EA \u05E6\u05D1\u05E2\u05D9\u05DD \u05D4\u05E2\u05D5\u05DE\u05D3\u05EA \u05D1\u05EA\u05E7\u05DF (\u05D9\u05D7\u05E1 \u05DE\u05D9\u05E0\u05D9\u05DE\u05DC\u05D9 4.5:1 \u05D1\u05D8\u05E7\u05E1\u05D8 \u05D4\u05E8\u05D2\u05D9\u05DC).","\u05EA\u05DE\u05D9\u05DB\u05D4 \u05D1\u05D4\u05D2\u05D3\u05DC\u05EA \u05D8\u05E7\u05E1\u05D8 \u05D1\u05D3\u05E4\u05D3\u05E4\u05DF \u05E2\u05D3 200% \u05DC\u05DC\u05D0 \u05D0\u05D9\u05D1\u05D5\u05D3 \u05EA\u05D5\u05DB\u05DF \u05D0\u05D5 \u05EA\u05E4\u05E7\u05D5\u05D3.","\u05DE\u05D1\u05E0\u05D4 \u05DB\u05D5\u05EA\u05E8\u05D5\u05EA \u05E1\u05DE\u05E0\u05D8\u05D9 (H1\u2013H4) \u05D4\u05DE\u05D0\u05E4\u05E9\u05E8 \u05E0\u05D9\u05D5\u05D5\u05D8 \u05DE\u05E1\u05D5\u05D3\u05E8 \u05E2\u05DD \u05E7\u05D5\u05E8\u05D0\u05D9 \u05DE\u05E1\u05DA.","\u05D8\u05E4\u05E1\u05D9\u05DD \u05E0\u05D2\u05D9\u05E9\u05D9\u05DD \u05E2\u05DD \u05EA\u05D5\u05D5\u05D9\u05D5\u05EA (labels) \u05D1\u05E8\u05D5\u05E8\u05D5\u05EA \u05D5\u05D4\u05D5\u05D3\u05E2\u05D5\u05EA \u05E9\u05D2\u05D9\u05D0\u05D4 \u05DE\u05D5\u05E1\u05D1\u05E8\u05D5\u05EA.","\u05EA\u05D9\u05D5\u05D2 \u05E9\u05DC \u05DB\u05E4\u05EA\u05D5\u05E8\u05D9\u05DD, \u05E7\u05D9\u05E9\u05D5\u05E8\u05D9\u05DD \u05D5\u05D0\u05DC\u05DE\u05E0\u05D8\u05D9\u05DD \u05D0\u05D9\u05E0\u05D8\u05E8\u05D0\u05E7\u05D8\u05D9\u05D1\u05D9\u05D9\u05DD \u05D1\u05E2\u05D6\u05E8\u05EA ARIA.","\u05EA\u05DE\u05D9\u05DB\u05D4 \u05DE\u05DC\u05D0\u05D4 \u05D1\u05DB\u05D9\u05D5\u05D5\u05E0\u05D9\u05D5\u05EA (RTL \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA, LTR \u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA).","\u05D0\u05E0\u05D5 \u05E8\u05D5\u05D0\u05D9\u05DD \u05D1\u05D4\u05E0\u05D2\u05E9\u05D4 \u05E2\u05E8\u05DA \u05D1\u05E1\u05D9\u05E1\u05D9. \u05D4\u05E6\u05D5\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05E2\u05D5\u05D1\u05D3 \u05D1\u05D0\u05D5\u05E4\u05DF \u05E9\u05D5\u05D8\u05E3 \u05E2\u05DC \u05E9\u05D9\u05E4\u05D5\u05E8 \u05D4\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D5\u05E2\u05DC \u05EA\u05D9\u05E7\u05D5\u05DF \u05EA\u05E7\u05DC\u05D5\u05EA \u05DE\u05E7\u05D5\u05DD \u05E9\u05DE\u05EA\u05D2\u05DC\u05D5\u05EA. \u05D0\u05E0\u05D5 \u05E4\u05D5\u05E2\u05DC\u05D9\u05DD \u05DC\u05E2\u05DE\u05D9\u05D3\u05D4 \u05E8\u05E6\u05D9\u05E4\u05D4 \u05D1\u05D3\u05E8\u05D9\u05E9\u05D5\u05EA \u05D4\u05EA\u05E7\u05DF \u05D4\u05D9\u05E9\u05E8\u05D0\u05DC\u05D9 \u05DC\u05E0\u05D2\u05D9\u05E9\u05D5\u05EA \u05D0\u05D9\u05E0\u05D8\u05E8\u05E0\u05D8 (WCAG 2.1 AA) \u05D5\u05DC\u05E9\u05D9\u05E4\u05D5\u05E8\u05D5 \u05E2\u05DD \u05D4\u05D6\u05DE\u05DF.","\u05DC\u05DB\u05DC \u05D1\u05E7\u05E9\u05D4, \u05E9\u05D0\u05DC\u05D4 \u05D0\u05D5 \u05EA\u05DC\u05D5\u05E0\u05D4 \u05D4\u05E0\u05D5\u05D2\u05E2\u05EA \u05DC\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u2013 \u05E4\u05E0\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D9\u05DC: mioshyoffice@gmail.com. \u05E0\u05E9\u05EA\u05D3\u05DC \u05DC\u05D4\u05E9\u05D9\u05D1 \u05D1\u05EA\u05D5\u05DA 14 \u05D9\u05DE\u05D9 \u05E2\u05E1\u05E7\u05D9\u05DD.","\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05DE\u05D9\u05D5\u05E2\u05D3 \u05DC\u05D1\u05E0\u05D9 18 \u05D5\u05DE\u05E2\u05DC\u05D4 \u05D1\u05DC\u05D1\u05D3 \u05D5\u05D0\u05D9\u05E0\u05D5 \u05E4\u05D5\u05E0\u05D4 \u05DC\u05E7\u05D8\u05D9\u05E0\u05D9\u05DD. \u05D0\u05D9\u05E0\u05E0\u05D5 \u05D0\u05D5\u05E1\u05E4\u05D9\u05DD \u05D1\u05D9\u05D5\u05D3\u05E2\u05D9\u05DF \u05DE\u05D9\u05D3\u05E2 \u05E2\u05DC \u05E7\u05D8\u05D9\u05E0\u05D9\u05DD. \u05D0\u05DD \u05D4\u05D2\u05D9\u05E2 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05DE\u05D9\u05D3\u05E2 \u05DB\u05D6\u05D4 \u2013 \u05E0\u05DE\u05D7\u05E7 \u05D0\u05D5\u05EA\u05D5 \u05DE\u05D9\u05D3 \u05E2\u05DD \u05D6\u05D9\u05D4\u05D5\u05D9.","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E9\u05D5\u05DE\u05E8\u05D9\u05DD \u05DE\u05D9\u05D3\u05E2 \u05D0\u05D9\u05E9\u05D9 \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05E4\u05E2\u05D9\u05DC, \u05D0\u05D5 \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D9\u05E9 \u05D1\u05DB\u05DA \u05E6\u05D5\u05E8\u05DA \u05DC\u05E6\u05D5\u05E8\u05DA \u05EA\u05E4\u05E2\u05D5\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA, \u05D0\u05DB\u05D9\u05E4\u05EA \u05EA\u05E0\u05D0\u05D9 \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D0\u05D5 \u05E2\u05DE\u05D9\u05D3\u05D4 \u05D1\u05D7\u05D5\u05D1\u05D5\u05EA \u05D7\u05D5\u05E7\u05D9\u05D5\u05EA (\u05DC\u05DE\u05E9\u05DC \u05D7\u05D5\u05D1\u05EA \u05E9\u05DE\u05D9\u05E8\u05EA \u05DE\u05E1\u05DE\u05DB\u05D9 \u05D7\u05E9\u05D1\u05D5\u05E0\u05D0\u05D5\u05EA \u05DC\u05E4\u05D9 \u05D3\u05E8\u05D9\u05E9\u05D5\u05EA \u05E8\u05E9\u05D5\u05EA \u05D4\u05DE\u05D9\u05E1\u05D9\u05DD).","\u05DC\u05D0\u05D7\u05E8 \u05DE\u05D7\u05D9\u05E7\u05EA \u05D7\u05E9\u05D1\u05D5\u05DF, \u05DE\u05D9\u05D3\u05E2 \u05DE\u05D6\u05D4\u05D4 \u05E0\u05DE\u05D7\u05E7 \u05D0\u05D5 \u05D4\u05D5\u05E4\u05DA \u05DC\u05D0\u05E0\u05D5\u05E0\u05D9\u05DE\u05D9 \u05EA\u05D5\u05DA \u05D6\u05DE\u05DF \u05E1\u05D1\u05D9\u05E8; \u05DE\u05D9\u05D3\u05E2 \u05DE\u05E6\u05E8\u05E4\u05D9 \u05E9\u05D0\u05D9\u05E0\u05D5 \u05DE\u05D6\u05D4\u05D4 \u05D0\u05D9\u05E9\u05D9\u05EA \u05E2\u05E9\u05D5\u05D9 \u05DC\u05D4\u05D9\u05E9\u05DE\u05E8 \u05DC\u05E6\u05D5\u05E8\u05DA \u05E0\u05D9\u05EA\u05D5\u05D7 \u05E9\u05D9\u05DE\u05D5\u05E9.","\u05DC\u05E2\u05D9\u05D9\u05DF \u05D1\u05DE\u05D9\u05D3\u05E2 \u05D4\u05E9\u05DE\u05D5\u05E8 \u05E2\u05DC\u05D9\u05DB\u05DD.","\u05DC\u05D1\u05E7\u05E9 \u05EA\u05D9\u05E7\u05D5\u05DF \u05E9\u05DC \u05E4\u05E8\u05D8 \u05E9\u05D0\u05D9\u05E0\u05D5 \u05DE\u05D3\u05D5\u05D9\u05E7.","\u05DC\u05D1\u05E7\u05E9 \u05DC\u05DE\u05D7\u05D5\u05E7 \u05D0\u05EA \u05D7\u05E9\u05D1\u05D5\u05E0\u05DB\u05DD \u05D5\u05D0\u05EA \u05D4\u05DE\u05D9\u05D3\u05E2 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05D4\u05DE\u05D6\u05D5\u05D4\u05D4 \u05E2\u05DC\u05D9\u05DB\u05DD.","\u05DC\u05D4\u05EA\u05E0\u05D2\u05D3 \u05DC\u05E9\u05D9\u05DE\u05D5\u05E9 \u05DE\u05E1\u05D5\u05D9\u05DD \u05D1\u05DE\u05D9\u05D3\u05E2, \u05DB\u05DB\u05DC \u05E9\u05D4\u05D3\u05D1\u05E8 \u05D0\u05E4\u05E9\u05E8\u05D9 \u05EA\u05E4\u05E2\u05D5\u05DC\u05D9\u05EA.","Supabase \u2013 \u05D0\u05D7\u05E1\u05D5\u05DF \u05E0\u05EA\u05D5\u05E0\u05D9 \u05D4\u05DE\u05E9\u05EA\u05DE\u05E9 \u05D5\u05D1\u05E1\u05D9\u05E1 \u05D4\u05E0\u05EA\u05D5\u05E0\u05D9\u05DD.","Vercel \u2013 \u05D0\u05D7\u05E1\u05D5\u05DF \u05D0\u05EA\u05E8 \u05D5\u05E9\u05E8\u05EA\u05D9 \u05D4\u05D0\u05E4\u05DC\u05D9\u05E7\u05E6\u05D9\u05D4.","Cloudflare \u2013 \u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05E8\u05E9\u05EA \u05D5\u05D0\u05D1\u05D8\u05D7\u05D4.","Stripe \u05D5\u05BECardcom \u2013 \u05E1\u05DC\u05D9\u05E7\u05EA \u05EA\u05E9\u05DC\u05D5\u05DE\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3; \u05E4\u05E8\u05D8\u05D9 \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D4\u05D0\u05E9\u05E8\u05D0\u05D9 \u05D0\u05D9\u05E0\u05DD \u05DE\u05D5\u05E2\u05D1\u05E8\u05D9\u05DD \u05D0\u05DC\u05D9\u05E0\u05D5.","Brevo \u2013 \u05E9\u05DC\u05D9\u05D7\u05EA \u05DE\u05D9\u05D9\u05DC\u05D9\u05DD \u05EA\u05E4\u05E2\u05D5\u05DC\u05D9\u05D9\u05DD (\u05D0\u05D9\u05E9\u05D5\u05E8\u05D9 \u05D7\u05E9\u05D1\u05D5\u05DF, \u05D0\u05D9\u05E4\u05D5\u05E1 \u05E1\u05D9\u05E1\u05DE\u05D4, \u05D4\u05EA\u05E8\u05D0\u05D5\u05EA \u05D7\u05E9\u05D1\u05D5\u05DF).","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD \u05D1\u05E2\u05D5\u05D2\u05D9\u05D5\u05EA \u05DB\u05D3\u05D9 \u05DC\u05D6\u05DB\u05D5\u05E8 \u05D0\u05EA \u05E9\u05E4\u05EA \u05D4\u05DE\u05E9\u05EA\u05DE\u05E9, \u05DC\u05E9\u05DE\u05D5\u05E8 \u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA, \u05D5\u05DC\u05DE\u05D3\u05D5\u05D3 \u05E9\u05D9\u05DE\u05D5\u05E9 \u05DE\u05E6\u05E8\u05E4\u05D9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA. \u05E0\u05D9\u05EA\u05DF \u05DC\u05D7\u05E1\u05D5\u05DD \u05E2\u05D5\u05D2\u05D9\u05D5\u05EA \u05D1\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05D4\u05D3\u05E4\u05D3\u05E4\u05DF, \u05D0\u05DA \u05D4\u05D3\u05D1\u05E8 \u05E2\u05DC\u05D5\u05DC \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05D7\u05D5\u05D5\u05D9\u05D9\u05EA \u05D4\u05E9\u05D9\u05DE\u05D5\u05E9.","\u05E4\u05E8\u05D8\u05D9 \u05D7\u05E9\u05D1\u05D5\u05DF: \u05E9\u05DD \u05DE\u05DC\u05D0, \u05DB\u05EA\u05D5\u05D1\u05EA \u05D0\u05D9\u05DE\u05D9\u05D9\u05DC, \u05E9\u05E4\u05D4 \u05DE\u05D5\u05E2\u05D3\u05E4\u05EA \u05D5\u05DE\u05D3\u05D9\u05E0\u05D4.","\u05E4\u05E8\u05D8\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD: \u05D4\u05EA\u05E9\u05DC\u05D5\u05DE\u05D9\u05DD \u05E0\u05E1\u05DC\u05E7\u05D9\u05DD \u05E2\u05DC \u05D9\u05D3\u05D9 \u05E9\u05E2\u05E8\u05D9 \u05D4\u05E1\u05DC\u05D9\u05E7\u05D4 Stripe \u05D5\u05BECardcom. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E9\u05D5\u05DE\u05E8\u05D9\u05DD \u05D0\u05E6\u05DC\u05E0\u05D5 \u05D0\u05EA \u05E4\u05E8\u05D8\u05D9 \u05DB\u05E8\u05D8\u05D9\u05E1 \u05D4\u05D0\u05E9\u05E8\u05D0\u05D9 \u05E9\u05DC\u05DB\u05DD, \u05D0\u05DC\u05D0 \u05E8\u05E7 \u05DE\u05D6\u05D4\u05D4 \u05E2\u05E1\u05E7\u05D4 \u05D5\u05E4\u05E8\u05D8\u05D9 \u05D7\u05E9\u05D1\u05D5\u05E0\u05D9\u05EA.","\u05E4\u05E2\u05D9\u05DC\u05D5\u05EA \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA: \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05E6\u05E4\u05D9\u05EA\u05DD \u05D1\u05D4\u05DD, \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05E9\u05E1\u05D9\u05DE\u05E0\u05EA\u05DD, \u05EA\u05D0\u05E8\u05D9\u05DB\u05D9 \u05DB\u05E0\u05D9\u05E1\u05D4 \u05D5\u05E4\u05E2\u05D9\u05DC\u05D5\u05EA \u05D0\u05D2\u05E8\u05D2\u05D8\u05D9\u05D1\u05D9\u05EA.","\u05DE\u05D9\u05D3\u05E2 \u05D8\u05DB\u05E0\u05D9: \u05DB\u05EA\u05D5\u05D1\u05EA IP, \u05E1\u05D5\u05D2 \u05D3\u05E4\u05D3\u05E4\u05DF, \u05DE\u05E2\u05E8\u05DB\u05EA \u05D4\u05E4\u05E2\u05DC\u05D4, \u05DE\u05D6\u05D4\u05D9 \u05DE\u05DB\u05E9\u05D9\u05E8 \u05D0\u05E0\u05D5\u05E0\u05D9\u05DE\u05D9\u05D9\u05DD \u05D5\u05D4\u05D2\u05D3\u05E8\u05D5\u05EA \u05E9\u05E4\u05D4.","\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D6\u05D5 \u05D0\u05D9\u05E0\u05D4 \u05D2\u05D5\u05E8\u05E2\u05EA \u05DE\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05E6\u05E8\u05DB\u05E0\u05D9\u05D5\u05EA \u05DE\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA \u05DC\u05E4\u05D9 \u05D7\u05D5\u05E7 \u05D4\u05D2\u05E0\u05EA \u05D4\u05E6\u05E8\u05DB\u05DF, \u05D4\u05EA\u05E9\u05DE\u05F4\u05D0\u05BE1981 \u05D5\u05EA\u05E7\u05E0\u05D5\u05EA\u05D9\u05D5, \u05DB\u05DB\u05DC \u05E9\u05D4\u05DF \u05D7\u05DC\u05D5\u05EA \u05E2\u05DC\u05D9\u05DB\u05DD. \u05D0\u05DD \u05D0\u05EA\u05DD \u05E1\u05D1\u05D5\u05E8\u05D9\u05DD \u05E9\u05D0\u05EA\u05DD \u05D6\u05DB\u05D0\u05D9\u05DD \u05DC\u05D4\u05D7\u05D6\u05E8 \u05E2\u05DC \u05E4\u05D9 \u05D3\u05D9\u05DF \u2013 \u05E4\u05E0\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D5\u05E0\u05D1\u05D7\u05DF \u05D0\u05EA \u05D4\u05E4\u05E0\u05D9\u05D9\u05D4 \u05DC\u05D2\u05D5\u05E4\u05D4.","\u05D0\u05DD \u05E0\u05E8\u05D0\u05D4 \u05DC\u05DB\u05DD \u05E9\u05D7\u05D5\u05D9\u05D1\u05EA\u05DD \u05D1\u05D8\u05E2\u05D5\u05EA (\u05D7\u05D9\u05D5\u05D1 \u05DB\u05E4\u05D5\u05DC, \u05E1\u05DB\u05D5\u05DD \u05E9\u05D2\u05D5\u05D9, \u05D7\u05D9\u05D5\u05D1 \u05DC\u05D0\u05D7\u05E8 \u05D1\u05D9\u05D8\u05D5\u05DC \u05D5\u05DB\u05D3\u05D5\u05DE\u05D4) \u2013 \u05D6\u05D5 \u05DC\u05D0 \u05D1\u05E7\u05E9\u05EA \u05D4\u05D7\u05D6\u05E8 \u05D0\u05DC\u05D0 \u05D1\u05D9\u05E8\u05D5\u05E8 \u05D7\u05D9\u05D5\u05D1, \u05D5\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DB\u05D0\u05DF \u05DB\u05D3\u05D9 \u05DC\u05D8\u05E4\u05DC \u05D1\u05D6\u05D4.","\u05E4\u05E0\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D9\u05DC mioshyoffice@gmail.com \u05E2\u05DD \u05E4\u05E8\u05D8\u05D9 \u05D4\u05D7\u05D9\u05D5\u05D1, \u05D5\u05E0\u05D7\u05D6\u05D5\u05E8 \u05D0\u05DC\u05D9\u05DB\u05DD \u05D1\u05EA\u05D5\u05DA 5 \u05D9\u05DE\u05D9 \u05E2\u05E1\u05E7\u05D9\u05DD. \u05D1\u05DE\u05D9\u05D3\u05D4 \u05D5\u05D0\u05DB\u05DF \u05E0\u05DE\u05E6\u05D0\u05D4 \u05E9\u05D2\u05D9\u05D0\u05D4 \u2013 \u05E0\u05D6\u05DB\u05D4 \u05D0\u05EA \u05D4\u05E1\u05DB\u05D5\u05DD \u05D4\u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9.","\u05D1\u05DB\u05DC \u05E8\u05D2\u05E2 \u05E0\u05D9\u05EA\u05DF \u05DC\u05D1\u05D8\u05DC \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9 \u05D3\u05E8\u05DA \u05E2\u05DE\u05D5\u05D3 \u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD (\u05F4\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9\u05F4 \u2192 \u05F4\u05D7\u05E9\u05D1\u05D5\u05DF\u05F4). \u05D4\u05D1\u05D9\u05D8\u05D5\u05DC:","\u2022 \u05E2\u05D5\u05E6\u05E8 \u05D0\u05EA \u05D4\u05D7\u05D9\u05D5\u05D1 \u05D4\u05EA\u05E7\u05D5\u05E4\u05EA\u05D9 \u05D4\u05D1\u05D0 \u05D5\u05DE\u05D5\u05E0\u05E2 \u05D7\u05D9\u05D5\u05D1\u05D9\u05DD \u05E0\u05D5\u05E1\u05E4\u05D9\u05DD.","\u2022 \u05D0\u05D9\u05E0\u05D5 \u05DE\u05D6\u05DB\u05D4 \u05D1\u05D4\u05D7\u05D6\u05E8 \u05E2\u05DC \u05EA\u05E9\u05DC\u05D5\u05DD \u05E7\u05D5\u05D3\u05DD \u05E9\u05DB\u05D1\u05E8 \u05D1\u05D5\u05E6\u05E2.","\u2022 \u05DE\u05E9\u05D0\u05D9\u05E8 \u05D0\u05EA \u05D4\u05D2\u05D9\u05E9\u05D4 \u05DC\u05EA\u05DB\u05E0\u05D9 \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E4\u05E2\u05D9\u05DC\u05D4 \u05E2\u05D3 \u05EA\u05D5\u05DD \u05EA\u05E7\u05D5\u05E4\u05EA \u05D4\u05D7\u05D9\u05D5\u05D1 \u05D4\u05E0\u05D5\u05DB\u05D7\u05D9\u05EA.","\u05D1\u05E8\u05D2\u05E2 \u05E9\u05D4\u05EA\u05E9\u05DC\u05D5\u05DD \u05D0\u05D5\u05E9\u05E8, \u05D4\u05EA\u05D5\u05DB\u05DF \u05E0\u05E4\u05EA\u05D7 \u05DC\u05E6\u05E4\u05D9\u05D9\u05D4 \u05D5\u05DC\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05D7\u05E9\u05D1\u05D5\u05E0\u05DB\u05DD. \u05D1\u05E0\u05D9\u05D2\u05D5\u05D3 \u05DC\u05DE\u05D5\u05E6\u05E8 \u05E4\u05D9\u05D6\u05D9 \u05E9\u05E0\u05D9\u05EA\u05DF \u05DC\u05D4\u05D7\u05D6\u05D9\u05E8 \u05D1\u05D0\u05E8\u05D9\u05D6\u05D4 \u05E1\u05D2\u05D5\u05E8\u05D4, \u05EA\u05D5\u05DB\u05DF \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9 \u05DC\u05D0 \u05E0\u05D9\u05EA\u05DF \u05F4\u05DC\u05D4\u05D7\u05D6\u05D9\u05E8\u05F4 \u05D1\u05D0\u05DE\u05EA \u2013 \u05D5\u05DC\u05DB\u05DF \u05D4\u05DE\u05D5\u05D3\u05DC \u05E9\u05DC\u05E0\u05D5 \u05D4\u05D5\u05D0 \u05E9\u05DC \u05D1\u05D9\u05D8\u05D5\u05DC \u05E2\u05EA\u05D9\u05D3\u05D9, \u05DC\u05D0 \u05D4\u05D7\u05D6\u05E8 \u05E8\u05D8\u05E8\u05D5\u05D0\u05E7\u05D8\u05D9\u05D1\u05D9.","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DE\u05D5\u05DB\u05E8\u05EA \u05EA\u05D5\u05DB\u05DF \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9 \u05D4\u05D6\u05DE\u05D9\u05DF \u05D1\u05D0\u05D5\u05E4\u05DF \u05DE\u05D9\u05D9\u05D3\u05D9 \u05DC\u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05D0\u05D7\u05E8 \u05D4\u05EA\u05E9\u05DC\u05D5\u05DD. \u05DC\u05DB\u05DF, \u05D5\u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05E4\u05E8\u05E7\u05D8\u05D9\u05E7\u05D4 \u05D4\u05DE\u05E7\u05D5\u05D1\u05DC\u05EA \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9\u05D9\u05DD: \u05DC\u05D0 \u05D9\u05D9\u05E0\u05EA\u05E0\u05D5 \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD \u05DB\u05E1\u05E4\u05D9\u05D9\u05DD \u05E2\u05DC \u05DE\u05E0\u05D5\u05D9\u05D9\u05DD, \u05E8\u05DB\u05D9\u05E9\u05D5\u05EA \u05D7\u05D3\u05BE\u05E4\u05E2\u05DE\u05D9\u05D5\u05EA \u05D0\u05D5 \u05DB\u05DC \u05EA\u05D5\u05DB\u05DF \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9 \u05E9\u05E0\u05DE\u05E1\u05E8 \u05DC\u05D7\u05E9\u05D1\u05D5\u05E0\u05DB\u05DD \u2013 \u05DC\u05D0\u05D7\u05E8 \u05D1\u05D9\u05E6\u05D5\u05E2 \u05D4\u05EA\u05E9\u05DC\u05D5\u05DD.","\u05DC\u05DB\u05DC \u05E9\u05D0\u05DC\u05D4, \u05E4\u05E0\u05D9\u05D9\u05D4 \u05D0\u05D5 \u05D3\u05D9\u05D5\u05D5\u05D7 \u05E2\u05DC \u05D4\u05E4\u05E8\u05EA \u05EA\u05E0\u05D0\u05D9\u05DD \u2013 \u05E0\u05D9\u05EA\u05DF \u05DC\u05E4\u05E0\u05D5\u05EA \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D1\u05DE\u05D9\u05D9\u05DC: mioshyoffice@gmail.com. \u05E0\u05E9\u05EA\u05D3\u05DC \u05DC\u05D4\u05E9\u05D9\u05D1 \u05D1\u05EA\u05D5\u05DA 14 \u05D9\u05DE\u05D9 \u05E2\u05E1\u05E7\u05D9\u05DD.","\u05D0\u05D9\u05DF \u05D1\u05D0\u05DE\u05D5\u05E8 \u05D1\u05EA\u05E0\u05D0\u05D9\u05DD \u05D0\u05DC\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D2\u05E8\u05D5\u05E2 \u05DE\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05E6\u05E8\u05DB\u05E0\u05D9\u05D5\u05EA \u05DE\u05D7\u05D9\u05D9\u05D1\u05D5\u05EA \u05E2\u05DC \u05E4\u05D9 \u05D4\u05D3\u05D9\u05DF \u05D4\u05D9\u05E9\u05E8\u05D0\u05DC\u05D9, \u05DB\u05DB\u05DC \u05E9\u05D4\u05DF \u05D7\u05DC\u05D5\u05EA \u05E2\u05DC\u05D9\u05DB\u05DD, \u05DC\u05E8\u05D1\u05D5\u05EA \u05DC\u05E4\u05D9 \u05D7\u05D5\u05E7 \u05D4\u05D2\u05E0\u05EA \u05D4\u05E6\u05E8\u05DB\u05DF, \u05D4\u05EA\u05E9\u05DE\u05F4\u05D0\u05BE1981 \u05D5\u05EA\u05E7\u05E0\u05D5\u05EA\u05D9\u05D5.","\u05EA\u05E0\u05D0\u05D9\u05DD \u05D0\u05DC\u05D4 \u05DB\u05E4\u05D5\u05E4\u05D9\u05DD \u05DC\u05D3\u05D9\u05E0\u05D9 \u05DE\u05D3\u05D9\u05E0\u05EA \u05D9\u05E9\u05E8\u05D0\u05DC. \u05DB\u05DC \u05DE\u05D7\u05DC\u05D5\u05E7\u05EA \u05D4\u05E0\u05D5\u05D1\u05E2\u05EA \u05DE\u05EA\u05E0\u05D0\u05D9\u05DD \u05D0\u05DC\u05D4 \u05D0\u05D5 \u05DE\u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05EA\u05D9\u05D3\u05D5\u05DF \u05D1\u05D0\u05D5\u05E4\u05DF \u05D1\u05DC\u05E2\u05D3\u05D9 \u05D1\u05D1\u05EA\u05D9 \u05D4\u05DE\u05E9\u05E4\u05D8 \u05D4\u05DE\u05D5\u05E1\u05DE\u05DB\u05D9\u05DD \u05D1\u05EA\u05DC \u05D0\u05D1\u05D9\u05D1\u05BE\u05D9\u05E4\u05D5, \u05D9\u05E9\u05E8\u05D0\u05DC, \u05D1\u05DC\u05D1\u05D3.","\u05D0\u05E0\u05D5 \u05E8\u05E9\u05D0\u05D9\u05DD \u05DC\u05E2\u05D3\u05DB\u05DF \u05D0\u05EA \u05D4\u05EA\u05E0\u05D0\u05D9\u05DD \u05DE\u05E2\u05EA \u05DC\u05E2\u05EA. \u05D4\u05D2\u05E8\u05E1\u05D4 \u05D4\u05E2\u05D3\u05DB\u05E0\u05D9\u05EA \u05EA\u05E4\u05D5\u05E8\u05E1\u05DD \u05EA\u05DE\u05D9\u05D3 \u05D1\u05E2\u05DE\u05D5\u05D3 \u05D6\u05D4 \u05E2\u05DD \u05EA\u05D0\u05E8\u05D9\u05DA \u05E2\u05D3\u05DB\u05D5\u05DF. \u05D4\u05DE\u05E9\u05DA \u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05DC\u05D0\u05D7\u05E8 \u05E4\u05E8\u05E1\u05D5\u05DD \u05D4\u05E9\u05D9\u05E0\u05D5\u05D9\u05D9\u05DD \u05DE\u05D4\u05D5\u05D5\u05D4 \u05D4\u05E1\u05DB\u05DE\u05D4 \u05DC\u05D4\u05DD.","\u05E4\u05D2\u05D9\u05E2\u05D4 \u05D1\u05E7\u05D8\u05D9\u05E0\u05D9\u05DD, \u05D4\u05E6\u05D2\u05EA \u05EA\u05D5\u05DB\u05DF \u05D1\u05E4\u05E0\u05D9 \u05E7\u05D8\u05D9\u05E0\u05D9\u05DD \u05D0\u05D5 \u05D9\u05E6\u05D9\u05E8\u05EA \u05D7\u05E9\u05D1\u05D5\u05DF \u05E2\u05DC \u05D9\u05D3\u05D9 \u05E7\u05D8\u05D9\u05DF.","\u05E9\u05D9\u05EA\u05D5\u05E3 \u05D7\u05E9\u05D1\u05D5\u05E0\u05D5\u05EA, \u05D4\u05EA\u05D7\u05D6\u05D5\u05EA, \u05D0\u05D5 \u05E0\u05D9\u05E1\u05D9\u05D5\u05DF \u05DC\u05E2\u05E7\u05D5\u05E3 \u05DE\u05E0\u05D2\u05E0\u05D5\u05E0\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD \u05D0\u05D5 \u05D4\u05E8\u05E9\u05D0\u05D4.","\u05E0\u05D9\u05E1\u05D9\u05D5\u05DF \u05DC\u05E4\u05E8\u05D5\u05E5, \u05DC\u05D1\u05E6\u05E2 \u05D4\u05E0\u05D3\u05E1\u05D4 \u05DC\u05D0\u05D7\u05D5\u05E8, \u05DC\u05D4\u05E8\u05D9\u05E5 \u05E1\u05E7\u05E8\u05D9\u05E4\u05D8\u05D9\u05DD \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05D9\u05DD \u05D0\u05D5 \u05DC\u05D4\u05D5\u05E8\u05D9\u05D3 \u05EA\u05D5\u05DB\u05DF \u05D1\u05DB\u05DE\u05D5\u05D9\u05D5\u05EA.","\u05E4\u05E8\u05E1\u05D5\u05DD \u05EA\u05DB\u05E0\u05D9\u05DD \u05E4\u05D5\u05D2\u05E2\u05E0\u05D9\u05D9\u05DD, \u05DE\u05D0\u05D9\u05D9\u05DE\u05D9\u05DD, \u05D2\u05D6\u05E2\u05E0\u05D9\u05D9\u05DD \u05D0\u05D5 \u05D1\u05DC\u05EA\u05D9 \u05D7\u05D5\u05E7\u05D9\u05D9\u05DD \u05D3\u05E8\u05DA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA.","\u05DB\u05DC \u05E9\u05D9\u05DE\u05D5\u05E9 \u05E9\u05DE\u05D8\u05E8\u05EA\u05D5 \u05DC\u05E4\u05D2\u05D5\u05E2 \u05D1\u05D7\u05D1\u05E8\u05D4, \u05D1\u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DD \u05D0\u05D5 \u05D1\u05E6\u05D3\u05D3\u05D9\u05DD \u05E9\u05DC\u05D9\u05E9\u05D9\u05D9\u05DD.","\u05DB\u05DC \u05D4\u05EA\u05DB\u05E0\u05D9\u05DD \u05D1\u05D0\u05EA\u05E8 \u2013 \u05DC\u05E8\u05D1\u05D5\u05EA \u05E9\u05D0\u05DC\u05D5\u05EA, \u05D0\u05EA\u05D2\u05E8\u05D9\u05DD, \u05D2\u05E8\u05E4\u05D9\u05E7\u05D4, \u05E2\u05D9\u05E6\u05D5\u05D1, \u05E7\u05D5\u05D3, \u05E1\u05D9\u05DE\u05E0\u05D9 \u05DE\u05E1\u05D7\u05E8 \u05D5\u05E9\u05DE\u05D5\u05EA \u05DE\u05E1\u05D7\u05E8\u05D9\u05D9\u05DD \u2013 \u05D4\u05DD \u05E8\u05DB\u05D5\u05E9\u05D4 \u05D4\u05D1\u05DC\u05E2\u05D3\u05D9 \u05E9\u05DC \u05D1\u05D5\u05D2\u05D5 \u05DE\u05D3\u05D9\u05D4 \u05D1\u05E2\u05F4\u05DE \u05D0\u05D5 \u05E9\u05DC \u05D1\u05E2\u05DC\u05D9 \u05D4\u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05D1\u05D4\u05DD, \u05D5\u05DE\u05D5\u05D2\u05E0\u05D9\u05DD \u05D1\u05D3\u05D9\u05E0\u05D9 \u05D6\u05DB\u05D5\u05D9\u05D5\u05EA \u05D9\u05D5\u05E6\u05E8\u05D9\u05DD.","\u05D0\u05E1\u05D5\u05E8 \u05DC\u05D4\u05E2\u05EA\u05D9\u05E7, \u05DC\u05D4\u05E4\u05D9\u05E5, \u05DC\u05E4\u05E8\u05E1\u05DD, \u05DC\u05EA\u05E8\u05D2\u05DD, \u05DC\u05E2\u05E8\u05D5\u05DA \u05E0\u05D2\u05D6\u05E8\u05D5\u05EA \u05D0\u05D5 \u05DC\u05E2\u05E9\u05D5\u05EA \u05DB\u05DC \u05E9\u05D9\u05DE\u05D5\u05E9 \u05DE\u05E1\u05D7\u05E8\u05D9 \u05D1\u05EA\u05DB\u05E0\u05D9\u05DD, \u05D0\u05DC\u05D0 \u05D1\u05D0\u05D9\u05E9\u05D5\u05E8 \u05DE\u05E4\u05D5\u05E8\u05E9 \u05D1\u05DB\u05EA\u05D1 \u05DE\u05D4\u05D7\u05D1\u05E8\u05D4.","\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05DE\u05E1\u05D5\u05E4\u05E7 \u05F4\u05DB\u05E4\u05D9 \u05E9\u05D4\u05D5\u05D0\u05F4 (AS-IS) \u05D5\u05DC\u05DC\u05D0 \u05D0\u05D7\u05E8\u05D9\u05D5\u05EA \u05DE\u05DB\u05DC \u05E1\u05D5\u05D2 \u05E9\u05D4\u05D5\u05D0, \u05DE\u05E4\u05D5\u05E8\u05E9\u05EA \u05D0\u05D5 \u05DE\u05E9\u05EA\u05DE\u05E2\u05EA. \u05D0\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05EA\u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05E9\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05D9\u05D4\u05D9\u05D4 \u05D6\u05DE\u05D9\u05DF \u05D1\u05E8\u05E6\u05D9\u05E4\u05D5\u05EA, \u05E0\u05D8\u05D5\u05DC \u05E9\u05D2\u05D9\u05D0\u05D5\u05EA \u05D0\u05D5 \u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DC \u05DE\u05D8\u05E8\u05D4.","\u05D0\u05D7\u05E8\u05D9\u05D5\u05EA\u05E0\u05D5 \u05D4\u05DB\u05D5\u05DC\u05DC\u05EA \u05DB\u05DC\u05E4\u05D9\u05DA \u05D1\u05D2\u05D9\u05DF \u05DB\u05DC \u05EA\u05D1\u05D9\u05E2\u05D4 \u05D4\u05E0\u05D5\u05D1\u05E2\u05EA \u05DE\u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05D0 \u05EA\u05E2\u05DC\u05D4 \u05E2\u05DC \u05D4\u05E1\u05DB\u05D5\u05DD \u05D4\u05DB\u05D5\u05DC\u05DC \u05E9\u05E9\u05D9\u05DC\u05DE\u05EA \u05DC\u05E0\u05D5 \u05D1\u05BE12 \u05D4\u05D7\u05D5\u05D3\u05E9\u05D9\u05DD \u05E9\u05E7\u05D3\u05DE\u05D5 \u05DC\u05D4\u05D2\u05E9\u05EA \u05D4\u05EA\u05D1\u05D9\u05E2\u05D4.","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D0\u05D9\u05E0\u05D4 \u05DE\u05D4\u05D5\u05D5\u05D4 \u05EA\u05D7\u05DC\u05D9\u05E3 \u05DC\u05D8\u05D9\u05E4\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9 \u05DE\u05E7\u05E6\u05D5\u05E2\u05D9, \u05DC\u05D9\u05D9\u05E2\u05D5\u05E5 \u05E4\u05E1\u05D9\u05DB\u05D5\u05DC\u05D5\u05D2\u05D9 \u05D0\u05D5 \u05DC\u05D8\u05D9\u05E4\u05D5\u05DC \u05E8\u05E4\u05D5\u05D0\u05D9. \u05D0\u05DD \u05D0\u05EA\u05DD \u05E0\u05DE\u05E6\u05D0\u05D9\u05DD \u05D1\u05DE\u05E6\u05D5\u05E7\u05D4 \u05E8\u05D2\u05E9\u05D9\u05EA, \u05E4\u05E0\u05D5 \u05DC\u05D0\u05D9\u05E9 \u05DE\u05E7\u05E6\u05D5\u05E2 \u05DE\u05D5\u05E1\u05DE\u05DA.","\u05D1\u05D0\u05E4\u05E9\u05E8\u05D5\u05EA\u05DA \u05DC\u05D1\u05D8\u05DC \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9 \u05D1\u05DB\u05DC \u05E2\u05EA \u05D3\u05E8\u05DA \u05E2\u05DE\u05D5\u05D3 \u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DA. \u05D4\u05D1\u05D9\u05D8\u05D5\u05DC \u05E2\u05D5\u05E6\u05E8 \u05D7\u05D9\u05D5\u05D1\u05D9\u05DD \u05E2\u05EA\u05D9\u05D3\u05D9\u05D9\u05DD \u05D0\u05DA \u05D0\u05D9\u05E0\u05D5 \u05DE\u05D6\u05DB\u05D4 \u05D1\u05D4\u05D7\u05D6\u05E8 \u05E2\u05D1\u05D5\u05E8 \u05EA\u05E9\u05DC\u05D5\u05DE\u05D9\u05DD \u05E9\u05DB\u05D1\u05E8 \u05D1\u05D5\u05E6\u05E2\u05D5.","\u05DC\u05D0\u05D7\u05E8 \u05D4\u05D1\u05D9\u05D8\u05D5\u05DC \u05EA\u05D5\u05DB\u05DC \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA \u05E2\u05D3 \u05EA\u05D5\u05DD \u05EA\u05E7\u05D5\u05E4\u05EA \u05D4\u05D7\u05D9\u05D5\u05D1 \u05D4\u05E0\u05D5\u05DB\u05D7\u05D9\u05EA, \u05D5\u05DC\u05D0\u05D7\u05E8 \u05DE\u05DB\u05DF \u05D4\u05D2\u05D9\u05E9\u05D4 \u05DC\u05EA\u05DB\u05E0\u05D9 \u05D4\u05DE\u05E0\u05D5\u05D9 \u05EA\u05D9\u05D7\u05E1\u05DD.","\u05DB\u05DC \u05D4\u05DE\u05DB\u05D9\u05E8\u05D5\u05EA \u05D4\u05DF \u05E1\u05D5\u05E4\u05D9\u05D5\u05EA. \u05DC\u05D0\u05D7\u05E8 \u05D1\u05D9\u05E6\u05D5\u05E2 \u05D4\u05EA\u05E9\u05DC\u05D5\u05DD \u05DC\u05D0 \u05D9\u05D9\u05E0\u05EA\u05E0\u05D5 \u05D4\u05D7\u05D6\u05E8\u05D9\u05DD \u05DB\u05E1\u05E4\u05D9\u05D9\u05DD, \u05DC\u05E8\u05D1\u05D5\u05EA \u05E2\u05D1\u05D5\u05E8 \u05DE\u05E0\u05D5\u05D9\u05D9\u05DD, \u05E8\u05DB\u05D9\u05E9\u05D5\u05EA \u05D7\u05D3\u05BE\u05E4\u05E2\u05DE\u05D9\u05D5\u05EA, \u05E7\u05E8\u05D3\u05D9\u05D8\u05D9\u05DD \u05D1\u05EA\u05D5\u05DA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D0\u05D5 \u05DB\u05DC \u05EA\u05D5\u05DB\u05DF \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9 \u05E9\u05E0\u05DE\u05E1\u05E8 \u05DC\u05D7\u05E9\u05D1\u05D5\u05E0\u05DA.","\u05D4\u05DE\u05D7\u05D9\u05E8\u05D9\u05DD \u05DE\u05D5\u05E6\u05D2\u05D9\u05DD \u05DB\u05D5\u05DC\u05DC\u05D9\u05DD \u05DE\u05E2\u05F4\u05DE \u05DB\u05D7\u05D5\u05E7 \u05D1\u05DE\u05E7\u05E8\u05D4 \u05E9\u05DC \u05E8\u05DB\u05D9\u05E9\u05D4 \u05DE\u05DE\u05D3\u05D9\u05E0\u05EA \u05D9\u05E9\u05E8\u05D0\u05DC. \u05D1\u05DE\u05D3\u05D9\u05E0\u05D5\u05EA \u05D0\u05D7\u05E8\u05D5\u05EA \u05D9\u05D5\u05E6\u05D2\u05D5 \u05D4\u05DE\u05D7\u05D9\u05E8\u05D9\u05DD \u05D1\u05D4\u05EA\u05D0\u05DD \u05DC\u05D7\u05D5\u05E7\u05D9 \u05D4\u05DE\u05E1 \u05D4\u05DE\u05E7\u05D5\u05DE\u05D9\u05D9\u05DD.","\u05E4\u05EA\u05D9\u05D7\u05EA \u05D7\u05E9\u05D1\u05D5\u05DF \u05DE\u05D7\u05D9\u05D9\u05D1\u05EA \u05DE\u05EA\u05DF \u05E4\u05E8\u05D8\u05D9\u05DD \u05E0\u05DB\u05D5\u05E0\u05D9\u05DD \u05D5\u05DE\u05D3\u05D5\u05D9\u05E7\u05D9\u05DD. \u05D0\u05EA\u05DD \u05D0\u05D7\u05E8\u05D0\u05D9\u05DD \u05E2\u05DC \u05E9\u05DE\u05D9\u05E8\u05EA \u05E4\u05E8\u05D8\u05D9 \u05D4\u05DB\u05E0\u05D9\u05E1\u05D4 \u05E9\u05DC\u05DB\u05DD, \u05E2\u05DC \u05D4\u05E4\u05E2\u05D9\u05DC\u05D5\u05EA \u05D1\u05D7\u05E9\u05D1\u05D5\u05E0\u05DB\u05DD \u05D5\u05E2\u05DC \u05D0\u05D1\u05D8\u05D7\u05EA \u05D4\u05E1\u05D9\u05E1\u05DE\u05D4.","\u05D0\u05E1\u05D5\u05E8 \u05DC\u05D4\u05E2\u05D1\u05D9\u05E8 \u05D7\u05E9\u05D1\u05D5\u05DF \u05DC\u05D0\u05D3\u05DD \u05D0\u05D7\u05E8, \u05DC\u05E9\u05EA\u05E3 \u05D0\u05D5\u05EA\u05D5 \u05E2\u05DD \u05E6\u05D3 \u05E9\u05DC\u05D9\u05E9\u05D9 \u05E9\u05D0\u05D9\u05E0\u05D5 \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05E9\u05DC\u05DB\u05DD, \u05D0\u05D5 \u05DC\u05DE\u05DB\u05D5\u05E8 \u05D2\u05D9\u05E9\u05D4 \u05D0\u05DC\u05D9\u05D5.","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DE\u05E1\u05E4\u05E7\u05EA \u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9\u05D9\u05DD, \u05EA\u05DB\u05E0\u05D9\u05DD \u05D5\u05EA\u05D4\u05DC\u05D9\u05DB\u05D9 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05D1\u05D6\u05DB\u05D5\u05EA \u05DE\u05E0\u05D5\u05D9 \u05D0\u05D5 \u05E8\u05DB\u05D9\u05E9\u05D4 \u05D7\u05D3\u05BE\u05E4\u05E2\u05DE\u05D9\u05EA. \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05D6\u05DE\u05D9\u05DF \u05D3\u05E8\u05DA \u05D3\u05E4\u05D3\u05E4\u05DF \u05D5\u05DE\u05DE\u05E9\u05E7 \u05D0\u05D9\u05E0\u05D8\u05E8\u05E0\u05D8\u05D9 \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA \u05D5\u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA.","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF: \u05D2\u05DC\u05D2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9 \u05D5\u05E2\u05D5\u05D3.","\u05EA\u05D5\u05DB\u05DF \u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3 \u05D4\u05D6\u05DE\u05D9\u05DF \u05D1\u05DE\u05E0\u05D5\u05D9 \u05D4\u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9.","\u05DE\u05E1\u05E2 \u05D0\u05D9\u05E9\u05D9 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05D4\u05DB\u05D5\u05DC\u05DC \u05D0\u05D1\u05D7\u05D5\u05DF \u05D5\u05EA\u05DB\u05E0\u05D9 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05DC\u05D0\u05D5\u05E8\u05DA \u05D6\u05DE\u05DF.","\u05D4\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05D0\u05EA\u05E8 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9, \u05D1\u05E8\u05DB\u05D9\u05E9\u05EA \u05DE\u05E0\u05D5\u05D9, \u05D1\u05D4\u05D5\u05E8\u05D3\u05EA \u05EA\u05D5\u05DB\u05DF \u05D0\u05D5 \u05D1\u05D4\u05EA\u05D7\u05D1\u05E8\u05D5\u05EA \u05D1\u05D0\u05DE\u05E6\u05E2\u05D5\u05EA \u05D7\u05E9\u05D1\u05D5\u05DF \u05DE\u05E9\u05EA\u05DE\u05E9, \u05DE\u05D4\u05D5\u05D5\u05D4 \u05D4\u05E1\u05DB\u05DE\u05D4 \u05DE\u05DC\u05D0\u05D4 \u05D5\u05D1\u05DC\u05EA\u05D9 \u05D7\u05D5\u05D6\u05E8\u05EA \u05DC\u05EA\u05E0\u05D0\u05D9 \u05E9\u05D9\u05DE\u05D5\u05E9 \u05D0\u05DC\u05D4 \u05D5\u05DC\u05DE\u05D3\u05D9\u05E0\u05D9\u05D5\u05EA \u05D4\u05E4\u05E8\u05D8\u05D9\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5. \u05D0\u05DD \u05D0\u05D9\u05E0\u05DB\u05DD \u05DE\u05E1\u05DB\u05D9\u05DE\u05D9\u05DD \u05DC\u05EA\u05E0\u05D0\u05D9 \u05DB\u05DC\u05E9\u05D4\u05D5, \u05D0\u05E0\u05D0 \u05D4\u05D9\u05DE\u05E0\u05E2\u05D5 \u05DE\u05E9\u05D9\u05DE\u05D5\u05E9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA.","\u05D0\u05EA\u05DD \u05DE\u05E6\u05D4\u05D9\u05E8\u05D9\u05DD \u05DB\u05D9 \u05D0\u05EA\u05DD \u05D1\u05E0\u05D9 18 \u05D5\u05DE\u05E2\u05DC\u05D4, \u05D5\u05D0\u05DD \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05E0\u05E6\u05E8\u05DA \u05E2\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D6\u05D5\u05D2 \u2013 \u05E9\u05D2\u05DD \u05D4\u05D5\u05D0/\u05D4\u05D9\u05D0 \u05D1\u05D2\u05D9\u05E8/\u05D4 \u05D5\u05D1\u05D4\u05E1\u05DB\u05DE\u05D4 \u05DE\u05DC\u05D0\u05D4.","\u05DE\u05D4 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D1\u05E2\u05E6\u05DD \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D1\u05DC\u05D9\u05D5\u05D5\u05D9?","\u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC 10 \u05D3\u05E7\u05D5\u05EA, \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05E2\u05D1\u05D5\u05D3\u05D4 \u05E9\u05DE\u05EA\u05D7\u05D3\u05E9\u05EA \u05D1\u05DB\u05DC \u05D7\u05D5\u05D3\u05E9, \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D1\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 (\u05DB\u05D5\u05DC\u05DC \u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9), \u05D5\u05DE\u05E2\u05E0\u05D4 \u05D9\u05E9\u05D9\u05E8 \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05E6'\u05D0\u05D8 \u05E4\u05E0\u05D9\u05DE\u05D9. \u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC \u05D1\u05DE\u05E0\u05D5\u05D9 \u05D4\u05E9\u05D1\u05D5\u05E2\u05D9 \u2014 \u05D0\u05D9\u05DF \u05EA\u05D5\u05E1\u05E4\u05D5\u05EA, \u05D0\u05D9\u05DF \u05D4\u05E4\u05EA\u05E2\u05D5\u05EA.","\u05DE\u05D9 \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05E2\u05D5\u05E7\u05D1\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05E0\u05D5?","\u05E4\u05E1\u05D9\u05DB\u05D5\u05DC\u05D5\u05D2\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD, \u05D9\u05D5\u05E2\u05E6\u05D9 \u05DE\u05E9\u05E4\u05D7\u05D4 \u05D5\u05DE\u05D8\u05E4\u05DC\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05E2\u05DD \u05E0\u05D9\u05E1\u05D9\u05D5\u05DF \u05E9\u05DC 10+ \u05E9\u05E0\u05D9\u05DD. \u05DC\u05DB\u05DC \u05D6\u05D5\u05D2 \u05DE\u05DE\u05D5\u05E0\u05D4 \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05D5\u05DE\u05D3 \u05D0\u05EA\u05DB\u05DD \u05DC\u05D0\u05D5\u05E8\u05DA \u05D4\u05D6\u05DE\u05DF \u05D5\u05D1\u05D5\u05E0\u05D4 \u05DC\u05DB\u05DD \u05D0\u05EA \u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u2014 \u05DC\u05D0 \u05E6'\u05D0\u05D8-\u05D1\u05D5\u05D8, \u05DC\u05D0 \u05EA\u05D1\u05E0\u05D9\u05EA.","\u05D0\u05D9\u05D6\u05D4 \u05D1\u05E2\u05D9\u05D5\u05EA \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D1\u05D0\u05DE\u05EA \u05E4\u05D5\u05EA\u05E8?","\u05E8\u05D9\u05D7\u05D5\u05E7 \u05E8\u05D2\u05E9\u05D9, \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05E9\u05E2\u05D5\u05DC\u05D4 \u05DC\u05D5\u05D5\u05D9\u05DB\u05D5\u05D7, \u05D7\u05D5\u05E1\u05E8 \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA, \u05D7\u05D9\u05DB\u05D5\u05DB\u05D9\u05DD \u05E9\u05D7\u05D5\u05D6\u05E8\u05D9\u05DD \u05E2\u05DC \u05E2\u05E6\u05DE\u05DD, \u05EA\u05D7\u05D5\u05E9\u05D4 \u05E9\"\u05D0\u05D9\u05D1\u05D3\u05E0\u05D5 \u05D0\u05EA \u05E2\u05E6\u05DE\u05E0\u05D5\". \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05D1\u05D8\u05D9\u05D7\u05D9\u05DD \u05E4\u05EA\u05E8\u05D5\u05DF \u05DC\u05DB\u05DC \u05D3\u05D1\u05E8, \u05D0\u05D1\u05DC \u05D1-90% \u05DE\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05D9\u05E9 \u05E9\u05D9\u05E4\u05D5\u05E8 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA\u05D9 \u05D1\u05EA\u05D5\u05DA 6 \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA.","\u05DB\u05DE\u05D4 \u05D6\u05DE\u05DF \u05D6\u05D4 \u05D3\u05D5\u05E8\u05E9 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5 \u05D1\u05E9\u05D1\u05D5\u05E2?","\u05DB\u05E9\u05E2\u05D4 \u05D1\u05E9\u05D1\u05D5\u05E2 \u05D1\u05E1\u05DA \u05D4\u05DB\u05DC \u2014 \u05DB\u05E4\u05D5\u05E3 \u05DC\u05D6\u05DE\u05DF \u05E9\u05DC\u05DB\u05DD. \u05EA\u05E8\u05D2\u05D5\u05DC \u05E7\u05E6\u05E8 \u05D1\u05D9\u05D5\u05DD-\u05D9\u05D5\u05DE\u05D9\u05D9\u05DD, \u05E9\u05D9\u05D7\u05D4 \u05D0\u05D7\u05EA \u05D0\u05E8\u05D5\u05DB\u05D4 \u05D1\u05E9\u05D1\u05D5\u05E2. \u05D4\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD, \u05DC\u05D0 \u05E9\u05DC\u05E0\u05D5.","\u05D4\u05D0\u05DD \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u05E4\u05E8\u05D8\u05D9\u05D5\u05EA?","\u05DB\u05DF. \u05D4\u05E0\u05EA\u05D5\u05E0\u05D9\u05DD \u05DE\u05D5\u05E6\u05E4\u05E0\u05D9\u05DD. \u05E8\u05E7 \u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05D4\u05D0\u05D9\u05E9\u05D9 \u05E9\u05DC\u05DB\u05DD \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05E8\u05D9\u05DD \u05DE\u05D9\u05D3\u05E2, \u05D0\u05D9\u05DF \u05E4\u05E8\u05E1\u05D5\u05DE\u05D5\u05EA, \u05D0\u05D9\u05DF \u05E6\u05D3 \u05E9\u05DC\u05D9\u05E9\u05D9. \u05D4\u05D7\u05D9\u05D5\u05D1 \u05DE\u05D5\u05E4\u05D9\u05E2 \u05EA\u05D7\u05EA Mioshy \u05D1\u05DC\u05D1\u05D3.","\u05D0\u05E4\u05E9\u05E8 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D0\u05D5 \u05DC\u05D1\u05D8\u05DC \u05D1\u05DB\u05DC \u05E9\u05DC\u05D1?","\u05D1\u05DB\u05DC \u05E9\u05DC\u05D1, \u05D1\u05E7\u05DC\u05D9\u05E7 \u05D0\u05D7\u05D3. \u05DC\u05DC\u05D0 \u05D7\u05D5\u05D6\u05D4, \u05DC\u05DC\u05D0 \u05E7\u05E0\u05E1\u05D5\u05EA. \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D1\u05D9\u05D8\u05D5\u05DC, \u05DC\u05D0 \u05EA\u05D7\u05D5\u05D9\u05D1\u05D5 \u05D9\u05D5\u05EA\u05E8 \u2014 \u05D5\u05D4\u05D2\u05D9\u05E9\u05D4 \u05DC\u05EA\u05D5\u05DB\u05DF \u05E9\u05DC\u05DB\u05DD \u05E0\u05E9\u05D0\u05E8\u05EA \u05E2\u05D3 \u05E1\u05D5\u05E3 \u05EA\u05E7\u05D5\u05E4\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9 \u05D4\u05E0\u05D5\u05DB\u05D7\u05D9\u05EA.","\u05EA\u05EA\u05D7\u05D9\u05DC\u05D5 \u05DC\u05D1\u05D3. \u05E8\u05D5\u05D1 \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05DB\u05DA \u2014 \u05D4\u05E6\u05D3 \u05D4\u05E9\u05E0\u05D9 \u05DE\u05E6\u05D8\u05E8\u05E3 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9\u05D9\u05DD-\u05E9\u05DC\u05D5\u05E9\u05D4 \u05DB\u05E9\u05E8\u05D5\u05D0\u05D4 \u05E9\u05DE\u05E9\u05D4\u05D5 \u05D6\u05D6. \u05D0\u05D1\u05D7\u05D5\u05DF \u05DE\u05EA\u05D7\u05D9\u05DC \u05D0\u05E6\u05DC \u05D0\u05D7\u05D3 \u05D5\u05DE\u05EA\u05E7\u05D3\u05DD \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD.","\uF49E","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D9\u05D7\u05D3 \u05E9\u05E0\u05D4 \u05DC\u05E4\u05D7\u05D5\u05EA","\u05E9\u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05EA\u05D7\u05D6\u05E7 \u05E7\u05E9\u05E8 \u05D8\u05D5\u05D1 \u05DC\u05D0\u05D5\u05E8\u05DA \u05D6\u05DE\u05DF \u05D5\u05DC\u05E7\u05D1\u05DC \u05DB\u05DC\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD \u05D1\u05E7\u05E6\u05D1 \u05DE\u05E1\u05D5\u05D3\u05E8 \u2014 \u05DC\u05D0 \u05E8\u05E7 \u05D1\u05D6\u05DE\u05DF \u05DE\u05E9\u05D1\u05E8.","\uF476","\u05DC\u05D4\u05D5\u05E8\u05D9\u05DD \u05DC\u05D9\u05DC\u05D3\u05D9\u05DD \u05E7\u05D8\u05E0\u05D9\u05DD","\u05E9\u05D0\u05D9\u05DF \u05DC\u05D4\u05DD \u05D6\u05DE\u05DF \u05DC\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05E9\u05DE\u05E9\u05D4\u05D5 \u05D7\u05E1\u05E8, \u05D5\u05D6\u05E7\u05D5\u05E7\u05D9\u05DD \u05DC\u05DE\u05E1\u05D2\u05E8\u05EA \u05E9\u05DE\u05D7\u05D6\u05D9\u05E8\u05D4 \u05D0\u05D5\u05EA\u05DD \u05D6\u05D4 \u05D0\u05DC \u05D6\u05D5 \u05D1\u05DC\u05D9 \u05DC\u05D3\u05E8\u05D5\u05E9 \u05DE\u05D4\u05DD \u05DC\u05D4\u05D5\u05E1\u05D9\u05E3 \u05E2\u05D5\u05D3 \u05E9\u05E2\u05D5\u05EA \u05D1\u05D9\u05D5\u05DD.","\uF3E1","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E0\u05E9\u05D5\u05D0\u05D9\u05DD \u05DE\u05E2\u05DC 20 \u05E9\u05E0\u05D4","\u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05D1\u05E0\u05E4\u05E8\u05D3 \u05D2\u05DD \u05DB\u05E9\u05D4\u05DD \u05D9\u05D7\u05D3. \u05E2\u05D1\u05E8\u05EA\u05DD \u05D4\u05E8\u05D1\u05D4. \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D4\u05D6\u05D4 \u05D4\u05D5\u05D0 \u05D3\u05E8\u05DA \u05DC\u05E2\u05E6\u05D5\u05E8, \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05D6\u05D4 \u05E2\u05DC \u05D6\u05D5 \u05D0\u05D7\u05E8\u05EA, \u05D5\u05DC\u05DE\u05E6\u05D5\u05D0 \u05DE\u05D7\u05D3\u05E9 \u05D0\u05EA \u05D4\u05DE\u05E7\u05D5\u05DD \u05E9\u05D0\u05D9\u05D1\u05D3\u05EA\u05DD.","\uF331","\u05DC\u05DE\u05D9 \u05E9\u05E8\u05D5\u05E6\u05D4 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05D8\u05D5\u05D1 \u05D9\u05D5\u05EA\u05E8 \u05D1\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA","\u05DC\u05D0 \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05DE\u05E9\u05D1\u05E8 \u05DB\u05D3\u05D9 \u05DC\u05E8\u05E6\u05D5\u05EA \u05E9\u05D9\u05D4\u05D9\u05D4 \u05D8\u05D5\u05D1 \u05D9\u05D5\u05EA\u05E8. \u05D0\u05DD \u05D9\u05E9 \u05DE\u05E9\u05D4\u05D5 \u05E9\u05E7\u05E6\u05EA \u05DE\u05E6\u05D9\u05E7 \u2014 \u05D6\u05D4 \u05D4\u05D6\u05DE\u05DF \u05DC\u05D8\u05E4\u05DC \u05D1\u05D5.","\u05DC\u05DE\u05D9 \u05E9\u05DE\u05D0\u05DE\u05D9\u05DF \u05E9\u05D0\u05E4\u05E9\u05E8 \u05D0\u05D7\u05E8\u05EA","\u05D0\u05DD \u05D0\u05EA\u05DD \u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD \u05E9\u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D9\u05E8\u05D0\u05D5\u05EA \u05D0\u05D7\u05E8\u05EA, \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05D0\u05D7\u05E8\u05EA \u2014 \u05D5\u05D4\u05D9\u05D0 \u05EA\u05DC\u05D5\u05D9\u05D4 \u05D1\u05DB\u05DD \u2014 \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05DB\u05D0\u05DF \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD.","\u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05D9\u05D5\u05DE\u05D9\u05D9\u05DD","\u05E8\u05D2\u05E2\u05D9 \u05E7\u05E9\u05E8 \u05E7\u05D8\u05E0\u05D9\u05DD - 5 \u05D3\u05E7\u05D5\u05EA \u05D1\u05D9\u05D5\u05DD \u05E9\u05DE\u05D7\u05D6\u05E7\u05D9\u05DD \u05D0\u05EA \u05D4\u05E9\u05E8\u05D9\u05E8 \u05D4\u05D6\u05D5\u05D2\u05D9.","\u05E9\u05D0\u05DC\u05D5\u05EA \u05DE\u05D5\u05DB\u05D5\u05D5\u05E0\u05D5\u05EA \u05E9\u05E4\u05D5\u05EA\u05D7\u05D5\u05EA \u05DE\u05E7\u05D5\u05DE\u05D5\u05EA \u05E9\u05DC\u05D0 \u05EA\u05DE\u05D9\u05D3 \u05DE\u05D2\u05D9\u05E2\u05D9\u05DD \u05D0\u05DC\u05D9\u05D4\u05DD \u05DC\u05D1\u05D3.","\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05D1\u05D5\u05E2\u05D9\u05D9\u05DD","\u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05D3 \u05D1\u05DB\u05DC \u05E9\u05D1\u05D5\u05E2 - \u05D9\u05E6\u05D9\u05D0\u05D4, \u05DE\u05D7\u05D5\u05D5\u05D4, \u05E0\u05D9\u05E1\u05D5\u05D9 - \u05E9\u05DE\u05D5\u05E6\u05D9\u05D0 \u05D0\u05EA\u05DB\u05DD \u05DE\u05D4\u05E9\u05D2\u05E8\u05D4.","\u05D5\u05D9\u05D3\u05D0\u05D5 + \u05E8\u05E4\u05DC\u05E7\u05E6\u05D9\u05D4","\u05E7\u05DC\u05D9\u05E4\u05D9\u05DD \u05E7\u05E6\u05E8\u05D9\u05DD \u05DE\u05DE\u05D8\u05E4\u05DC\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA, \u05D5\u05D0\u05D7\u05E8\u05D9\u05D4\u05DD \u05DE\u05E7\u05D5\u05DD \u05DC\u05E8\u05E9\u05D5\u05DD \u05DE\u05D4 \u05E2\u05DC\u05D4.","\u05DE\u05DE\u05E4\u05D9\u05DD \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D1-5 \u05D3\u05E7\u05D5\u05EA","\u05D0\u05D1\u05D7\u05D5\u05DF \u05E7\u05E6\u05E8 \u05E9\u05DC \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA, \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA, \u05D7\u05D9\u05D1\u05D5\u05E8 \u05E8\u05D2\u05E9\u05D9, \u05D7\u05D1\u05E8\u05D5\u05EA \u05D5\u05DE\u05E9\u05E4\u05D7\u05D4. \u05D1\u05E1\u05D5\u05E3 \u05EA\u05E8\u05D0\u05D5 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05D9\u05E4\u05D4 \u05D0\u05EA\u05DD \u05E2\u05D5\u05DE\u05D3\u05D9\u05DD - \u05D1\u05DC\u05D9 \u05D6'\u05E8\u05D2\u05D5\u05DF, \u05D1\u05DC\u05D9 \u05DE\u05D9\u05DC\u05D5\u05D9 \u05DE\u05E7\u05D5\u05DD.","\u05D4\u05D0\u05D1\u05D7\u05D5\u05DF","\u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D0\u05D1\u05D7\u05D5\u05DF \u05D0\u05D9\u05E9\u05D9","\u05EA\u05D5\u05E6\u05D0\u05D5\u05EA \u05DE\u05D9\u05D9\u05D3\u05D9\u05D5\u05EA: 3 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA \u05D4\u05D7\u05D5\u05D6\u05E7 \u05E9\u05DC\u05DB\u05DD, 2 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA \u05D4\u05D7\u05D9\u05DB\u05D5\u05DA \u05D4\u05D2\u05D3\u05D5\u05DC\u05D5\u05EA \u05D1\u05D9\u05D5\u05EA\u05E8, \u05D5\u05D4\u05D3\u05D1\u05E8 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05D4\u05DB\u05D9 \u05DB\u05D3\u05D0\u05D9 \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05DC\u05E2\u05D1\u05D5\u05D3 \u05E2\u05DC\u05D9\u05D5 - \u05E2\u05DB\u05E9\u05D9\u05D5.","\u05D4\u05E0\u05D9\u05EA\u05D5\u05D7","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E6\u05DE\u05D5\u05D3 + \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05E9\u05D1\u05D5\u05E2\u05D9\u05D9\u05DD","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DE\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05DC\u05D5\u05DE\u05D3 \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8 \u05E9\u05DC\u05DB\u05DD, \u05D1\u05D5\u05E0\u05D4 \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA, \u05D5\u05E2\u05D5\u05E7\u05D1 \u05D0\u05D7\u05E8\u05D9\u05DB\u05DD \u05D1\u05E6'\u05D0\u05D8 \u05E4\u05E0\u05D9\u05DE\u05D9. \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05E7\u05E6\u05E8\u05D9\u05DD \u05E9\u05DE\u05E6\u05D8\u05D1\u05E8\u05D9\u05DD \u05DC\u05DB\u05E9\u05E2\u05D4 \u05D1\u05E9\u05D1\u05D5\u05E2 - \u05D1\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD.","\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC","\u05DE\u05D5\u05EA\u05D0\u05DD \u05DC\u05DB\u05DD","\u05D0\u05D1\u05D7\u05D5\u05DF \u05E7\u05E6\u05E8 \u05DE\u05DE\u05E4\u05D4 \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05DC\u05E4\u05D9 7 \u05E6\u05D9\u05E8\u05D9\u05DD. \u05E2\u05DC \u05D1\u05E1\u05D9\u05E1 \u05D4\u05EA\u05D5\u05E6\u05D0\u05D5\u05EA, \u05D4\u05DE\u05E2\u05E8\u05DB\u05EA \u05D1\u05D5\u05E0\u05D4 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D1\u05DE\u05E7\u05D5\u05DD \u05E9\u05E6\u05E8\u05D9\u05DA.","\u05E7\u05E6\u05D1 \u05D0\u05E0\u05D5\u05E9\u05D9","\u05EA\u05D5\u05DB\u05DF \u05DC\u05D0 \u05DE\u05D5\u05E6\u05E3. \u05D1\u05DB\u05DC \u05E9\u05D1\u05D5\u05E2 \u05E0\u05E4\u05EA\u05D7 \u05E4\u05E8\u05E7 \u05D7\u05D3\u05E9 - \u05EA\u05E8\u05D2\u05D5\u05DC, \u05D0\u05EA\u05D2\u05E8 \u05D0\u05D5 \u05E9\u05D9\u05D7\u05D4 \u05DC\u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2. \u05DE\u05E1\u05E4\u05D9\u05E7 \u05D6\u05DE\u05DF \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05D5\u05DC\u05D7\u05D6\u05D5\u05E8.","\u05EA\u05D5\u05DB\u05DF \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD","\u05DB\u05DC \u05E4\u05E8\u05D9\u05D8 \u05E0\u05DB\u05EA\u05D1 \u05D9\u05D7\u05D3 \u05E2\u05DD \u05DE\u05D8\u05E4\u05DC\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA. \u05E4\u05E8\u05E7\u05D8\u05D9, \u05DE\u05D1\u05D5\u05E1\u05E1 \u05DE\u05D7\u05E7\u05E8, \u05DE\u05D9\u05D5\u05E9\u05DD \u05D1\u05D7\u05D9\u05D9\u05DD \u05D4\u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD - \u05DC\u05D0 \u05E6\u05D9\u05D8\u05D5\u05D8\u05D9\u05DD \u05DE-Instagram.","\u05D9\u05D7\u05D3 \u05D1\u05D0\u05DE\u05EA","\u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2 \u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA \u05D0\u05D5\u05EA\u05D5 \u05D4\u05DE\u05E1\u05E2. \u