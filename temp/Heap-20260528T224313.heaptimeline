DC \u05DE\u05E0\u05D5\u05D9","\u05D4\u05D0\u05DD \u05DC\u05D1\u05D8\u05DC \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9? \u05D4\u05D7\u05D9\u05D5\u05D1 \u05D4\u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9 \u05D9\u05D5\u05E4\u05E1\u05E7 \u05DE\u05D9\u05D3. \u05D1\u05D9\u05D8\u05D5\u05DC \u05D4\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D9\u05D1\u05D8\u05DC \u05D2\u05DD \u05D0\u05EA \u05D4\u05D2\u05D9\u05E9\u05D4 \u05DC\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD (\u05D0\u05DC\u05D0 \u05D0\u05DD \u05E0\u05E8\u05DB\u05E9\u05D5 \u05D1\u05E0\u05E4\u05E8\u05D3).","\u05D4\u05E7\u05E4\u05D0\u05EA \u05DE\u05E0\u05D5\u05D9","\u05D4\u05E7\u05E4\u05D0\u05D4 \u05E2\u05D5\u05E6\u05E8\u05EA \u05D7\u05D9\u05D5\u05D1 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9. \u05E0\u05D9\u05EA\u05DF \u05DC\u05D7\u05D3\u05E9 \u05D1\u05DB\u05DC \u05E2\u05EA.","\u05D7\u05D9\u05D3\u05D5\u05E9 \u05D4\u05DE\u05E0\u05D5\u05D9","\u05D7\u05D9\u05D3\u05D5\u05E9 \u05D9\u05E4\u05E2\u05D9\u05DC \u05DE\u05D7\u05D3\u05E9 \u05D7\u05D9\u05D5\u05D1 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9 \u05DE\u05D4\u05D8\u05D5\u05E7\u05DF \u05D4\u05E9\u05DE\u05D5\u05E8.","\u05D7\u05E9\u05D1\u05D5\u05E0\u05D9\u05D5\u05EA","\u05D4\u05D7\u05E9\u05D1\u05D5\u05E0\u05D9\u05D5\u05EA \u05E9\u05DC\u05DA \u05D9\u05D5\u05E6\u05D2\u05D5 \u05DB\u05D0\u05DF \u05DC\u05D0\u05D7\u05E8 \u05D1\u05D9\u05E6\u05D5\u05E2 \u05EA\u05E9\u05DC\u05D5\u05DD \u05E8\u05D0\u05E9\u05D5\u05DF.","\u05D4\u05D5\u05E8\u05D3\u05EA \u05D7\u05E9\u05D1\u05D5\u05E0\u05D9\u05EA","\u05E1\u05DB\u05D5\u05DD","\u05EA\u05D0\u05E8\u05D9\u05DA","\u05E9\u05D5\u05DC\u05DD","\u05E0\u05DB\u05E9\u05DC","\u05D0\u05DE\u05E6\u05E2\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD","\u05DB\u05E8\u05D8\u05D9\u05E1 \u00B7\u00B7\u00B7\u00B7 {last4}","\u05D7\u05D9\u05D5\u05D1\u05DB\u05DD \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E0\u05DB\u05E9\u05DC. \u05D9\u05E9 \u05DC\u05E2\u05D3\u05DB\u05DF \u05D0\u05DE\u05E6\u05E2\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD \u05D1\u05E7\u05E8\u05D5\u05D1 \u05D0\u05D7\u05E8\u05EA \u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05D9\u05D9\u05D7\u05E1\u05DD.","\u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05D7\u05E1\u05D5\u05DD \u05E2\u05E7\u05D1 \u05DB\u05E9\u05DC\u05D9 \u05D7\u05D9\u05D5\u05D1. \u05E0\u05D0 \u05DC\u05E2\u05D3\u05DB\u05DF \u05D0\u05DE\u05E6\u05E2\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD.","\u05DC\u05D5\u05D1\u05D9 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05D5\u05E6\u05E8\u05D5 \u05D7\u05D3\u05E8 \u05DC\u05E9\u05D9\u05EA\u05D5\u05E3 \u05E2\u05DD \u05D7\u05D1\u05E8\u05D9\u05DD.","\u05E6\u05D5\u05E8 \u05D7\u05D3\u05E8","\u05D4\u05E6\u05D8\u05E8\u05E3 \u05DC\u05D7\u05D3\u05E8","\u05E7\u05D5\u05D3 \u05D7\u05D3\u05E8","\u05D7\u05D3\u05E8 \u05DE\u05E9\u05D7\u05E7:","\u05E9\u05EA\u05E4\u05D5 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3 \u05E2\u05DD \u05D7\u05D1\u05E8\u05D9\u05DD \u05D5\u05D4\u05E6\u05D8\u05E8\u05E4\u05D5. \u05D4\u05DE\u05D0\u05E8\u05D7 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05DB\u05E9\u05D4\u05DB\u05D5\u05DC \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD.","\u05E9\u05D7\u05E7\u05E0\u05D9\u05DD","\u05DE\u05D0\u05E8\u05D7","\u05E4\u05E2\u05D5\u05DC\u05D5\u05EA","\u05D4\u05EA\u05D7\u05DC \u05DE\u05E9\u05D7\u05E7","\u05E0\u05D3\u05E8\u05E9 \u05DC\u05E4\u05D7\u05D5\u05EA 2 \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD. \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D9\u05EA\u05E0\u05EA\u05D1 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05DC\u05E4\u05D9 \u05E1\u05D5\u05D2 \u05D4\u05D7\u05D3\u05E8.","\u05D8\u05D5\u05E2\u05DF\u2026","\u05E0\u05D7\u05E9\u05D9\u05DD \u05D5\u05E1\u05D5\u05DC\u05DE\u05D5\u05EA - \u05D7\u05D3\u05E8","\u05DE\u05E9\u05D7\u05E7 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D9\u05E0\u05D8\u05E8\u05D0\u05E7\u05D8\u05D9\u05D1\u05D9","\u05D9\u05E6\u05D9\u05D0\u05D4","\u05EA\u05E6\u05D5\u05E8\u05D4: {name}","\u05EA\u05E6\u05D5\u05E8\u05D4 \u05E4\u05E2\u05D9\u05DC\u05D4","\u05E9\u05D7\u05E7\u05E0\u05D9\u05DD \u05E4\u05E2\u05D9\u05DC\u05D9\u05DD","\u05DE\u05DE\u05EA\u05D9\u05E0\u05D9\u05DD \u05DC\u05D0\u05D9\u05E9\u05D5\u05E8","\u05D0\u05D9\u05E9\u05D5\u05E8","\u05D0\u05EA\u05D4","\u05D4\u05D8\u05D9\u05DC\u05D5 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D1\u05D9\u05D9\u05D4","\u05E4\u05E2\u05D5\u05DC\u05D4","\u05DE\u05D7\u05DB\u05D4 \u05DC\u05EA\u05D5\u05E8 \u05E9\u05DC\u05DA\u2026","\u05DC\u05D5\u05D2","\u05EA\u05D5\u05E8 \u05E9\u05DC {name}","\u05D8\u05D9\u05E4\u05D9\u05DD \u05D5\u05DB\u05EA\u05D1\u05D5\u05EA \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA","\u05D9\u05E9\u05D9\u05E8, \u05E4\u05E8\u05E7\u05D8\u05D9 \u05D5\u05D7\u05DD - \u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA, \u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D5\u05E8\u05E2\u05D9\u05D5\u05E0\u05D5\u05EA \u05DC\u05E2\u05E8\u05D1 \u05D4\u05E7\u05E8\u05D5\u05D1.","\u05E7\u05E8\u05D0\u05D5 \u05E2\u05D5\u05D3","\u05D0\u05D9\u05DF \u05DE\u05D0\u05DE\u05E8\u05D9\u05DD \u05E2\u05D3\u05D9\u05D9\u05DF - \u05D7\u05D6\u05E8\u05D5 \u05D1\u05E7\u05E8\u05D5\u05D1.","\u05DC\u05DC\u05D0 \u05DB\u05D5\u05EA\u05E8\u05EA","\u05DC\u05DB\u05DC \u05D4\u05DE\u05D0\u05DE\u05E8\u05D9\u05DD","\u05DE\u05D0\u05DE\u05E8\u05D9\u05DD \u05E7\u05E9\u05D5\u05E8\u05D9\u05DD","\u05E7\u05E8\u05D0\u05D5","\u05D4\u05DE\u05D0\u05DE\u05E8 \u05D6\u05DE\u05D9\u05DF \u05DB\u05E8\u05D2\u05E2 \u05E8\u05E7 \u05D1{language}.","\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA","Mioshy \u00B7 \u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DE\u05D3\u05DC\u05D9\u05E7\u05D9\u05DD \u05D0\u05EA \u05D4\u05E9\u05D9\u05D7\u05D4","\u05D2\u05DC\u05D2\u05DC\u05D9 \u05D0\u05DE\u05EA \u05D0\u05D5 \u05D7\u05D5\u05D1\u05D4, \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD, \u05E9\u05D0\u05DC\u05D5\u05EA \u05E2\u05D5\u05DE\u05E7 \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD. \u05E9\u05E0\u05D9 \u05DE\u05DB\u05E9\u05D9\u05E8\u05D9\u05DD \u05D0\u05D5 \u05D0\u05D7\u05D3 \u2014 \u05D4\u05DB\u05D5\u05DC \u05D1\u05D3\u05E4\u05D3\u05E4\u05DF, \u05D1\u05DC\u05D9 \u05D4\u05D5\u05E8\u05D3\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05EA\u05E7\u05E0\u05D4.","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D9\u05E0\u05D8\u05E8\u05D0\u05E7\u05D8\u05D9\u05D1\u05D9\u05D9\u05DD","\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05D6\u05D5\u05D2\u05D9, \u05E1\u05E4\u05D9\u05E0\u05D5 \u05D0\u05EA \u05D4\u05D2\u05DC\u05D2\u05DC \u05D0\u05D5 \u05E9\u05D7\u05E7\u05D5 \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD \u05E2\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05D0\u05D9\u05E9\u05D9\u05D5\u05EA. \u05D1\u05DC\u05D9 \u05D4\u05EA\u05E7\u05E0\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05E7\u05D5\u05D3 - \u05E4\u05E9\u05D5\u05D8 \u05DC\u05E4\u05EA\u05D5\u05D7 \u05D5\u05DC\u05E9\u05D7\u05E7.","\u05DC\u05DE\u05D4 Mioshy?","\u05DE\u05D4 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D4\u05DC\u05D9\u05DC\u05D4?","\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC?","\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05D5\u05EA\u05EA\u05D7\u05D9\u05DC\u05D5 \u05DC\u05E9\u05D7\u05E7. \u05D7\u05D9\u05E0\u05DD \u05DC\u05D4\u05EA\u05E0\u05E1\u05D5\u05EA.","\u05D4\u05E7\u05D8\u05DC\u05D5\u05D2","\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E9\u05D7\u05E7, \u05E4\u05EA\u05D7\u05D5 \u05E2\u05DC \u05D4\u05D8\u05DC\u05E4\u05D5\u05DF, \u05D5\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD. \u05D1\u05DC\u05D9 \u05D4\u05D5\u05E8\u05D3\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05D4\u05DB\u05E0\u05D5\u05EA.","\u05E2\u05D3\u05D9\u05D9\u05DF \u05D0\u05D9\u05DF \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E4\u05E2\u05D9\u05DC\u05D9\u05DD.","\u05E9\u05D7\u05E7\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5 \u2190","\u05D7\u05D3\u05E9 \uF525","\u05DC\u05D5\u05D7 \u05E7\u05DC\u05D0\u05E1\u05D9 \u05E2\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD - \u05E9\u05D7\u05E7\u05D5 \u05E2\u05DC \u05DE\u05DB\u05E9\u05D9\u05E8 \u05D0\u05D7\u05D3 \u05D0\u05D5 \u05E2\u05DC \u05E9\u05E0\u05D9 \u05DE\u05DB\u05E9\u05D9\u05E8\u05D9\u05DD \u05E9\u05D5\u05E0\u05D9\u05DD.","\u05E2\u05D3 8 \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD","10+ \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05DE\u05D0\u05D5\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA","\u05DC\u05DC\u05D0 \u05D4\u05EA\u05E7\u05E0\u05D4","\u05E4\u05E8\u05D8\u05D9 \u05D5\u05DE\u05D0\u05D5\u05D1\u05D8\u05D7","\u05D4\u05EA\u05E0\u05E1\u05D5\u05EA","\u05DC\u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2","\u05D6\u05D5\u05D2\u05D5\u05EA \u05DE\u05DB\u05DC \u05D4\u05E2\u05D5\u05DC\u05DD","\u05D8\u05E2\u05D9\u05DE\u05D4 \u05D7\u05D9\u05D4 \u00B7 Mioshy","\u05DE\u05D4 \u05D4\u05E8\u05D2\u05E2 \u05D0\u05D9\u05EA\u05D9 \u05E9\u05DC\u05D0 \u05D9\u05D5\u05E6\u05D0 \u05DC\u05DA \u05DE\u05D4\u05E8\u05D0\u05E9 - \u05D5\u05DC\u05DE\u05D4 \u05D3\u05D5\u05D5\u05E7\u05D0 \u05D4\u05D5\u05D0?","\u05DC\u05DE\u05D4 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05E2\u05D6\u05E8\u05E0\u05D5 \u05DC\u05DE\u05D0\u05D5\u05EA \u05D6\u05D5\u05D2\u05D5\u05EA \u05DC\u05E9\u05E4\u05E8 \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8 \u05E9\u05DC\u05D4\u05DD - \u05D1\u05D3\u05E8\u05DA \u05D4\u05DB\u05D9 \u05DB\u05D9\u05E4\u05D9\u05EA \u05E9\u05D9\u05E9","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05D5\u05E0\u05DC\u05D9\u05D9\u05DF, \u05D0\u05DE\u05EA \u05D0\u05D5 \u05D7\u05D5\u05D1\u05D4, \u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D5\u05EA, \u05E9\u05D0\u05DC\u05D5\u05EA \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA, \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD, \u05DE\u05E9\u05D7\u05E7 \u05D6\u05D5\u05D2\u05D9 \u05D1\u05D3\u05E4\u05D3\u05E4\u05DF","\u05D6\u05D5\u05D2\u05D9 \u00B7 \u05D1\u05D7\u05D9\u05E0\u05DD","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D0\u05D9\u05E0\u05D8\u05E8\u05D0\u05E7\u05D8\u05D9\u05D1\u05D9\u05D9\u05DD \u05D1\u05D3\u05E4\u05D3\u05E4\u05DF","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D6\u05D5\u05D2\u05D9 \u05E2\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u00B7 \u05DE\u05D5\u05DE\u05D7\u05D4 \u05D0\u05D9\u05E9\u05D9, \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05DE\u05D5\u05EA\u05D0\u05DE\u05EA, \u05E9\u05D9\u05E0\u05D5\u05D9 \u05E9\u05DE\u05E8\u05D2\u05D9\u05E9\u05D9\u05DD","\u05D0\u05D1\u05D7\u05D5\u05DF \u05D6\u05D5\u05D2\u05D9, \u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DE\u05DB\u05D9\u05E8 \u05D0\u05EA\u05DB\u05DD, \u05D5\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05E9\u05DE\u05EA\u05E2\u05D3\u05DB\u05E0\u05EA \u05DC\u05E4\u05D9 \u05D4\u05E7\u05E6\u05D1 \u05E9\u05DC\u05DB\u05DD. \u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2, \u05DB\u05DC \u05D4\u05DB\u05DC\u05D9\u05DD, \u05D4\u05DB\u05D5\u05DC \u05D1\u05D0\u05E4\u05DC\u05D9\u05E7\u05E6\u05D9\u05D4.","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E2\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u00B7 Personalised coaching","\u05DE\u05D5\u05EA\u05D0\u05DD \u05D0\u05D9\u05E9\u05D9\u05EA","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E6\u05DE\u05D5\u05D3 \u05DC\u05DB\u05DC \u05D6\u05D5\u05D2","\u05D7\u05DC\u05E7 \u05DE\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05DE\u05D5\u05EA\u05D0\u05DE\u05D9\u05DD \u05DE\u05E8\u05D0\u05E9 \u05DC\u05E4\u05D9 \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF. \u05DE\u05D4\u05E8\u05D2\u05E2 \u05E9\u05D4\u05E6\u05D8\u05E8\u05E4\u05EA\u05DD, \u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05E2\u05D5\u05E7\u05D1\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9 \u05D4\u05EA\u05E9\u05D5\u05D1\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD, \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD \u05D0\u05EA\u05DB\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05E0\u05D5\u05E1\u05E4\u05D5\u05EA, \u05D5\u05D1\u05DE\u05D4\u05DC\u05DA \u05D4\u05D6\u05DE\u05DF \u05D1\u05D5\u05E0\u05D9\u05DD \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05D7\u05D3\u05E9\u05D4. \u05E4\u05E1\u05D9\u05DB\u05D5\u05DC\u05D5\u05D2\u05D9\u05DD \u05D5\u05D9\u05D5\u05E2\u05E6\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DE\u05D8\u05E2\u05DE\u05E0\u05D5 - \u05D0\u05EA\u05DD \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05D7\u05D1\u05D9\u05DC\u05D4 \u05D4\u05DE\u05DC\u05D0\u05D4, \u05D5\u05D4\u05DB\u05DC \u05DE\u05DB\u05D5\u05D5\u05DF \u05D0\u05DC\u05D9\u05DB\u05DD.","\u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05D0\u05EA \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF","\u05DC\u05D4\u05DE\u05E9\u05D9\u05DA \u05D0\u05EA \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF","\u05D9\u05E9 \u05DC\u05DB\u05DD \u05D0\u05D1\u05D7\u05D5\u05DF \u05D1\u05D0\u05DE\u05E6\u05E2 - \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05DE\u05DE\u05EA\u05D9\u05DF \u05DC\u05D4\u05DE\u05E9\u05DA.","\u05DE\u05E1\u05E2 \u05D6\u05D5\u05D2\u05D9, \u05D0\u05D1\u05D7\u05D5\u05DF \u05D6\u05D5\u05D2\u05D9, \u05D9\u05D9\u05E2\u05D5\u05E5 \u05D6\u05D5\u05D2\u05D9, \u05EA\u05E8\u05D2\u05D5\u05DC\u05D9\u05DD \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA, \u05DE\u05E1\u05DC\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9 \u05D0\u05D9\u05E9\u05D9","\u05E4\u05EA\u05D9\u05D7\u05EA \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DC\u05DB\u05DD","\u05EA\u05DE\u05D5\u05E0\u05D4 \u05EA\u05EA\u05D5\u05D5\u05E1\u05E3 \u05D1\u05E7\u05E8\u05D5\u05D1","\u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05E9\u05DC\u05DB\u05DD \u05E4\u05E2\u05D9\u05DC - \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DE\u05D0\u05D9\u05E4\u05D4 \u05E9\u05E2\u05E6\u05E8\u05EA\u05DD","\u05DC\u05D9\u05D5\u05D5\u05D9 \u05D6\u05D5\u05D2\u05D9 \u05D0\u05D9\u05E9\u05D9 \u05D1\u05D0\u05E4\u05DC\u05D9\u05E7\u05E6\u05D9\u05D9\u05EA \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05DC\u05D0 \u05E0\u05DE\u05E6\u05D0","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05D6\u05D4 \u05DC\u05D0 \u05D6\u05DE\u05D9\u05DF \u05DB\u05E8\u05D2\u05E2.","\u05D7\u05E1\u05E8 \u05D2\u05DC\u05D2\u05DC \u05DC\u05DE\u05E9\u05D7\u05E7","\u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1 \u05DE\u05D0\u05D5\u05D7\u05E8 \u05D9\u05D5\u05EA\u05E8.","\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05DB\u05D9\u05E0\u05D9\u05DD \u05DE\u05E9\u05D4\u05D5 \u05DE\u05D9\u05D5\u05D7\u05D3 \u05E2\u05D1\u05D5\u05E8 \u05D6\u05D5\u05D2\u05D5\u05EA. \u05D7\u05D6\u05E8\u05D5 \u05D1\u05E7\u05E8\u05D5\u05D1.","\u05D7\u05D6\u05E8\u05D4 \u05DC\u05D3\u05E3 \u05D4\u05D1\u05D9\u05EA","\u05D4\u05D7\u05D3\u05E8 \u05D4\u05E1\u05D2\u05D5\u05E8","Mioshy \u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3 \u00B7 \u05DC\u05D9\u05DC\u05D4 \u05D0\u05D7\u05D3 \u05D0\u05D7\u05E8, \u05DC\u05D6\u05DB\u05D5\u05E8 \u05D4\u05E8\u05D1\u05D4 \u05D0\u05D7\u05E8\u05D9","\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D4\u05D0\u05E7\u05E1\u05E7\u05DC\u05D5\u05E1\u05D9\u05D1\u05D9\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5, \u05D1\u05DE\u05E7\u05D5\u05DD \u05D0\u05D7\u05D3.","\u05D4\u05DE\u05D5\u05E6\u05E8 \u05D4\u05D3\u05D2\u05DC \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9. \u05DE\u05E9\u05D7\u05E7\u05D9 \u05DE\u05D9\u05DF \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D1\u05D5\u05E0\u05D9\u05DD \u05D0\u05D5\u05D5\u05D9\u05E8\u05D4, \u05DE\u05E4\u05EA\u05D9\u05E2\u05D9\u05DD, \u05D5\u05DE\u05D7\u05D6\u05D9\u05E8\u05D9\u05DD \u05D0\u05EA \u05D4\u05E0\u05D9\u05E6\u05D5\u05E5. \u05D3\u05D9\u05E1\u05E7\u05E8\u05D8\u05D9, \u05D1\u05D8\u05E2\u05DD \u05D8\u05D5\u05D1, \u05D1\u05D3\u05E4\u05D3\u05E4\u05DF.","\u05E8\u05D1 \u05DE\u05DB\u05E8","\u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3 \u00B7 18+","\u05E2\u05E8\u05D1 \u05D0\u05D7\u05D3.","\u05D7\u05D5\u05D5\u05D9\u05D4 \u05DE\u05D9\u05E0\u05D9\u05EA \u05D7\u05D3\u05E9\u05D4.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DB\u05EA\u05D1\u05D5 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05E2\u05D5\u05DC\u05DD.","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D6\u05D4.","\u05D0\u05DC \u05D4\u05E7\u05D8\u05DC\u05D5\u05D2","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E1\u05E7\u05E8\u05E0\u05D9\u05DD \u00B7 \u05DC\u05DC\u05D0 \u05D7\u05D5\u05D6\u05D4 \u00B7 \u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E2\u05EA","3 \u05E8\u05DE\u05D5\u05EA","\u05E8\u05E7 \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA","\u05DE\u05E1\u05D9\u05E8\u05D4 \u05D3\u05D9\u05D2\u05D9\u05D8\u05DC\u05D9\u05EA \u05DE\u05D9\u05D9\u05D3\u05D9\u05EA","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D0\u05E7\u05E1\u05E7\u05DC\u05D5\u05E1\u05D9\u05D1\u05D9\u05D9\u05DD, \u05D0\u05D5\u05E6\u05E8\u05D9\u05DD \u05D0\u05D9\u05E9\u05D9\u05EA.","\u05D4\u05E7\u05D8\u05DC\u05D5\u05D2 \u05D1\u05D4\u05DB\u05E0\u05D4. \u05E0\u05D7\u05D6\u05D5\u05E8 \u05E2\u05DD \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D5\u05D5\u05D4 \u05DE\u05D0\u05D5\u05D3.","\u05D4\u05D7\u05DC \u05DE","\u05E4\u05E8\u05D8\u05D9\u05DD","\u05EA\u05DE\u05D5\u05E0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7","\u05DE\u05E8\u05D2\u05E9","\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DE\u05E4\u05D9\u05D2\u05D5\u05EA \u05DE\u05E8\u05D7\u05E7","\u05DE\u05E8\u05D2\u05E9 - \u05EA\u05DE\u05D5\u05E0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7","\u05DE\u05E2\u05D5\u05E8\u05E8","\u05D4\u05D6\u05DE\u05E0\u05D5\u05EA \u05DC\u05D7\u05D5\u05D5\u05D9\u05D4 \u05DE\u05E9\u05D5\u05EA\u05E4\u05EA","\u05DE\u05E2\u05D5\u05E8\u05E8 - \u05EA\u05DE\u05D5\u05E0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7","\u05DE\u05D4 \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA","\u05DC\u05D0 \u05E2\u05D5\u05D3 \u05DE\u05E9\u05D7\u05E7.","\u05E2\u05E8\u05D1 \u05E9\u05DC\u05D0 \u05E8\u05D5\u05E6\u05D9\u05DD \u05E9\u05D9\u05D9\u05D2\u05DE\u05E8.","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05D1\u05E0\u05D5 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9 \u05DE\u05D9\u05E0\u05D9\u05D5\u05EA \u05D1\u05E9\u05DC\u05D1\u05D9\u05DD - \u05DB\u05DC \u05E9\u05DC\u05D1 \u05D4\u05D5\u05D0 \u05E4\u05E2\u05D5\u05DC\u05D4 \u05DE\u05D9\u05E0\u05D9\u05EA \u05DE\u05E1\u05D5\u05D9\u05DE\u05EA \u05E9\u05D0\u05EA\u05DD \u05DE\u05D1\u05E6\u05E2\u05D9\u05DD \u05D9\u05D7\u05D3. \u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05D1\u05D9\u05DD \u05E6\u05E2\u05E6\u05D5\u05E2\u05D9 \u05DE\u05D9\u05DF. \u05D7\u05DC\u05E7 \u05DC\u05D0. \u05D4\u05D4\u05D7\u05DC\u05D8\u05D4 \u05D0\u05D9\u05EA\u05DB\u05DD.","\u05DB\u05D5\u05DC\u05DD \u05DE\u05DB\u05D5\u05D5\u05E0\u05D9\u05DD \u05DC\u05DE\u05D8\u05E8\u05D4 \u05D0\u05D7\u05EA - \u05D7\u05D5\u05D5\u05D9\u05D4 \u05DE\u05D9\u05E0\u05D9\u05EA \u05D1\u05DC\u05EA\u05D9-\u05E0\u05E9\u05DB\u05D7\u05EA. \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DE\u05D9\u05E0\u05D9\u05D9\u05DD. \u05D0\u05D9\u05E8\u05D5\u05D8\u05D9\u05D9\u05DD. \u05DE\u05E2\u05D5\u05E8\u05E8\u05D9\u05DD. \u05D5\u05D1\u05E0\u05D5\u05D9\u05D9\u05DD \u05D1\u05DB\u05D5\u05D5\u05E0\u05D4 \u05DB\u05DA, \u05E9\u05DC\u05D0 \u05EA\u05E8\u05E6\u05D5 \u05DC\u05D4\u05E4\u05E1\u05D9\u05E7 \u05DC\u05E9\u05D7\u05E7.","- \u05D6\u05D4 \u05DC\u05D0 \u05DE\u05E9\u05D7\u05E7 \u05E9\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E4\u05E2\u05DD \u05D5\u05D6\u05D5\u05E8\u05E7\u05D9\u05DD. \u05D6\u05D4 \u05DC\u05D9\u05DC\u05D4 \u05E9\u05D7\u05D5\u05D6\u05E8\u05D9\u05DD \u05E2\u05DC\u05D9\u05D5.","\u05D4\u05DE\u05E1\u05E4\u05E8\u05D9\u05DD \u05DE\u05D3\u05D1\u05E8\u05D9\u05DD","\u05D0\u05D7\u05E8\u05D9 \u05DE\u05E9\u05D7\u05E7 \u05D0\u05D7\u05D3 - ","\u05E8\u05D5\u05E6\u05D9\u05DD \u05E2\u05D5\u05D3.","\u05DE\u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05E8\u05DB\u05E9\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05D0\u05D7\u05D3 \u2014 \u05D7\u05D6\u05E8\u05D5 \u05DC\u05E8\u05DB\u05D5\u05E9 \u05DE\u05E9\u05D7\u05E7 \u05E9\u05E0\u05D9.","\u05DE\u05D4\u05DC\u05E7\u05D5\u05D7\u05D5\u05EA \u05E9\u05DC\u05E0\u05D5 \u2014 \u05E8\u05DB\u05E9\u05D5 \u05D0\u05EA \u05DB\u05DC \u05D4\u05DE\u05D5\u05E6\u05E8\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5.","\u05E9\u05D0\u05DC\u05D5\u05EA \u05E0\u05E4\u05D5\u05E6\u05D5\u05EA","\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD","\u05DC\u05E4\u05E0\u05D9 \u05D4\u05E8\u05DB\u05D9\u05E9\u05D4.","\u05DC\u05DE\u05D4 \u05D6\u05D4 \u05D8\u05D5\u05D1? \u05D0\u05D9\u05DA \u05D6\u05D4 \u05E9\u05D5\u05E0\u05D4 \u05DE\u05D8\u05D9\u05E4\u05D9\u05DD \u05E9\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05DE\u05E6\u05D5\u05D0 \u05D1\u05E8\u05E9\u05EA?","\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05E0\u05DB\u05EA\u05D1\u05D5 \u05E2\u05F4\u05D9 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05D1\u05E2\u05D5\u05DC\u05DD \u05D4\u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4 \u05D5\u05D4\u05D8\u05D9\u05E4\u05D5\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9, \u05D5\u05E2\u05D5\u05E6\u05D1\u05D5 \u05DB\u05D7\u05D5\u05D5\u05D9\u05D4 \u05E9\u05DC\u05DE\u05D4 \u2014 \u05DC\u05D0 \u05E8\u05E9\u05D9\u05DE\u05EA \u05D8\u05D9\u05E4\u05D9\u05DD. \u05DB\u05DC \u05DE\u05E9\u05D7\u05E7 \u05D4\u05D5\u05D0 \u05DE\u05E1\u05E2 \u05E9\u05DC \u05E9\u05DC\u05D1\u05D9\u05DD, \u05E2\u05DD \u05DE\u05EA\u05D7 \u05E9\u05DE\u05E6\u05D8\u05D1\u05E8 \u05D5\u05E9\u05D9\u05D0 \u05E9\u05D0\u05EA\u05DD \u05D6\u05D5\u05DB\u05E8\u05D9\u05DD. \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05DC\u05D0 \u05EA\u05DE\u05E6\u05D0\u05D5 \u05D1\u05DE\u05D0\u05DE\u05E8 \u05D1\u05D0\u05D9\u05E0\u05D8\u05E8\u05E0\u05D8: \u05DC\u05D0 \u05E8\u05E2\u05D9\u05D5\u05E0\u05D5\u05EA, \u05D0\u05DC\u05D0 \u05DE\u05E1\u05D2\u05E8\u05EA \u05E9\u05DE\u05D5\u05D1\u05D9\u05DC\u05D4 \u05D0\u05EA\u05DB\u05DD \u05D3\u05E8\u05DA \u05D4\u05E2\u05E8\u05D1.","\u05DE\u05D4 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D1\u05EA\u05D5\u05DD \u05D4\u05E8\u05DB\u05D9\u05E9\u05D4?","\u05D2\u05D9\u05E9\u05D4 \u05DE\u05D9\u05D9\u05D3\u05D9\u05EA \u05DC\u05DE\u05E9\u05D7\u05E7 \u05E9\u05E8\u05DB\u05E9\u05EA\u05DD, \u05DC\u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD, \u05DC\u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2. \u05E0\u05E4\u05EA\u05D7 \u05D0\u05D6\u05D5\u05E8 \u05E4\u05E8\u05D8\u05D9 \u05D1\u05F4\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9\u05F4 \u05E2\u05DD \u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u2014 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D7\u05D6\u05D5\u05E8 \u05D0\u05DC\u05D9\u05D4\u05DD \u05DB\u05DE\u05D4 \u05E4\u05E2\u05DE\u05D9\u05DD \u05E9\u05EA\u05E8\u05E6\u05D5, \u05D1\u05DC\u05D9 \u05D4\u05D2\u05D1\u05DC\u05D4. \u05D0\u05D9\u05DF \u05D4\u05D5\u05E8\u05D3\u05D5\u05EA, \u05D0\u05D9\u05DF \u05D4\u05EA\u05E7\u05E0\u05D5\u05EA. \u05E4\u05D5\u05EA\u05D7\u05D9\u05DD \u05DE\u05D4\u05D3\u05E4\u05D3\u05E4\u05DF \u05D1\u05DB\u05DC \u05DE\u05DB\u05E9\u05D9\u05E8.","\u05DE\u05EA\u05D9 \u05DE\u05D5\u05DE\u05DC\u05E5 \u05DC\u05E9\u05D7\u05E7? \u05E6\u05E8\u05D9\u05DA \u05D4\u05DB\u05E0\u05D4?","\u05D4\u05D6\u05DE\u05DF \u05D4\u05DB\u05D9 \u05D8\u05D5\u05D1 \u05D4\u05D5\u05D0 \u05DB\u05E9\u05D0\u05EA\u05DD \u05E8\u05D2\u05D5\u05E2\u05D9\u05DD, \u05E4\u05E0\u05D5\u05D9\u05D9\u05DD, \u05D5\u05D1\u05DE\u05E6\u05D1 \u05E8\u05D5\u05D7. \u05E2\u05E8\u05D1 \u05E1\u05D5\u05E3 \u05E9\u05D1\u05D5\u05E2, \u05D7\u05D5\u05E4\u05E9\u05D4 \u05E7\u05E6\u05E8\u05D4, \u05DB\u05DC \u05D6\u05DE\u05DF \u05E9\u05D0\u05EA\u05DD \u05DE\u05E7\u05D3\u05D9\u05E9\u05D9\u05DD \u05DC\u05E2\u05E6\u05DE\u05DB\u05DD \u05D1\u05DC\u05D9 \u05D4\u05E1\u05D7\u05D5\u05EA. \u05D0\u05D9\u05DF \u05D4\u05DB\u05E0\u05D4 \u2014 \u05E0\u05DB\u05E0\u05E1\u05D9\u05DD \u05DC\u05DE\u05E9\u05D7\u05E7 \u05D5\u05D4\u05D5\u05D0 \u05DE\u05D5\u05D1\u05D9\u05DC \u05D0\u05EA\u05DB\u05DD. \u05DB\u05DC \u05DE\u05E9\u05D7\u05E7 \u05DB\u05D5\u05DC\u05DC \u05E6\u05D9\u05D5\u05DF \u05E9\u05DC \u05DE\u05D4 \u05E9\u05E6\u05E8\u05D9\u05DA (\u05D0\u05DD \u05D1\u05DB\u05DC\u05DC) \u05DC\u05E4\u05E0\u05D9 \u05D4\u05D4\u05EA\u05D7\u05DC\u05D4.","\u05D4\u05D0\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DE\u05D4 \u05E9\u05E8\u05DB\u05E9\u05EA\u05D9?","\u05DB\u05DF, \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA. \u05DB\u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05DB\u05E9\u05D9\u05DD, \u05E0\u05E4\u05EA\u05D7 \u05DC\u05DB\u05DD \u05F4\u05D7\u05DC\u05DC \u05D6\u05D5\u05D2\u05D9\u05F4 \u2014 \u05D0\u05D6\u05D5\u05E8 \u05DE\u05E9\u05D5\u05EA\u05E3 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D0\u05D7\u05D3 \u05DE\u05DB\u05DD \u05E8\u05D5\u05DB\u05E9 \u05E4\u05EA\u05D5\u05D7 \u05DC\u05E9\u05E0\u05D9, \u05DE\u05D9\u05D3, \u05D1\u05D0\u05D5\u05EA\u05D5 \u05E8\u05D2\u05E2. \u05E8\u05DB\u05D9\u05E9\u05D4 \u05D0\u05D7\u05EA = \u05E9\u05E0\u05D9\u05DB\u05DD \u05D1\u05E4\u05E0\u05D9\u05DD. \u05D0\u05D9\u05DF \u05E6\u05D5\u05E8\u05DA \u05DC\u05E7\u05E0\u05D5\u05EA \u05E4\u05E2\u05DE\u05D9\u05D9\u05DD.","\u05D4\u05D0\u05DD \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E7\u05D1\u05DC \u05DB\u05E1\u05E3 \u05D7\u05D6\u05E8\u05D4 \u05D0\u05DD \u05D6\u05D4 \u05DC\u05D0 \u05DE\u05EA\u05D0\u05D9\u05DD?","\u05DB\u05DF. \u05E2\u05D3 14 \u05D9\u05D5\u05DD \u05DE\u05D4\u05E8\u05DB\u05D9\u05E9\u05D4, \u05D0\u05DD \u05DC\u05D0 \u05D4\u05EA\u05D7\u05DC\u05EA\u05DD \u05DC\u05E9\u05D7\u05E7, \u05E0\u05D7\u05D6\u05D9\u05E8 \u05D0\u05EA \u05D4\u05EA\u05E9\u05DC\u05D5\u05DD \u05D1\u05DE\u05DC\u05D5\u05D0\u05D5 \u2014 \u05DB\u05EA\u05D1\u05D5 \u05D0\u05DC\u05D9\u05E0\u05D5 \u05D1-mioshyoffice@gmail.com \u05D5\u05E0\u05E1\u05D2\u05D5\u05E8 \u05D0\u05EA \u05D6\u05D4. \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05EA\u05D7\u05DC\u05EA\u05DD \u2014 \u05D4\u05EA\u05D5\u05DB\u05DF \u05E0\u05D7\u05E9\u05E3 \u05D5\u05DC\u05DB\u05DF \u05D4\u05E8\u05DB\u05D9\u05E9\u05D4 \u05DC\u05D0 \u05E0\u05D9\u05EA\u05E0\u05EA \u05DC\u05D4\u05D7\u05D6\u05E8\u05D4.","\u05E6\u05E8\u05D9\u05DA \u05DC\u05E7\u05E0\u05D5\u05EA \u05E6\u05E2\u05E6\u05D5\u05E2\u05D9 \u05DE\u05D9\u05DF?","\u05EA\u05DC\u05D5\u05D9 \u05D1\u05DE\u05E9\u05D7\u05E7. \u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05DE\u05E9\u05DC\u05D1\u05D9\u05DD \u05E6\u05E2\u05E6\u05D5\u05E2\u05D9\u05DD \u2014 \u05D5\u05D6\u05D4 \u05DE\u05E6\u05D5\u05D9\u05DF \u05D1\u05E2\u05DE\u05D5\u05D3 \u05E9\u05DC \u05DB\u05DC \u05DE\u05E9\u05D7\u05E7. \u05D7\u05DC\u05E7 \u05DC\u05D0 \u05D3\u05D5\u05E8\u05E9\u05D9\u05DD \u05E9\u05D5\u05DD \u05E6\u05D9\u05D5\u05D3. \u05D0\u05EA\u05DD \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD \u05DE\u05E8\u05D0\u05E9.","\u05D6\u05D4 \u05D3\u05D9\u05E1\u05E7\u05E8\u05D8\u05D9?","\u05DC\u05D7\u05DC\u05D5\u05D8\u05D9\u05DF. \u05D4\u05D7\u05D9\u05D5\u05D1 \u05DE\u05D5\u05E4\u05D9\u05E2 \u05EA\u05D7\u05EA Mioshy \u05D1\u05DC\u05D1\u05D3 \u2014 \u05D1\u05DC\u05D9 \u05E9\u05DE\u05D5\u05EA \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05D1\u05DC\u05D9 \u05DE\u05D9\u05DC\u05D9\u05DD \u05D0\u05D7\u05E8\u05D5\u05EA. \u05DB\u05DC \u05D4\u05E0\u05EA\u05D5\u05E0\u05D9\u05DD \u05DE\u05D5\u05E6\u05E4\u05E0\u05D9\u05DD, \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05E8\u05D9\u05DD \u05DE\u05D9\u05D3\u05E2, \u05D5\u05D0\u05D9\u05DF \u05E4\u05E8\u05E1\u05D5\u05DE\u05D5\u05EA.","\u05DE\u05D4 \u05D0\u05DD \u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05D5\u05DB\u05DF/\u05D4?","\u05D0\u05D6 \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05D1\u05E8\u05DE\u05D4 \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u2014 \u05E9\u05D9\u05D7\u05D4 \u05D5\u05E9\u05D0\u05DC\u05D5\u05EA, \u05D1\u05DC\u05D9 \u05E9\u05D5\u05DD \u05DC\u05D7\u05E5. \u05E8\u05D5\u05D1 \u05D4\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD \u05E9\u05DD \u05DE\u05D2\u05DC\u05D9\u05DD \u05E9\u05D4\u05E9\u05E0\u05D9 \u05E0\u05E4\u05EA\u05D7 \u05D1\u05D0\u05D5\u05E4\u05DF \u05D8\u05D1\u05E2\u05D9.","\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD?","\u05DC\u05D9\u05DC\u05D4 \u05D0\u05D7\u05D3.","\u05DB\u05DC \u05DE\u05D4 \u05E9\u05E6\u05E8\u05D9\u05DA \u05DB\u05D3\u05D9 \u05DC\u05D3\u05E2\u05EA.","\u05DC\u05DC\u05D0 \u05D7\u05D5\u05D6\u05D4 \u00B7 \u05D1\u05D9\u05D8\u05D5\u05DC \u05D1\u05DB\u05DC \u05E2\u05EA \u00B7 \u05D4\u05D7\u05D9\u05D5\u05D1 \u05DE\u05D5\u05E4\u05D9\u05E2 \u05DB-Mioshy \u05D1\u05DC\u05D1\u05D3","\u05D1\u05D7\u05E8\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7","\u05E9\u05DE\u05EA\u05D7\u05D9\u05DC \u05D0\u05EA \u05D4\u05E2\u05E8\u05D1.","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05DE\u05D9\u05DF \u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u2014 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05DE\u05E9\u05D7\u05E7\u05D9 \u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC\u05DB\u05DD \u00B7 \u05E4\u05EA\u05D7\u05D5 \u05D0\u05D5\u05EA\u05D5","\u05D7\u05D3\u05E9","\u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9","\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA","\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA","\u05D7\u05D5\u05DD","\u05DE\u05D4 \u05EA\u05E7\u05D1\u05DC\u05D5","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05D6\u05D4 \u05D4\u05D5\u05D0 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD \u05D0\u05DD\u2026","\u05D2\u05DC\u05E8\u05D9\u05D4","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05D4\u05D1\u05D0","\u05D4\u05DE\u05E9\u05DA \u05DC\u05D2\u05DC\u05D5\u05EA","\u05DC\u05D9\u05DC\u05D4 \u05D1\u05DC\u05EA\u05D9 \u05E0\u05E9\u05DB\u05D7","\u05D6\u05DB\u05E8\u05D5\u05DF \u05DE\u05D9\u05E0\u05D9 \u05D7\u05D3\u05E9 \u05E9\u05D9\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E9\u05D2\u05E8\u05D4","\u05DC\u05D6\u05D5\u05D2\u05D5\u05EA \u05E9\u05DE\u05D7\u05E4\u05E9\u05D9\u05DD \u05DC\u05E9\u05D1\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E8\u05D5\u05D8\u05D9\u05E0\u05D4 \u05E9\u05DC \u05D7\u05D3\u05E8 \u05D4\u05E9\u05D9\u05E0\u05D4","\u05DC\u05EA\u05EA \u05DC\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5 \u05DC\u05D4\u05D5\u05D1\u05D9\u05DC \u05D0\u05EA\u05DB\u05DD \u05D1\u05D7\u05D3\u05E8 \u05D4\u05DE\u05D9\u05D8\u05D5\u05EA","\u05D4\u05D2\u05DC\u05E8\u05D9\u05D4 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC\u05DB\u05DD \u00B7 \u05E0\u05E4\u05EA\u05D7","\u05D4\u05E1\u05D9\u05E4\u05D5\u05E8 \u05E9\u05DC\u05DB\u05DD","\u05DE\u05D4\u05E4\u05EA\u05D9\u05D7\u05D4 ","\u05D5\u05E2\u05D3 \u05D4\u05E9\u05D9\u05D0.","\u05EA\u05E4\u05E7\u05D9\u05D3 \u05D4\u05D2\u05D1\u05E8","\u05EA\u05E4\u05E7\u05D9\u05D3 \u05D4\u05D0\u05D9\u05E9\u05D4","\u05D4\u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7","\u05E2\u05E0\u05D5 \u05E2\u05DC \u05D4\u05E9\u05D0\u05DC\u05D4 \u05D4\u05D1\u05D0\u05D4 - \u05DC\u05E4\u05D9 \u05D4\u05E1\u05D3\u05E8 \u05D0\u05D5 \u05DC\u05D1\u05D7\u05D9\u05E8\u05EA\u05DB\u05DD.","\u05D4\u05DE\u05E9\u05D7\u05E7 \u05E9\u05DC\u05DB\u05DD","\u05D0\u05D9\u05DF \u05E1\u05D3\u05E8 \u05E0\u05DB\u05D5\u05DF. \u05D0\u05D9\u05DF \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA \u05E0\u05DB\u05D5\u05E0\u05D4. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DB\u05DD - \u05D6\u05D4 \u05D4\u05E0\u05DB\u05D5\u05DF.","\u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05E9\u05DC\u05DA","\u05E1\u05D8\u05D8\u05D5\u05E1: \u05D7\u05D9\u05E0\u05DD","\u05DC\u05E8\u05D0\u05D5\u05EA \u05DE\u05D7\u05D9\u05E8\u05D9\u05DD","\u05E1\u05D8\u05D8\u05D5\u05E1: \u05D4\u05DB\u05DC \u05E4\u05EA\u05D5\u05D7","\u05EA\u05D4\u05E0\u05D5.","\u05E1\u05D8\u05D8\u05D5\u05E1: \u05DE\u05E0\u05D5\u05D9 \u05E4\u05E2\u05D9\u05DC","\u05DC\u05D9\u05D5\u05D5\u05D9","\u05DC\u05E9\u05D3\u05E8\u05D2 \u05DE\u05E1\u05DC\u05D5\u05DC","\u05E9\u05D3\u05E8\u05D5\u05D2","\u05DC\u05E9\u05D3\u05E8\u05D2 \u05DC'\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E2\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9' \u2014 57 \u20AA \u05DC\u05E9\u05D1\u05D5\u05E2","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05D0\u05D9\u05E9\u05D9, \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05E9\u05D1\u05D5\u05E2\u05D9\u05EA, \u05D5\u05D2\u05D9\u05E9\u05D4 \u05D7\u05D5\u05E4\u05E9\u05D9\u05EA \u05DC\u05DB\u05DC \u05DE\u05E9\u05D7\u05E7\u05D9 '\u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9'. \u05D4\u05DE\u05E0\u05D5\u05D9 \u05D4\u05E0\u05D5\u05DB\u05D7\u05D9 \u05E9\u05DC\u05DB\u05DD \u05D9\u05EA\u05D1\u05D8\u05DC \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05D1\u05E8\u05D2\u05E2 \u05E9\u05D4\u05E9\u05D3\u05E8\u05D5\u05D2 \u05D9\u05E1\u05EA\u05D9\u05D9\u05DD \u2014 \u05D1\u05DC\u05D9 \u05D4\u05D7\u05D6\u05E8 \u05E2\u05DC \u05D4\u05E9\u05D1\u05D5\u05E2 \u05D4\u05E7\u05D9\u05D9\u05DD, \u05D1\u05DC\u05D9 \u05DB\u05E4\u05D9\u05DC\u05D5\u05D9\u05D5\u05EA.","\u05DC\u05E9\u05D3\u05E8\u05D2 \u05E2\u05DB\u05E9\u05D9\u05D5","\u05D4\u05D6\u05DE\u05D9\u05E0\u05D5 \u05D0\u05EA \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05D4\u05E9\u05DC\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05E4\u05E8\u05D5\u05E4\u05D9\u05DC","\u05DC\u05D4\u05E9\u05DC\u05DE\u05D4","\u05E7\u05D9\u05D1\u05DC\u05EA\u05DD \u05E7\u05D5\u05D3 \u05DE\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2?","{n} \u05D7\u05D3\u05E9\u05D9\u05DD","\u05E9\u05DC\u05D5\u05E9\u05D4 \u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD, \u05DB\u05DC \u05D0\u05D7\u05D3 \u05E2\u05D5\u05DE\u05D3 \u05D1\u05E4\u05E0\u05D9 \u05E2\u05E6\u05DE\u05D5. \u05D1\u05D7\u05E8\u05D5 \u05D0\u05EA \u05D4\u05D5\u05D5\u05D9\u05D1 \u05E9\u05DC\u05DB\u05DD \u05D4\u05E2\u05E8\u05D1 \u2014 \u05E2\u05E8\u05D1 \u05DE\u05E6\u05D7\u05D9\u05E7 \u05E2\u05DD \u05DE\u05E9\u05D7\u05E7, \u05E1\u05E7\u05E1 \u05E9\u05DB\u05EA\u05D1\u05D5 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD, \u05D0\u05D5 \u05DC\u05D9\u05D5\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05E9\u05DE\u05DB\u05D5\u05D5\u05DF \u05D0\u05EA \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA.","\u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05E4\u05E2\u05D9\u05DC. \u05E2\u05D3\u05D9\u05D9\u05DF \u05D1\u05DC\u05D9 \u05DE\u05E0\u05D5\u05D9.","\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05D1\u05E7\u05D8\u05DF \u05E2\u05DD \u05DE\u05E9\u05D7\u05E7 \u05E9\u05D1\u05D5\u05E2\u05D9, \u05DC\u05D4\u05D5\u05E1\u05D9\u05E3 \u05E1\u05E7\u05E1 \u05E9\u05DB\u05EA\u05D1\u05D5 \u05DE\u05D5\u05DE\u05D7\u05D9\u05DD, \u05D0\u05D5 \u05DC\u05DC\u05DB\u05EA \u05E2\u05DC \u05DC\u05D9\u05D5\u05D5\u05D9-\u05D4\u05DB\u05DC-\u05DB\u05DC\u05D5\u05DC.","\u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DA \u05DE\u05E7\u05D9\u05E3 \u05D0\u05EA \u05DB\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 - \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD, \u05DC\u05D9\u05D5\u05D5\u05D9, \u05D5\u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3.","\u05D9\u05E9 \u05DC\u05DB\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC-{count} \u05DE\u05EA\u05D5\u05DA 3 \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5.","\u05E4\u05E2\u05D9\u05DC: {owned}. \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05D5\u05E1\u05D9\u05E3: {missing}.","\u05DB\u05E0\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8, \u05D2\u05DC\u05D2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD.","\u05E2\u05E8\u05D1 \u05E9\u05DC\u05DD \u05E9\u05DC \u05D7\u05D9\u05D1\u05D5\u05E8 \u2014 \u05E9\u05D0\u05DC\u05D5\u05EA \u05E9\u05DE\u05D5\u05D1\u05D9\u05DC\u05D5\u05EA \u05DC\u05E9\u05D9\u05D7\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05D5\u05EA, \u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05E9\u05DE\u05D7\u05D6\u05D9\u05E8\u05D9\u05DD \u05EA\u05E9\u05D5\u05E7\u05D4, \u05D5\u05E6\u05D7\u05D5\u05E7 \u05E9\u05D0\u05EA\u05DD \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05E9\u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u05D6\u05E7\u05D5\u05E7\u05D4 \u05DC\u05D5. \u05DE\u05E0\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9, \u05DE\u05EA\u05D7\u05D3\u05E9 \u05DB\u05DC \u05D9\u05D5\u05DD \u05E8\u05D0\u05E9\u05D5\u05DF.","\u05D4\u05E7\u05DC\u05D9\u05E0\u05D9\u05E7\u05D4 \u05D4\u05DE\u05DB\u05D5\u05D5\u05E0\u05E0\u05EA \u05E9\u05DC\u05DB\u05DD - \u05EA\u05D5\u05DB\u05DF \u05E9\u05DE\u05E1\u05D5\u05D3\u05E8 \u05DC\u05E4\u05D9 \u05DE\u05D4 \u05E9\u05D7\u05E9\u05D5\u05D1 \u05DC\u05DB\u05DD, \u05DB\u05DC \u05D0\u05D7\u05D3 \u05E2\u05DD \u05D4\u05E1\u05D3\u05E8 \u05E9\u05DC\u05D5.","\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DE\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D5\u05DE\u05D3 \u05D0\u05EA\u05DB\u05DD \u05D1\u05E2\u05D5\u05DE\u05E7, \u05D1\u05D5\u05E0\u05D4 \u05DC\u05DB\u05DD \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D0\u05D9\u05E9\u05D9\u05EA, \u05D5\u05D6\u05DE\u05D9\u05DF \u05DC\u05DB\u05DD \u05D1\u05E6'\u05D0\u05D8. \u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2 \u05E2\u05D5\u05D8\u05E4\u05D9\u05DD \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8 \u05D1\u05E2\u05D1\u05D5\u05D3\u05D4 \u05D0\u05DE\u05D9\u05EA\u05D9\u05EA \u2014 \u05D4\u05DB\u05DC \u05DB\u05DC\u05D5\u05DC \u05D1\u05DE\u05E0\u05D5\u05D9 \u05E9\u05D1\u05D5\u05E2\u05D9 \u05D0\u05D7\u05D3.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DB\u05EA\u05D1\u05D5 \u05D4\u05D1\u05DB\u05D9\u05E8\u05D9\u05DD \u05D1\u05E2\u05D5\u05DC\u05DD \u05D1\u05E1\u05E7\u05E1\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4 \u05D5\u05D1\u05D8\u05D9\u05E4\u05D5\u05DC \u05D6\u05D5\u05D2\u05D9. \u05D7\u05D5\u05D5\u05D9\u05D4 \u05E9\u05DC\u05DE\u05D4 \u05DC\u05D7\u05D3\u05E8 \u05D4\u05DE\u05D9\u05D8\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD \u2014 \u05DC\u05D0 \u05D8\u05D9\u05E4\u05D9\u05DD, \u05DC\u05D0 \u05E8\u05E9\u05D9\u05DE\u05D5\u05EA. \u05E8\u05DB\u05D9\u05E9\u05D4 \u05D0\u05D7\u05EA \u05E4\u05E8 \u05DE\u05E9\u05D7\u05E7, \u05E4\u05EA\u05D5\u05D7 \u05DC\u05DB\u05DD \u05D5\u05DC\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DC\u05EA\u05DE\u05D9\u05D3.","\u05E9\u05DC\u05D7\u05D5 \u05D4\u05D6\u05DE\u05E0\u05D4 \u05D1\u05DE\u05D9\u05D9\u05DC. \u05D1\u05E8\u05D2\u05E2 \u05E9\u05D9\u05E6\u05D8\u05E8\u05E4\u05D5, \u05D4\u05D6\u05DE\u05DF \u05D4\u05D6\u05D4 \u05D9\u05D9\u05E2\u05DC\u05DD \u05DE\u05D4\u05D3\u05E9\u05D1\u05D5\u05E8\u05D3.","\u05E7\u05D5\u05D3 \u05DE\u05E9\u05D7\u05E7 (\u05DC\u05DE\u05DB\u05E9\u05D9\u05E8 \u05E9\u05E0\u05D9)","\u05DB\u05D3\u05D9 \u05DC\u05E6\u05DE\u05D3 \u05E4\u05E8\u05D8\u05E0\u05E8/\u05D9\u05EA \u05D0\u05D5 \u05DC\u05D4\u05D6\u05D9\u05DF \u05E7\u05D5\u05D3 \u2014 \u05E6\u05E8\u05D9\u05DA \u05E9\u05DD \u05DE\u05DC\u05D0, \u05E0\u05D9\u05D9\u05D3 \u05D5\u05E1\u05D9\u05E1\u05DE\u05D4.","\u05D4\u05D6\u05D9\u05E0\u05D5 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3 \u05D5\u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05D9\u05EA\u05D7\u05D1\u05E8 \u05D0\u05DC\u05D9\u05D4\u05DD \u05DE\u05D9\u05D3.","\u05D4\u05D7\u05E9\u05D1\u05D5\u05DF \u05E9\u05DC\u05D9 \u00B7 \u05D7\u05E9\u05D1\u05D5\u05E0\u05D9\u05D5\u05EA \u00B7 \u05E0\u05D9\u05D4\u05D5\u05DC \u05DE\u05E0\u05D5\u05D9","\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05E2\u05D1\u05D5\u05D3\u05D4 \u05D0\u05D9\u05E9\u05D9\u05EA","\u05DE\u05E9\u05D7\u05E7 \u05E4\u05EA\u05D5\u05D7 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E4\u05EA\u05D5\u05D7\u05D9\u05DD \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD.","\u05D0\u05D9\u05DA \u05DC\u05E9\u05EA\u05E3 \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E2\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u00B7 \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05D0\u05E8\u05D1\u05E2\u05D4 \u05E6\u05E2\u05D3\u05D9\u05DD \u05E4\u05E9\u05D5\u05D8\u05D9\u05DD \u05DC\u05D7\u05D9\u05D1\u05D5\u05E8 \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DC\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DB\u05DD \u2014 \u05D1\u05DC\u05D9 \u05EA\u05E9\u05DC\u05D5\u05DD \u05E0\u05D5\u05E1\u05E3, \u05D1\u05DC\u05D9 \u05D8\u05E4\u05E1\u05D9\u05DD \u05DE\u05E1\u05D5\u05D1\u05DB\u05D9\u05DD.","\u05D7\u05D6\u05E8\u05D4 \u05DC\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9","\u05DE\u05D3\u05E8\u05D9\u05DA \u05E7\u05E6\u05E8","\u05D0\u05D9\u05DA \u05DC\u05E9\u05EA\u05E3 \u05D0\u05EA \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E2\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DB\u05DD \u05DE\u05E9\u05D5\u05EA\u05E3 \u2014 \u05E9\u05E0\u05D9\u05DB\u05DD \u05DE\u05E7\u05D1\u05DC\u05D9\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC\u05D0\u05D5\u05EA\u05DD \u05EA\u05DB\u05E0\u05D9\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7. \u05D1\u05D0\u05E8\u05D1\u05E2\u05D4 \u05E6\u05E2\u05D3\u05D9\u05DD \u05E0\u05D7\u05D1\u05E8 \u05D0\u05EA \u05D4\u05D7\u05E9\u05D1\u05D5\u05E0\u05D5\u05EA, \u05DB\u05DC \u05D4\u05E6\u05D3\u05D3\u05D9\u05DD \u05D9\u05E7\u05D1\u05DC\u05D5 \u05D0\u05EA \u05DB\u05DC \u05DE\u05D4 \u05E9\u05DB\u05D1\u05E8 \u05E8\u05DB\u05E9\u05EA\u05DD, \u05D1\u05DC\u05D9 \u05DB\u05E4\u05DC \u05D7\u05D9\u05D5\u05D1.","\u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05E9\u05EA\u05E3?","\u05D7\u05D6\u05E8\u05D5 \u05DC'\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9', \u05D4\u05E7\u05D5\u05D3 \u05D9\u05D7\u05DB\u05D4 \u05DC\u05DB\u05DD \u05D1\u05E8\u05D0\u05E9 \u05D4\u05D3\u05E3 \u05E2\u05DD \u05DB\u05DC \u05D0\u05E4\u05E9\u05E8\u05D5\u05D9\u05D5\u05EA \u05D4\u05E9\u05D9\u05EA\u05D5\u05E3.","\u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD","\u05D0\u05D9\u05DF \u05DB\u05E8\u05D2\u05E2 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05D6\u05DE\u05D9\u05E0\u05D9\u05DD.","\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u00B7 \u05D4\u05D2\u05DC\u05E8\u05D9\u05D4","\u05D2\u05DC\u05D2\u05DC \u05D4\u05D0\u05DE\u05EA, \u05E0\u05D7\u05E9\u05D9\u05DD \u05D5\u05E9\u05DC\u05D1\u05D9\u05DD - \u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD, \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D4\u05E4\u05E2\u05DC\u05D4.","\u05DB\u05E0\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8, \u05D2\u05DC\u05D2\u05DC \u05D4\u05D6\u05D5\u05D2\u05D9\u05D5\u05EA, \u05E1\u05D5\u05DC\u05DE\u05D5\u05EA \u05D5\u05E0\u05D7\u05E9\u05D9\u05DD - \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05DC\u05D4\u05E4\u05E2\u05DC\u05D4.","\u05D1\u05D9\u05D7\u05D3","\u05D7\u05D6\u05E8\u05D4 \u05DC\u05E2\u05DE\u05D5\u05D3 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05DE\u05E7\u05D5\u05DD \u05D4\u05DE\u05E9\u05D5\u05EA\u05E3 \u05E9\u05DC\u05DB\u05DD","\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05E4\u05E8\u05D9\u05D8\u05D9\u05DD \u05D9\u05D7\u05D3","\u05D4\u05E9\u05DC\u05DE\u05EA\u05DD \u05E9\u05E0\u05D9\u05DB\u05DD","\u05D0\u05EA\u05DD","\u05E4\u05E8\u05D9\u05D8\u05D9\u05DD","\u05DE\u05D4 \u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD \u05DB\u05D0\u05DF \u2014 \u05E9\u05E0\u05D9\u05DB\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD. \u05D6\u05D4 \u05DC\u05D0 \u05D4\u05E8\u05D4\u05D5\u05E8\u05D9\u05DD \u05D0\u05D9\u05E9\u05D9\u05D9\u05DD, \u05D6\u05D5 \u05D4\u05E9\u05D9\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD \u05DB\u05D6\u05D5\u05D2. \u05D4\u05D4\u05E8\u05D4\u05D5\u05E8\u05D9\u05DD \u05D4\u05D0\u05D9\u05E9\u05D9\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05E0\u05E9\u05D0\u05E8\u05D9\u05DD \u05D0\u05E6\u05DC\u05DB\u05DD \u05D1\u05DC\u05D1\u05D3.","{partnerLabel} \u05E2\u05D5\u05D3 \u05DC\u05D0 \u05D4\u05E1\u05E4\u05D9\u05E7/\u05D4 \u05DC\u05E1\u05D2\u05D5\u05E8 \u05E4\u05E2\u05E8\u05D9\u05DD. \u05D0\u05DD \u05D1\u05D0 \u05DC\u05DB\u05DD \u2014 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05D6\u05DB\u05D9\u05E8 \u05E2\u05D3\u05D9\u05E0\u05D5\u05EA, \u05DC\u05D0 \u05DC\u05D7\u05E5.","{partnerLabel} \u05E7\u05E6\u05EA \u05E7\u05D3\u05D9\u05DE\u05D4 \u05D0\u05EA\u05DB\u05DD. \u05DC\u05D0 \u05EA\u05D7\u05E8\u05D5\u05EA \u2014 \u05E8\u05E7 \u05DB\u05D3\u05D0\u05D9 \u05DC\u05D3\u05E2\u05EA.","{coachName} \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA \u05D4\u05E9\u05D9\u05D7\u05D4 \u05D4\u05D6\u05D5 \u05D5\u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D2\u05D9\u05D1.","\u05D4\u05DE\u05E9\u05D8\u05D7 \u05D4\u05D6\u05D4 \u05DE\u05E9\u05D5\u05EA\u05E3. \u05D4\u05D4\u05E8\u05D4\u05D5\u05E8\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05E2\u05DC \u05E4\u05E8\u05D9\u05D8\u05D9\u05DD \u05D1\u05D5\u05D3\u05D3\u05D9\u05DD \u05E0\u05E9\u05D0\u05E8\u05D9\u05DD \u05E4\u05E8\u05D8\u05D9\u05D9\u05DD.","\u05E2\u05D5\u05D3 \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05DC\u05D1\u05D7\u05D9\u05E8\u05EA \u05DE\u05E9\u05D7\u05E7","\u05E2\u05D5\u05D3 \u05DC\u05D0 \u05E8\u05DB\u05E9\u05EA\u05DD \u05DE\u05E9\u05D7\u05E7\u05D9\u05DD","\u05D2\u05DC\u05D5 \u05EA\u05DB\u05E0\u05D9\u05DD","\u05E9\u05DC\u05DB\u05DD","\u05E4\u05EA\u05D9\u05D7\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7","\u05E4\u05EA\u05D7\u05D5","\u05E4\u05E8\u05D8\u05D9\u05DD \u05D5\u05E8\u05DB\u05D9\u05E9\u05D4","\u05DC\u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD \u05D1\u05DC\u05D1\u05D3 \u00B7 \u05D4\u05D2\u05DC\u05E8\u05D9\u05D4","\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05E4\u05EA\u05D7\u05EA\u05DD, \u05D1\u05DE\u05E7\u05D5\u05DD \u05D0\u05D7\u05D3.","\u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05E8\u05DB\u05E9\u05EA\u05DD, \u05D1\u05DE\u05E7\u05D5\u05DD \u05D0\u05D7\u05D3. \u05DC\u05D7\u05D9\u05E6\u05D4 \u05E4\u05D5\u05EA\u05D7\u05EA \u05D0\u05EA \u05D4\u05EA\u05D5\u05DB\u05DF \u05D4\u05DE\u05DC\u05D0 - \u05D2\u05DD \u05DC\u05DB\u05DD \u05D5\u05D2\u05DD \u05DC\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2.","\u05DB\u05DC \u05DE\u05E9\u05D7\u05E7\u05D9 '\u05D4\u05E1\u05E7\u05E1 \u05E9\u05DC \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9' \u05DB\u05DC\u05D5\u05DC\u05D9\u05DD \u05D1\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05DE\u05E0\u05D5\u05D9 '\u05DC\u05D9\u05D5\u05D5\u05D9 \u05E2\u05DD \u05DE\u05D9\u05D0\u05D5\u05E9\u05D9' \u05E4\u05D5\u05EA\u05D7 \u05DC\u05DB\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7\u05D9\u05DD \u05E9\u05D1\u05E7\u05D8\u05DC\u05D5\u05D2. \u05D1\u05DC\u05D9 \u05D4\u05D2\u05D1\u05DC\u05EA \u05D7\u05D5\u05D3\u05E9, \u05D1\u05DC\u05D9 \u05DC\u05D1\u05D7\u05D5\u05E8 \u2014 \u05DB\u05D5\u05DC\u05DD \u05E4\u05EA\u05D5\u05D7\u05D9\u05DD.","\u05DB\u05E8\u05D8\u05D9\u05E1\u05D9\u05DD \u05DC\u05D4\u05E8\u05D7\u05D1\u05EA \u05D4\u05D2\u05DC\u05E8\u05D9\u05D4 \u05E9\u05DC\u05DB\u05DD. \u05DC\u05D7\u05D9\u05E6\u05D4 \u05E4\u05D5\u05EA\u05D7\u05EA \u05D0\u05EA \u05E2\u05DE\u05D5\u05D3 \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DC\u05E8\u05DB\u05D9\u05E9\u05D4.","\u05D1\u05D7\u05E8\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05E8\u05D0\u05E9\u05D5\u05DF \u05D5\u05D2\u05DC\u05D5 \u05E2\u05D5\u05DC\u05DD \u05E9\u05DC\u05DD \u05E9\u05DE\u05EA\u05D0\u05D9\u05DD \u05E8\u05E7 \u05DC\u05DB\u05DD. \u05DB\u05DC \u05DE\u05D4 \u05E9\u05EA\u05E7\u05E0\u05D5 \u05D9\u05D5\u05E4\u05D9\u05E2 \u05DB\u05D0\u05DF - \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05D2\u05DD \u05DC\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2.","\u05D4\u05E7\u05DC\u05D9\u05E0\u05D9\u05E7\u05D4 \u05D4\u05DE\u05DB\u05D5\u05D5\u05E0\u05E0\u05EA \u05E9\u05DC\u05DB\u05DD","\u05D4\u05E9\u05DC\u05DE\u05EA\u05DD \u05D0\u05EA \u05D4\u05D0\u05D1\u05D7\u05D5\u05DF \u05D4\u05D0\u05D9\u05E9\u05D9","\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD: {title}","\u05E0\u05E4\u05EA\u05D7 \u05E2\u05D1\u05D5\u05E8\u05DB\u05DD: {title}","\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA \u05D6\u05D5\u05D2\u05D9\u05EA","\u05DE\u05D9\u05E0\u05D9\u05D5\u05EA \u05D5\u05D0\u05D9\u05E0\u05D8\u05D9\u05DE\u05D9\u05D5\u05EA","\u05D0\u05D4\u05D1\u05D4 \u05D5\u05D7\u05D9\u05D1\u05D5\u05E8 \u05E8\u05D2\u05E9\u05D9","\u05D7\u05D1\u05E8\u05D5\u05EA \u05D5\u05E9\u05D5\u05EA\u05E4\u05D5\u05EA \u05D9\u05D5\u05DE\u05D9\u05D5\u05DE\u05D9\u05EA","\u05DE\u05E9\u05E4\u05D7\u05D4 \u05D5\u05DC\u05D7\u05E6\u05D9\u05DD \u05E4\u05E0\u05D9\u05DE\u05D9\u05D9\u05DD","\u05EA\u05D5\u05DB\u05DF \u05D0\u05D9\u05E9\u05D9 \u05E9\u05DE\u05D5\u05EA\u05D0\u05DD \u05DC\u05D4\u05E2\u05D3\u05E4\u05D5\u05EA \u05E9\u05DC\u05DB\u05DD, \u05DE\u05E1\u05D5\u05E0\u05DF \u05D5\u05DE\u05D3\u05D5\u05E8\u05D2 \u05DC\u05E4\u05D9 \u05DE\u05D4 \u05E9\u05D7\u05E9\u05D5\u05D1 \u05DC\u05DB\u05DD.","\u05D7\u05D9\u05D1\u05D5\u05E8 \u05DB\u05DC\u05DC\u05D9","\u05D4\u05DE\u05D5\u05E7\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF: {focusLabel}","\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05E9\u05DC\u05DB\u05DD \u05D4\u05E9\u05D9\u05D1 \u05E2\u05DC \u05EA\u05D2\u05D5\u05D1\u05D4","\u05EA\u05D5\u05DB\u05DF \u05E9\u05DE\u05E1\u05D5\u05D3\u05E8 \u05DC\u05E4\u05D9 \u05DE\u05D4 \u05E9\u05D7\u05E9\u05D5\u05D1 \u05DC\u05DB\u05DD. \u05DB\u05DC \u05D0\u05D7\u05D3 \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA \u05D4\u05E9\u05DC\u05D1\u05D9\u05DD \u05D1\u05E1\u05D3\u05E8 \u05E9\u05DE\u05EA\u05D0\u05D9\u05DD \u05DC\u05DE\u05D4 \u05E9\u05D1\u05D9\u05E7\u05E9 \u05D1\u05D0\u05D1\u05D7\u05D5\u05DF.","\u05DE\u05D4 \u05E9\u05E2\u05E9\u05D9\u05EA\u05DD \u05D1\u05D9\u05D7\u05D3, \u05D4\u05E9\u05D9\u05D7\u05D4 \u05D1\u05D9\u05E0\u05D9\u05DB\u05DD, \u05D5\u05D4\u05D4\u05D5\u05D3\u05E2\u05D5\u05EA \u05DE\u05D4\u05DE\u05D5\u05DE\u05D7\u05D4 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD.","\u05DE\u05E1\u05D5\u05D3\u05E8 \u05DC\u05E4\u05D9 \u05D4\u05D3\u05D9\u05E8\u05D5\u05D2 \u05E9\u05DC\u05DA: \u05D4\u05DE\u05D5\u05E7\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05D4\u05D5\u05D0 {focusLabel}. \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA \u05D4\u05E1\u05D3\u05E8 \u05E9\u05DC\u05D4\u05DD \u05D1\u05E0\u05E4\u05E8\u05D3.","\u05D0\u05D6\u05D5\u05E8 \u05E4\u05E8\u05D8\u05D9. \u05D4\u05DB\u05DC \u05E4\u05D4 \u05D0\u05D9\u05E9\u05D9 \u05DC\u05DB\u05DD \u05D1\u05DC\u05D1\u05D3.","\u05D2\u05DC\u05D2\u05DC \u05D4\u05DE\u05D6\u05DC","\u05E1\u05D5\u05D1\u05D1\u05D5 \u05D0\u05EA \u05D4\u05D2\u05DC\u05D2\u05DC \u05D5\u05E7\u05D1\u05DC\u05D5 \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD","\u05E7\u05D9\u05D9\u05DD","\u05E2\u05D3 8 \u05E9\u05D7\u05E7\u05E0\u05D9\u05DD \u05E2\u05DC \u05DC\u05D5\u05D7 \u05E2\u05DD \u05E9\u05D0\u05DC\u05D5\u05EA \u05D5\u05D0\u05EA\u05D2\u05E8\u05D9\u05DD \u05D6\u05D5\u05D2\u05D9\u05D9\u05DD","\u05D4\u05D0\u05D1\u05D7\u05D5\u05DF \u05E9\u05DC\u05DB\u05DD","\u05D4\u05EA\u05DE\u05D5\u05E0\u05D4 \u05E9\u05D9\u05E6\u05D0\u05D4 \u05DC\u05DB\u05DD","\u05D4\u05DE\u05D5\u05E7\u05D3 \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05DB\u05DD:","\u05D7\u05D1\u05E8\u05D5\u05EA","\u05E0\u05D9\u05D4\u05D5\u05DC \u05E7\u05D5\u05E0\u05E4\u05DC\u05D9\u05E7\u05D8\u05D9\u05DD","\u05E1\u05D9\u05DB\u05D5\u05DF \u05DC\u05D3\u05D4\u05D9\u05D9\u05EA \u05D4\u05EA\u05E9\u05D5\u05E7\u05D4","\u05D4\u05D0\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05E9\u05DC\u05DD \u05D1\u05E0\u05E4\u05E8\u05D3?","\u05DC\u05D0. \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DB\u05DD \u05E4\u05D5\u05EA\u05D7 \u05D2\u05D9\u05E9\u05D4 \u05DC\u05E9\u05E0\u05D9 \u05D1\u05E0\u05D9 \u05D4\u05D6\u05D5\u05D2 \u2014 \u05D0\u05D9\u05DF \u05DB\u05E4\u05DC \u05D7\u05D9\u05D5\u05D1, \u05D0\u05D9\u05DF \u05D3\u05DE\u05D9 \u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA, \u05D0\u05D9\u05DF \u05E9\u05D5\u05DD \u05D7\u05D9\u05D5\u05D1 \u05E0\u05D5\u05E1\u05E3 \u05E2\u05D1\u05D5\u05E8 \u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA\u05DD.","\u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4 \u05D0\u05DD \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05D9 \u05DE\u05E1\u05EA\u05D9\u05D9\u05DD?","\u05D4\u05D2\u05D9\u05E9\u05D4 \u05E9\u05DC \u05E9\u05E0\u05D9\u05DB\u05DD \u05DE\u05EA\u05E2\u05D3\u05DB\u05E0\u05EA \u05D9\u05D7\u05D3. \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DB\u05DD \u05E4\u05E2\u05D9\u05DC \u2014 \u05E9\u05E0\u05D9\u05DB\u05DD \u05E0\u05D4\u05E0\u05D9\u05DD \u05DE\u05D4\u05DB\u05DC. \u05D0\u05DD \u05D4\u05DE\u05E0\u05D5\u05D9 \u05DE\u05E1\u05EA\u05D9\u05D9\u05DD \u2014 \u05DC\u05E9\u05E0\u05D9\u05DB\u05DD \u05DE\u05D5\u05D2\u05D1\u05DC \u05D4\u05D2\u05D9\u05E9\u05D4.","\u05D4\u05D0\u05DD \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D7\u05D1\u05E8 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D0\u05D3\u05DD \u05D0\u05D7\u05D3?","\u05D4\u05DE\u05E0\u05D5\u05D9 \u05EA\u05D5\u05DE\u05DA \u05D1\u05D6\u05D5\u05D2 \u05D0\u05D7\u05D3 \u2014 \u05E9\u05E0\u05D9 \u05D0\u05E0\u05E9\u05D9\u05DD. \u05DC\u05D0\u05D7\u05E8 \u05E9\u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05DE\u05E6\u05D8\u05E8\u05E4/\u05EA, \u05D4\u05E7\u05D5\u05D3 \u05DE\u05E4\u05E1\u05D9\u05E7 \u05DC\u05E4\u05E2\u05D5\u05DC \u05E2\u05D1\u05D5\u05E8 \u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD \u05E0\u05D5\u05E1\u05E4\u05D9\u05DD.","\u05DE\u05D4 \u05D0\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2 \u05E9\u05DB\u05D7\u05D5 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3?","\u05D0\u05E4\u05E9\u05E8 \u05EA\u05DE\u05D9\u05D3 \u05DC\u05D7\u05D6\u05D5\u05E8 \u05DC'\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9 \u05E9\u05DC\u05D9' \u05D5\u05DC\u05E9\u05DC\u05D5\u05D7 \u05D0\u05EA \u05D4\u05E7\u05D5\u05D3 \u05E9\u05D5\u05D1 \u2014 \u05D1-WhatsApp, \u05D1-SMS, \u05D0\u05D5 \u05DB\u05EA\u05DE\u05D5\u05E0\u05EA QR.","\u05E9\u05EA\u05E4/\u05D9 \u05E2\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05D4\u05E7\u05D5\u05D3 \u05D4\u05D1\u05D0 \u05D9\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D1\u05DF/\u05D1\u05EA \u05D6\u05D5\u05D2\u05DA \u05DC\u05E7\u05D1\u05DC \u05D2\u05D9\u05E9\u05D4 \u05DC\u05DB\u05DC \u05D4\u05EA\u05DB\u05E0\u05D9\u05DD, \u05DC\u05DC\u05D0 \u05EA\u05E9\u05DC\u05D5\u05DD \u05E0\u05D5\u05E1\u05E3 \u2014 \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05DE\u05E0\u05D5\u05D9 \u05E9\u05DC\u05DA \u05E4\u05E2\u05D9\u05DC.","\u05D4\u05E2\u05EA\u05E7/\u05D9","\u05D4\u05D5\u05E2\u05EA\u05E7","WhatsApp","SMS","\u05D4\u05E6\u05D2/\u05D9 QR","\u05D0\u05D9\u05DA \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3?","\u05E1\u05E8\u05E7\u05D5 \u05E2\u05DD \u05D4\u05DE\u05E6\u05DC\u05DE\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05E2\u05D1\u05D5\u05E8 \u05D9\u05E9\u05D9\u05E8\u05D5\u05EA \u05DC\u05E2\u05DE\u05D5\u05D3 \u05D4\u05D4\u05E8\u05E9\u05DE\u05D4 \u2014 \u05D4\u05E7\u05D5\u05D3 \u05D9\u05D5\u05D6\u05DF \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA.","\u05D4\u05D5\u05E8\u05D3/\u05D9 \u05D0\u05EA \u05D4-QR \u05DB\u05EA\u05DE\u05D5\u05E0\u05D4","\u05E1\u05D2\u05D9\u05E8\u05D4","\u05E8\u05DB\u05D9\u05E9\u05D4 \u05D7\u05D3-\u05E4\u05E2\u05DE\u05D9\u05EA","\u05DE\u05D9\u05E0\u05D5\u05D9 \u05D7\u05D5\u05D3\u05E9\u05D9 \u05D6\u05D5\u05D2\u05D9","\u05DE\u05D9\u05E0\u05D5\u05D9 \u05E9\u05E0\u05EA\u05D9 \u05D6\u05D5\u05D2\u05D9","\u05D1\u05E8\u05D5\u05DB\u05D9\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD","\u05DB\u05DB\u05D4 \u05D6\u05D4 \u05E2\u05D5\u05D1\u05D3","\u05E7\u05D1\u05DC\u05D5 \u05E9\u05D0\u05DC\u05D4 - \u05D0\u05DE\u05EA \u05D0\u05D5 \u05D7\u05D5\u05D1\u05D4","\u05E2\u05E0\u05D5 \u05D0\u05D5 \u05D1\u05E6\u05E2\u05D5, \u05D5\u05E2\u05D1\u05E8\u05D5 \u05DC\u05E1\u05D9\u05D1\u05D5\u05D1 \u05D4\u05D1\u05D0","\u05DE\u05E2\u05D5\u05DC\u05D4, \u05D9\u05D5\u05E6\u05D0\u05D9\u05DD \u05DC\u05D3\u05E8\u05DA","{completed} / {total} \u05D4\u05D5\u05E9\u05DC\u05DE\u05D5","\u05DE\u05E9\u05D5\u05EA\u05E3 \u05E2\u05DD \u05D1\u05DF/\u05D1\u05EA \u05D4\u05D6\u05D5\u05D2","\u05E0\u05E2\u05D5\u05DC","\u05E0\u05E2\u05E9\u05D4 \u05D1\u05D9\u05D7\u05D3","\u05E4\u05EA\u05D5\u05D7 \u05E2\u05DB\u05E9\u05D9\u05D5","\u05D1\u05E2\u05D5\u05D3 \u05D9\u05D5\u05DD","\u05D1\u05E2\u05D5\u05D3 {n} \u05D9\u05DE\u05D9\u05DD","\u05D1\u05E2\u05D5\u05D3 {n} \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA","\u05EA\u05D2\u05D5\u05D1\u05D4 \u05D0\u05D7\u05EA","{n} \u05EA\u05D2\u05D5\u05D1\u05D5\u05EA","\u05D4\u05E4\u05E2\u05D5\u05DC\u05D4 \u05D4\u05D1\u05D0\u05D4","\u05D4\u05DE\u05E1\u05E2 \u05D4\u05D5\u05E9\u05DC\u05DD","\u05D7\u05DC\u05E7 \u05DE\u05E9\u05D9\u05D8\u05D4 \u05DE\u05D5\u05DB\u05D7\u05EA \u05E9\u05E0\u05D1\u05E0\u05EA\u05D4 \u05E2\u05DD \u05D6\u05D5\u05D2\u05D5\u05EA \u05D0\u05DE\u05D9\u05EA\u05D9\u05D9\u05DD","\u05D4\u05E6\u05E2\u05D3 \u05D4\u05D1\u05D0 \u05E9\u05DC\u05DB\u05DD","\u05D4\u05D2\u05D9\u05E2 \u05D4\u05D6\u05DE\u05DF","\u05E8\u05D2\u05E2 \u05E7\u05D8\u05DF \u05D1\u05D9\u05D7\u05D3 \u05E9\u05D1\u05D5\u05E0\u05D4 \u05D0\u05EA \u05D4\u05E7\u05E8\u05D1\u05D4 \u05E9\u05DE\u05D7\u05D6\u05D9\u05E7\u05D4 \u05D0\u05EA \u05DB\u05DC \u05D4\u05E9\u05D0\u05E8.","\u05D1\u05D5\u05D0\u05D5 \u05E0\u05EA\u05D7\u05D9\u05DC","\u05D4\u05E4\u05E8\u05E7 \u05D4\u05D1\u05D0","\u05D4\u05DE\u05E1\u05E2 \u05E0\u05D1\u05E0\u05D4 \u05D1\u05E7\u05E6\u05D1 \u05D4\u05E0\u05DB\u05D5\u05DF - \u05D4\u05E4\u05E8\u05E7 \u05D4\u05D6\u05D4 \u05DE\u05D7\u05DB\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DC\u05E8\u05D2\u05E2 \u05E9\u05D1\u05D5 \u05EA\u05D4\u05D9\u05D5 \u05DE\u05D5\u05DB\u05E0\u05D9\u05DD \u05D0\u05DC\u05D9\u05D5.","\u05D4\u05E6\u05E6\u05D4 \u05DE\u05D4\u05E4\u05E8\u05E7","\u05E0\u05E4\u05EA\u05D7 \u05D0\u05D5\u05D8\u05D5\u05DE\u05D8\u05D9\u05EA \u05D1\u05D6\u05DE\u05DF \u05E9\u05E0\u05E7\u05D1\u05E2","\u05E0\u05E4\u05EA\u05D7 \u05DB\u05E2\u05EA","\u05D4\u05D9\u05D5\u05DD","\u05E0\u05E4\u05EA\u05D7 \u05DE\u05D7\u05E8","\u05E0\u05E4\u05EA\u05D7 \u05D1\u05E2\u05D5\u05D3 {n} \u05D9\u05DE\u05D9\u05DD","\u05E0\u05E4\u05EA\u05D7 \u05D1\u05E2\u05D5\u05D3 {n} \u05E9\u05D1\u05D5\u05E2\u05D5\u05EA","\u05E0\u05E4\u05EA\u05D7 \u05D1-{date}","\u05D4\u05D5\u05E9\u05DC\u05DD","\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD \u05D0\u05EA \u05DB\u05DC \u05D4\u05E4\u05E8\u05E7\u05D9\u05DD \u05E9\u05DC \u05D4\u05DE\u05E1\u05DC\u05D5\u05DC \u05D4\u05D6\u05D4","{total} \u05E4\u05E8\u05E7\u05D9\u05DD \u05D4\u05D5\u05E9\u05DC\u05DE\u05D5. \u05D6\u05D4 \u05D4\u05D4\u05D6\u05D3\u05DE\u05E0\u05D5\u05EA \u05DC\u05D3\u05D1\u05E8 - \u05DE\u05D4 \u05D7\u05E9\u05D5\u05D1 \u05DC\u05DB\u05DD \u05DC\u05E9\u05DE\u05E8?","\u05E9\u05DE\u05D9\u05E8\u05D4 \u05E0\u05DB\u05E9\u05DC\u05D4: {error}","\u05D4\u05EA\u05D2\u05D5\u05D1\u05D4 \u05E0\u05E9\u05DE\u05E8\u05D4","\u05DE\u05D4 \u05E2\u05D5\u05DC\u05D4 \u05DC\u05DB\u05DD \u05DE\u05D4\u05E4\u05E8\u05D9\u05D8 \u05D4\u05D6\u05D4? \u05EA\u05D2\u05D5\u05D1\u05D4 \u05DC\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD \u05E9\u05DC\u05E0\u05D5\u2026","\u05E4\u05E8\u05D8\u05D9 - \u05E8\u05E7 \u05D0\u05EA\u05DD \u05D5\u05D4\u05DE\u05D5\u05DE\u05D7\u05D9\u05DD","\u05E9\u05DC\u05D7\u05D5","\u05D4\u05D9\u05E1\u05D8\u05D5\u05E8\u05D9\u05D9\u05EA \u05E9\u05D9\u05D7\u05D4","\u05E2\u05D3\u05D9\u05D9\u05DF \u05D0\u05D9\u05DF \u05D4\u05D5\u05D3\u05E2\u05D5\u05EA \u05D1\u05E9\u05D9\u05D7\u05D4 \u05D4\u05D6\u05D5. \u05D4\u05EA\u05D2\u05D5\u05D1\u05D4 \u05E9\u05DC\u05DB\u05DD \u05EA\u05E4\u05EA\u05D7 \u05D0\u05D5\u05EA\u05D4.","\u05DE\u05D9\u05D0\u05D5\u05E9\u05D9","\u05E4\u05E8\u05D8\u05D9","\u05D4\u05D5\u05E1\u05D9\u05E4\u05D5 \u05EA\u05D2\u05D5\u05D1\u05D4 \u05E8\u05D2\u05E9\u05D9\u05EA","\u05E1\u05D5\u05DE\u05DF \u05DB\u05DC\u05D0 \u05D4\u05D5\u05E9\u05DC\u05DD","\u05D4\u05EA\u05D2\u05D5\u05D1\u05D4 \u05E0\u05DE\u05D7\u05E7\u05D4","\u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8 \u05E7\u05D5\u05D3\u05DD.","\u05D4\u05E9\u05DC\u05D9\u05DE\u05D5 \u05D0\u05EA \u05D4\u05E4\u05E8\u05D5\u05E4\u05D9\u05DC \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E9\u05EA\u05EA\u05E3.","\u05D0\u05D9\u05DF \u05DC\u05DB\u05DD \u05D2\u05D9\u05E9\u05D4 \u05DC\u05E4\u05E8\u05D9\u05D8 \u05D4\u05D6\u05D4.","\u05D4\u05E4\u05E8\u05D9\u05D8 \u05E2\u05D3\u05D9\u05D9\u05DF \u05E0\u05E2\u05D5\u05DC